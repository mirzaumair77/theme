                "custom_liquid_aJwz3N": {
                  "type": "custom-liquid",
                  "name": "Swatches- WZ Primary",
                  "settings": {
                    "custom_liquid": "{% render 'swatch-styles' %}\n{%- assign second_media_id = closest.product.media[1].id -%}\n{%- assign preferred_order = 'White Bronze,Gilded Bronze,Sterling Silver' | split: ',' -%}\n{%- for option in closest.product.options_with_values -%}\n  {%- assign swatch_values = option.values | map: 'swatch' | compact -%}\n  {%- if swatch_values.size > 0 -%}\n    {%- liquid\n      assign ordered_index = ''\n      for pref in preferred_order\n        assign pref_name = pref | strip | downcase\n        for value in option.values\n          assign value_name = value.name | strip | downcase\n          if value_name == pref_name\n            assign ordered_index = ordered_index | append: forloop.index0 | append: ','\n          endif\n        endfor\n      endfor\n      for value in option.values\n        assign value_name = value.name | strip | downcase\n        assign is_preferred = false\n        for pref in preferred_order\n          assign pref_name = pref | strip | downcase\n          if value_name == pref_name\n            assign is_preferred = true\n            break\n          endif\n        endfor\n        unless is_preferred\n          assign ordered_index = ordered_index | append: forloop.index0 | append: ','\n        endunless\n      endfor\n      assign ordered_index = ordered_index | split: ','\n      assign first_index = ordered_index.first | plus: 0\n      assign first_value = option.values[first_index]\n    -%}\n    <div class=\"ccs-option\" data-second-media-id=\"{{ second_media_id }}\" style=\"display:flex; align-items:center; gap:10px; margin-bottom:4px; padding: 4px 6px;\">\n      <div class=\"ccs-swatches\" style=\"display:flex; gap:8px; align-items:center;\">\n        {%- for index in ordered_index -%}\n          {%- liquid\n            assign value_index = index | plus: 0\n            assign value = option.values[value_index]\n            assign featured_media_id = value.variant.featured_media.id\n            if featured_media_id == blank\n              assign option_key = 'option' | append: option.position\n              for v in closest.product.variants\n                if v[option_key] == value.name and v.featured_media\n                  assign featured_media_id = v.featured_media.id\n                  break\n                endif\n              endfor\n            endif\n          -%}\n          <button\n            type=\"button\"\n            class=\"ccs-swatch-btn{% if forloop.first %} is-selected{% endif %}\"\n            data-value-name=\"{{ value.name | escape }}\"\n            data-media-id=\"{{ featured_media_id }}\"\n            aria-label=\"{{ value.name | escape }}\"\n            style=\"background:none; border:none; padding:0; cursor:pointer; line-height:0;\"\n          >\n            {% render 'swatch', swatch: value.swatch %}\n          </button>\n        {%- endfor -%}\n      </div>\n      <span class=\"ccs-selected-title\" style=\"font-size: calc(0.5em + 3pt); display:flex; align-items:center;\">{{ first_value.name }}</span>\n    </div>\n    <style>\n      .ccs-swatch-btn.is-selected .swatch {\n        outline: 2px solid rgba(0, 0, 0, 0.8);\n        outline-offset: 2px;\n      }\n    </style>\n    <script>\n      (function () {\n        var script = document.currentScript;\n        var wrapper = script.previousElementSibling.previousElementSibling;\n        if (!wrapper) return;\n        var buttons = wrapper.querySelectorAll('.ccs-swatch-btn');\n        var label = wrapper.querySelector('.ccs-selected-title');\n        var card = wrapper.closest('product-card');\n        var cardGallery = card ? card.querySelector('.card-gallery') : null;\n        var secondMediaId = wrapper.getAttribute('data-second-media-id');\n        var selectedMediaId = null; // stays null (hands-off) until the shopper actually clicks a swatch\n        function isGalleryEvent(event) {\n          return cardGallery && (event.target === cardGallery || cardGallery.contains(event.target));\n        }\n        // Capture phase runs before Horizon's own listener on card-gallery, regardless of load order,\n        // so we can take over both directions with explicit photo IDs instead of relying on\n        // Horizon's relative next()/previous() slide math, which is what caused the wrap-around bug.\n        if (card && cardGallery) {\n          card.addEventListener('pointerenter', function (event) {\n            if (selectedMediaId && secondMediaId && isGalleryEvent(event)) {\n              event.stopPropagation();\n              if (typeof card.previewVariant === 'function') {\n                card.previewVariant(secondMediaId);\n              }\n            }\n          }, true);\n          card.addEventListener('pointerleave', function (event) {\n            if (selectedMediaId && isGalleryEvent(event)) {\n              event.stopPropagation();\n              if (typeof card.previewVariant === 'function') {\n                card.previewVariant(selectedMediaId);\n              }\n            }\n          }, true);\n        }\n        // Show the first swatch's photo (White Bronze) as soon as the card is ready,\n        // instead of waiting for a click. Setting selectedMediaId here also hands the\n        // hover in/out behaviour to the explicit-ID handlers above from the start.\n        function applyInitialVariantPhoto() {\n          var firstBtn = buttons[0];\n          if (!firstBtn || !card) return;\n          var mediaId = firstBtn.getAttribute('data-media-id');\n          if (!mediaId) return;\n          selectedMediaId = mediaId;\n          if (typeof card.previewVariant === 'function') {\n            card.previewVariant(mediaId);\n          }\n        }\n        if (window.customElements && customElements.whenDefined) {\n          customElements.whenDefined('product-card').then(function () {\n            requestAnimationFrame(applyInitialVariantPhoto);\n          });\n        } else {\n          applyInitialVariantPhoto();\n        }\n\n        buttons.forEach(function (btn) {\n          btn.addEventListener('click', function (e) {\n            e.preventDefault();\n            buttons.forEach(function (b) { b.classList.remove('is-selected'); });\n            btn.classList.add('is-selected');\n            if (label) label.textContent = btn.getAttribute('data-value-name');\n            var mediaId = btn.getAttribute('data-media-id');\n            if (mediaId) selectedMediaId = mediaId;\n            if (card && mediaId && typeof card.previewVariant === 'function') {\n              card.previewVariant(mediaId);\n            }\n          });\n        });\n      })();\n    </script>\n  {%- endif -%}\n{%- endfor -%}"
