    "faq_UFDjpK": {
      "type": "faq",
      "blocks": {
        "question_ezfK6w": {
          "type": "question",
          "settings": {
            "question": "Will it fit in my suit jacket?",
            "answer": "<p>Absolutely! The Metal Pocket Square™ works with suit jackets, blazers, and tuxedos with a chest pocket at least 3.5\" wide and 4.5\" deep to fit the magnetic insert. No pins, no holes, and no damage to your jacket.</p>"
          }
        },
        "question_y6BiXR": {
          "type": "question",
          "settings": {
            "question": "Can I get it in time for my event?",
            "answer": "<p>Each Metal Pocket Square™ is made to order, with production typically taking 3–4 weeks. Have a special date in mind? Leave us a note at checkout, and we'll do our best to accommodate!</p>"
          }
        },
        "question_F9k6Rx": {
          "type": "question",
          "settings": {
            "question": "What if I change my mind?",
            "answer": "<p>We want you to love your Metal Pocket Square™! Eligible unworn pieces can be exchanged or returned within 100 days of purchase. See our <a href=\"/pages/shipping-returns\" title=\"Shipping &amp; Returns\">Shipping &amp; Returns</a> page for details.</p>"
          }
        },
        "question_6apW4M": {
          "type": "question",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes! We ship via DHL Express to select countries worldwide, including Canada, the UK, Australia, and several European countries. Shipping costs are calculated at checkout.</p>"
          }
        }
      },
