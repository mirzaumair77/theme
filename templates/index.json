            "custom_liquid_JXtzki": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{% render 'swatch-styles' %}\n{%- assign second_media_id = closest.product.media[1].id -%}\n{%- for option in closest.product.options_with_values -%}\n  {%- assign swatch_values = option.values | map: 'swatch' | compact -%}\n  {%- if swatch_values.size > 0 -%}\n    <div class=\"ccs-option\" data-second-media-id=\"{{ second_media_id }}\" style=\"display:flex; align-items:center; gap:10px; margin-bottom:4px; padding: 4px 6px;\">\n      <div class=\"ccs-swatches\" style=\"display:flex; gap:8px; align-items:center;\">\n        {%- for value in option.values -%}\n          {%- liquid\n            assign featured_media_id = value.variant.featured_media.id\n            assign ccs_variant_id = value.variant.id\n            if value.variant.available != true\n              assign ccs_option_key = 'option' | append: option.position\n              for ccs_variant in closest.product.variants\n                if ccs_variant.available and ccs_variant[ccs_option_key] == value.name\n                  assign ccs_variant_id = ccs_variant.id\n                  break\n                endif\n              endfor\n            endif\n            if featured_media_id == blank\n              assign option_key = 'option' | append: option.position\n              for v in closest.product.variants\n                if v[option_key] == value.name and v.featured_media\n                  assign featured_media_id = v.featured_media.id\n                  break\n                endif\n              endfor\n            endif\n          -%}\n          <button\n            type=\"button\"\n            class=\"ccs-swatch-btn{% if forloop.first %} is-selected{% endif %}\"\n            data-value-name=\"{{ value.name | escape }}\"\n            data-variant-id=\"{{ ccs_variant_id }}\"\n            data-media-id=\"{{ featured_media_id }}\"\n            aria-label=\"{{ value.name | escape }}\"\n            style=\"background:none; border:none; padding:0; cursor:pointer; line-height:0;\"\n          >\n            {% render 'swatch', swatch: value.swatch %}\n          </button>\n        {%- endfor -%}\n      </div>\n      <span class=\"ccs-selected-title\" style=\"font-size: calc(0.5em + 3pt); display:flex; align-items:center;\">{{ option.values.first.name }}</span>\n    </div>\n    <style>\n      .ccs-swatch-btn.is-selected .swatch {\n        outline: 2px solid rgba(0, 0, 0, 0.8);\n        outline-offset: 2px;\n      }\n    </style>\n    <script>\n      (function () {\n        var script = document.currentScript;\n        var wrapper = script.previousElementSibling.previousElementSibling;\n        if (!wrapper) return;\n        var buttons = wrapper.querySelectorAll('.ccs-swatch-btn');\n        var label = wrapper.querySelector('.ccs-selected-title');\n        var card = wrapper.closest('product-card');\n        var cardGallery = card ? card.querySelector('.card-gallery') : null;\n        var secondMediaId = wrapper.getAttribute('data-second-media-id');\n        var selectedMediaId = null; // stays null (hands-off) until the shopper actually clicks a swatch\n\n        function isGalleryEvent(event) {\n          return cardGallery && (event.target === cardGallery || cardGallery.contains(event.target));\n        }\n\n        // Capture phase runs before Horizon's own listener on card-gallery, regardless of load order,\n        // so we can take over both directions with explicit photo IDs instead of relying on\n        // Horizon's relative next()/previous() slide math, which is what caused the wrap-around bug.\n        if (card && cardGallery) {\n          card.addEventListener('pointerenter', function (event) {\n            if (selectedMediaId && secondMediaId && isGalleryEvent(event)) {\n              event.stopPropagation();\n              if (typeof card.previewVariant === 'function') {\n                card.previewVariant(secondMediaId);\n              }\n            }\n          }, true);\n\n          card.addEventListener('pointerleave', function (event) {\n            if (selectedMediaId && isGalleryEvent(event)) {\n              event.stopPropagation();\n              if (typeof card.previewVariant === 'function') {\n                card.previewVariant(selectedMediaId);\n              }\n            }\n          }, true);\n        }\n\n        // Keeps the card's product links on the chosen swatch's variant so the PDP opens on it.\n        function applySwatchVariant(btn) {\n          var variantId = btn && btn.getAttribute('data-variant-id');\n          if (!card || !variantId) return;\n          var links = card.querySelectorAll('a[ref=\"productCardLink\"], a[ref=\"cardGalleryLink\"], a[ref=\"productTitleLink\"]');\n          links.forEach(function (link) {\n            if (link.closest('product-card') !== card || !link.getAttribute('href')) return;\n            var url = new URL(link.href);\n            url.searchParams.set('variant', variantId);\n            link.href = url.toString();\n          });\n        }\n\n        buttons.forEach(function (btn) {\n          btn.addEventListener('click', function (e) {\n            e.preventDefault();\n            buttons.forEach(function (b) { b.classList.remove('is-selected'); });\n            btn.classList.add('is-selected');\n            if (label) label.textContent = btn.getAttribute('data-value-name');\n            applySwatchVariant(btn);\n\n            var mediaId = btn.getAttribute('data-media-id');\n            if (mediaId) selectedMediaId = mediaId;\n\n            if (card && mediaId && typeof card.previewVariant === 'function') {\n              card.previewVariant(mediaId);\n            }\n          });\n        });\n      })();\n    </script>\n  {%- endif -%}\n{%- endfor -%}\n\n{%- if closest.product.tags contains 'bestseller' -%}\n  <div class=\"jb-bestseller-badge\">Best Seller</div>\n  <style>\n    .jb-bestseller-badge {\n      position: absolute;\n      left: -9999px;\n      top: -9999px;\n    }\n    .jb-bestseller-badge--placed {\n      position: absolute;\n      top: 15px;\n      left: 8px;\n      z-index: 2;\n      background: #ffffff;\n      color: #000000;\n      font-size: 14px;\n      letter-spacing: 0.35px;\n      text-transform: uppercase;\n      font-weight: 600;\n      padding: 5px 12px;\n      border-radius: 4px;\n      pointer-events: none;\n    }\n  </style>\n  <script>\n    (function () {\n      var script = document.currentScript;\n      var badge = script.previousElementSibling.previousElementSibling;\n      if (!badge) return;\n      var card = badge.closest('product-card');\n      var gallery = card ? card.querySelector('.card-gallery') : null;\n      if (gallery) {\n        gallery.appendChild(badge);\n        badge.classList.remove('jb-bestseller-badge');\n        badge.classList.add('jb-bestseller-badge--placed');\n      }\n    })();\n  </script>\n{%- endif -%}"
