    "occasions_pocket_square": {
      "type": "custom-liquid",
      "disabled": true,
      "settings": {
        "custom_liquid": "{%- liquid\n  assign clean_title = product.title | remove: '™' | strip\n  assign wedding_image = nil\n  for img in product.images\n    if img.alt contains 'wedding' or img.src contains 'wedding'\n      assign wedding_image = img\n      break\n    endif\n  endfor\n  assign wedding_alt = wedding_image.alt | default: clean_title\n-%}\n<div class=\"jbps-occasions\">\n  <div class=\"jbps-occasions__head\">\n    <h2 class=\"jbps-occasions__title\">One Piece. Every Occasion It Matters.</h2>\n    <p class=\"jbps-occasions__lede\">You don't own three outfits' worth of accessories. You own one that belongs everywhere.</p>\n  </div>\n\n  <div class=\"jbps-occasions__grid\">\n    <div class=\"jbps-occasions__card{% if wedding_image %} jbps-occasions__card--photo{% endif %}\">\n      {%- if wedding_image -%}\n        <div class=\"jbps-occasions__photo\">\n          {{ wedding_image | image_url: width: 600 | image_tag:\n            loading: 'lazy',\n            sizes: '(min-width: 750px) 33vw, 100vw',\n            widths: '300,450,600',\n            alt: wedding_alt\n          -}}\n        </div>\n      {%- else -%}\n        <span class=\"jbps-occasions__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 48 48\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <circle cx=\"18\" cy=\"27\" r=\"10\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n            <circle cx=\"30\" cy=\"27\" r=\"10\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n          </svg>\n        </span>\n      {%- endif -%}\n      <div class=\"jbps-occasions__card-content\">\n        <h3 class=\"jbps-occasions__card-title\">The Wedding</h3>\n        <p class=\"jbps-occasions__card-body\">Groomsman, best man, or the guy who cleaned up better than expected. It holds through the toasts, the dancing, and the photos that end up framed.</p>\n      </div>\n    </div>\n\n    <div class=\"jbps-occasions__card\">\n      <span class=\"jbps-occasions__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 48 48\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M15 8c0 6 4 8 4 13a5 5 0 01-10 0c0-5 4-7 4-13\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          <path d=\"M19 21v14M14 40h10\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n          <path d=\"M32 12v22M26 40h12M27 12h10l-5 9-5-9z\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </span>\n      <h3 class=\"jbps-occasions__card-title\">The Date</h3>\n      <p class=\"jbps-occasions__card-body\">The dinner reservation you actually got dressed for. One less thing to think about while you're trying not to think about anything.</p>\n    </div>\n\n    <div class=\"jbps-occasions__card\">\n      <span class=\"jbps-occasions__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 48 48\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <rect x=\"8\" y=\"18\" width=\"32\" height=\"20\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n          <path d=\"M18 18v-4a4 4 0 014-4h4a4 4 0 014 4v4\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n          <path d=\"M8 27h32\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n          <path d=\"M22 27h4v4h-4z\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n        </svg>\n      </span>\n      <h3 class=\"jbps-occasions__card-title\">The Work Event</h3>\n      <p class=\"jbps-occasions__card-body\">The client dinner. The award you have to walk up for. The photo on LinkedIn you didn't know was being taken.</p>\n    </div>\n  </div>\n\n \n</div>\n\n<style>\n  .jbps-occasions {\n    max-width: 1100px;\n    margin-inline: auto;\n    font-family: var(--font-body--family);\n    color: #000;\n  }\n  .jbps-occasions__head { text-align: center; margin-bottom: 2.5rem; }\n  .jbps-occasions__title {\n    font-family: var(--font-primary--family);\n    font-size: clamp(1.5rem, 2.5vw, 2.25rem);\n    font-weight: 600;\n    margin: 0 0 0.75rem;\n    line-height: 1.15;\n  }\n  .jbps-occasions__lede {\n    font-size: 1rem;\n    color: #555555;\n    max-width: 46ch;\n    margin: 0 auto;\n    line-height: 1.5;\n  }\n  .jbps-occasions__grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 2.5rem;\n  }\n  @media screen and (min-width: 750px) {\n    .jbps-occasions__grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }\n  }\n  .jbps-occasions__card {\n    text-align: center;\n    padding: 2rem 1.25rem;\n    border: 1px solid #e7e7e7;\n    display: flex;\n    flex-direction: column;\n  }\n  .jbps-occasions__card--photo {\n    padding: 0 0 2rem;\n  }\n  .jbps-occasions__photo {\n    margin-bottom: 1.25rem;\n  }\n  .jbps-occasions__photo img {\n    display: block;\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    object-fit: cover;\n  }\n  .jbps-occasions__card--photo .jbps-occasions__card-content {\n    padding: 0 1.25rem;\n  }\n  .jbps-occasions__icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 48px;\n    height: 48px;\n    color: #000;\n    margin-bottom: 1.25rem;\n  }\n  .jbps-occasions__icon svg {\n    width: 100%;\n    height: 100%;\n  }\n  .jbps-occasions__card-title {\n    font-family: var(--font-primary--family);\n    font-size: 1.1rem;\n    font-weight: 600;\n    margin: 0 0 0.75rem;\n  }\n  .jbps-occasions__card-body {\n    font-size: 0.9rem;\n    line-height: 1.55;\n    color: #444444;\n    margin: 0;\n  }\n  .jbps-occasions__foot {\n    text-align: center;\n    margin: 2.5rem 0 0;\n    font-size: 0.95rem;\n    font-style: italic;\n    color: #555555;\n  }\n</style>",
