                  "blocks": {
                    "accordion_row_materials_text": {
                      "type": "text",
                      "settings": {
                        "text": "<p><strong>SOLID PRECIOUS METALS</strong><br/>Crafted from solid sterling silver, bronze, and other precious metals. Never plated.<br/><br/><strong>HANDCRAFTED IN NEW ORLEANS</strong><br/>Original designs, cast using the lost-wax process and finished by hand in our New Orleans studio.<br/><br/><strong>JEWELRY CARE</strong><br/>Gently clean with a jewelry polishing cloth. Sterling silver and bronze naturally develop a patina over time.</p>",
                        "width": "100%",
                        "max_width": "normal",
