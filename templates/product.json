    "faq_FPppML": {
      "type": "faq",
      "blocks": {
        "question_aD73a7": {
          "type": "question",
          "settings": {
            "question": "How long will my order take?",
            "answer": "<p>Our jewelry typically takes 3–4 weeks before shipping. Have a special date in mind? Leave us a note at checkout, and we'll do our best to accommodate!</p>"
          }
        },
        "question_KXAxbQ": {
          "type": "question",
          "settings": {
            "question": "How will my jewelry arrive?",
            "answer": "<p>Beautifully packaged and ready to gift! Each piece arrives in a signature Jose Balli Jewelry gift box and pouch, with no prices or receipts included in the package.</p>"
          }
        },
        "question_AP6DNC": {
          "type": "question",
          "settings": {
            "question": "What if it's not the right size?",
            "answer": "<p>Custom sizing is available upon request for select designs. Just leave us a note at checkout, and we'll be happy to help!</p>"
          }
        },
        "question_zm3Pwr": {
          "type": "question",
          "settings": {
            "question": "What if I change my mind?",
            "answer": "<p>Eligible unworn pieces may be returned or exchanged within 100 days of purchase. Some exclusions apply. See our <a href=\"/pages/shipping-returns\" title=\"Shipping & Returns\">Shipping + Returns</a> policy for details.</p>"
          }
        },
        "question_gyYbX3": {
          "type": "question",
          "disabled": true,
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes! We offer DHL Express delivery to [select international countries]. Shipping rates are calculated at checkout.</p>"
          }
        }
