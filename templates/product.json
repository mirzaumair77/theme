                  "blocks": {
                    "accordion_row_shipping_text": {
                      "type": "text",
                      "settings": {
                        "text": "<p><strong>COMPLIMENTARY U.S. SHIPPING</strong><br/>Free shipping on all U.S. orders.<br/><br/><strong>PRODUCTION TIME</strong><br/>Handcrafted in New Orleans. Please allow approximately 3-4 weeks before shipping.<br/><br/><strong>NEED IT BY A CERTAIN DATE?</strong><br/>Let us know your event date in the note section at checkout, and we’ll do our best to accommodate.<br/><br/><strong>INTERNATIONAL SHIPPING</strong><br/>DHL Express to select countries. Rates calculated at checkout.<br/><br/><strong>1-YEAR WARRANTY</strong><br/>Every Jose Balli Jewelry piece includes a one-year warranty.<br/><br/><strong>100-DAY RETURNS + EXCHANGES</strong><br/>Unworn items may be returned or exchanged within 100 days. Some exclusions apply.<br/><br/><a href=\"https://joseballi.com/pages/shipping-returns\" target=\"_blank\">VIEW FULL POLICY →</a></p>",
                        "width": "100%",
