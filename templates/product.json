                  "blocks": {
                    "text_mWwiUK": {
                      "type": "text",
                      "settings": {
                        "text": "<ul><li>Insert: 4.5\" L × 3.5\" W</li><li>Horse: 1.5\" L × 3\" W</li></ul><p>Available in Sterling Silver, Gilded Bronze and White Bronze.</p><p>Designed and handcrafted in New Orleans.</p>",
                        "width": "100%",
                        "max_width": "normal",
