          "collection_load_all_products": false,
          "custom_page_products": "",
          "custom_code": "<script>\n  document.addEventListener('click', function (e) {\n    var trigger = e.target.closest('[data-testid=\"cart-drawer-trigger\"]');\n    if (!trigger) return;\n    e.preventDefault();\n    e.stopImmediatePropagation();\n    if (typeof window.openCart === 'function') {\n      window.openCart();\n    }\n  }, true);\n</script>\n<script>\n  document.addEventListener('click', function (e) {\n    var noteWrap = e.target.closest('#mu-order-note');\n    if (!noteWrap) return;\n    if (e.target.closest('textarea')) return;\n    noteWrap.classList.toggle('mu-note-open');\n  }, true);\n</script>\n<script>\n  (function () {\n    // These Monster Cart / SavedBy touch-ups share ONE MutationObserver, batched to at most one\n    // run per animation frame (still before the next paint), instead of four observers that each\n    // re-scanned the whole document synchronously on every single DOM change.\n\n    // The header cart-icon's markup (bag SVG + count badge) is rendered\n    // once by snippets/header-actions.liquid + snippets/cart-bubble.liquid.\n    // As a safety net in case any script ever overwrites cart-icon's\n    // contents with a bare count number again (this previously happened\n    // via Monster Cart's bag_selector config, now fixed at the source),\n    // capture the real pristine markup once while it's healthy and restore\n    // that exact captured HTML -- not a hand-built substitute -- so the\n    // badge keeps its correct absolute position instead of appearing to\n    // jump/shift in the header.\n    var pristineTemplate = null;\n\n    function getCartIcon() {\n      var trigger = document.querySelector('[data-testid=\"cart-drawer-trigger\"]');\n      return trigger ? trigger.querySelector('cart-icon') : null;\n    }\n\n    function restoreCartIcon() {\n      var cartIcon = getCartIcon();\n      if (!cartIcon) return;\n      if (cartIcon.querySelector('svg')) {\n        if (!pristineTemplate) pristineTemplate = cartIcon.innerHTML;\n        return;\n      }\n      if (!pristineTemplate) return;\n      var count = (cartIcon.textContent || '').replace(/\\D/g, '') || '0';\n      cartIcon.innerHTML = pristineTemplate;\n      var countEl = cartIcon.querySelector('.cart-bubble__text-count');\n      if (countEl) countEl.textContent = count;\n      cartIcon.classList.toggle('header-actions__cart-icon--has-cart', count !== '0');\n    }\n\n    // Monster Cart's native checkout button and SavedBy's own \"CHECKOUT+\"\n    // button both carry the id \"mu-checkout-button\" -- SavedBy renders its\n    // button by cloning the native one (cloneNode) into <savedby-checkout-plus>.\n    // We hide only the native (non-SavedBy) one. A plain CSS rule isn't\n    // specific enough to beat Monster Cart's own styling, so we set the\n    // inline style directly with !important, which does win -- but that\n    // same inline style then gets copied onto SavedBy's clone the next time\n    // it re-clones the button, silently hiding CHECKOUT+ too. So on every\n    // pass we also actively clear any inherited \"display:none\" from the\n    // SavedBy copy, keeping it visible.\n    function fixCheckoutButtons() {\n      var buttons = document.querySelectorAll('#mu-checkout-button');\n      buttons.forEach(function (btn) {\n        if (btn.closest('savedby-checkout-plus')) {\n          if (btn.style.display) {\n            btn.style.removeProperty('display');\n          }\n        } else {\n          btn.style.setProperty('display', 'none', 'important');\n        }\n      });\n    }\n\n    // The note field's label (\"Have a deadline or occasion?\") is set via\n    // Monster Cart's Order note rich-text editor. The textarea itself has\n    // no placeholder by default, so add an example to make it obvious what\n    // kind of info we are asking for.\n    var PLACEHOLDER_TEXT = 'e.g. Anniversary gift, needed by June 5th';\n\n    function setPlaceholder() {\n      var noteWrap = document.querySelector('#mu-order-note');\n      var textarea = noteWrap ? noteWrap.querySelector('textarea') : null;\n      if (textarea && textarea.placeholder !== PLACEHOLDER_TEXT) {\n        textarea.placeholder = PLACEHOLDER_TEXT;\n      }\n    }\n\n    // Restyle the cart quantity stepper to match Alara Jewelry's cart\n    // (alarajewelry.com): a single bordered box around the whole control\n    // (light gray border #E8E8E1, square corners, sampled directly from\n    // Alara's live site via DOM inspection) with borderless dark-gray\n    // (#444444) icon buttons and a plain black, normal-weight number in\n    // the middle -- no internal divider lines between the button areas\n    // and the number. Applied via inline styles with \"important\"\n    // priority so it reliably wins over Monster Cart's own Tailwind-style\n    // utility classes, which also carry !important and were beating a\n    // plain stylesheet override (the old Custom CSS rule for the Primo\n    // look is left in place but is now fully superseded by this).\n    function styleQuantityControls() {\n      document.querySelectorAll('.mu-item-quantity').forEach(function (wrap) {\n        wrap.style.setProperty('border', '1px solid #E8E8E1', 'important');\n        wrap.style.setProperty('border-radius', '0', 'important');\n        wrap.style.setProperty('background', '#ffffff', 'important');\n\n        var children = wrap.children;\n        for (var i = 0; i < children.length; i++) {\n          var child = children[i];\n          if (child.tagName === 'BUTTON') {\n            child.style.setProperty('border', 'none', 'important');\n            child.style.setProperty('background', 'transparent', 'important');\n            child.style.setProperty('color', '#444444', 'important');\n            child.style.setProperty('border-radius', '0', 'important');\n          } else {\n            child.style.setProperty('border', 'none', 'important');\n            child.style.setProperty('color', '#000000', 'important');\n            child.style.setProperty('font-weight', '400', 'important');\n          }\n        }\n      });\n    }\n\n    function runCartFixes() {\n      restoreCartIcon();\n      fixCheckoutButtons();\n      setPlaceholder();\n      styleQuantityControls();\n    }\n\n    var scheduled = false;\n    function scheduleCartFixes() {\n      if (scheduled) return;\n      scheduled = true;\n      requestAnimationFrame(function () {\n        scheduled = false;\n        runCartFixes();\n      });\n    }\n\n    runCartFixes();\n    document.addEventListener(\"DOMContentLoaded\", runCartFixes);\n    new MutationObserver(scheduleCartFixes).observe(document.documentElement, { childList: true, subtree: true });\n  })();\n</script>"
