{%- liquid
  assign hero_image = section.settings.hero_image
  assign use_product_image = section.settings.use_product_image
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign button_label = section.settings.button_label
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign mobile_padding_top = section.settings.mobile_padding_top
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom
  assign background = section.settings.background

  assign products = null
  assign design_heading = ''
  assign finish_heading = ''
  assign design_block = null

  for block in section.blocks
    if block.type == 'designs'
      assign design_block = block
      assign products = block.settings.products
      assign design_heading = block.settings.design_heading
      assign finish_heading = block.settings.finish_heading
      break
    endif
  endfor

  assign product_count = 0
  assign current_product = null

  for product in products
    if product_count == 0
      assign current_product = product
    endif
    assign product_count = product_count | plus: 1
  endfor

  assign current_variant = current_product.selected_or_first_available_variant
  if current_variant == blank
    assign current_variant = current_product.variants.first
  endif

  assign hero_media = current_variant.featured_media | default: current_product.featured_media
  if use_product_image == false or hero_media == blank
    assign hero_media = hero_image
  endif
  assign hero_alt = hero_media.alt | default: heading | strip_html | escape

  assign add_text = button_label
  if add_text == blank
    assign add_text = 'products.product.add_to_cart' | t
  endif
  assign sold_out_text = 'products.product.sold_out' | t
  assign unavailable_text = 'products.product.unavailable' | t

  if current_variant.available
    assign can_add_to_cart = true
    assign add_to_cart_text = add_text
  else
    assign can_add_to_cart = false
    assign add_to_cart_text = sold_out_text
  endif

  assign design_name = 'Design-' | append: section.id
  assign finish_name = 'Finish-' | append: section.id
  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign button_id = 'BuyButtons-ProductSubmitButton-' | append: section.id
  assign hero_widths = '750,1100,1500,1920' | split: ','
-%}

{% render 'add-to-cart-button-styles' %}
{% render 'fly-to-cart-styles' %}

<style>
#shopify-section-{{ section.id }} {
  padding-top: {{ mobile_padding_top }}px;
  padding-bottom: {{ mobile_padding_bottom }}px;
  {%- if background != blank %}
    background: {{ background }};
  {%- endif %}
}

@media (min-width: 769px) {
  #shopify-section-{{ section.id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
}

.product-customization {
  display: block;
  padding: 0 14px;
  color: #2a2a2a;
}

.product-customization p,
.product-customization h2,
.product-customization fieldset,
.product-customization legend {
  margin: 0;
  padding: 0;
}

.product-customization fieldset {
  min-width: 0;
  border: 0;
}

.product-customization__hero {
  position: relative;
  aspect-ratio: 283 / 248;
  overflow: hidden;
  background-color: #f4f2ee;
}

.product-customization__hero-media {
  position: absolute;
  inset: 0;
}

.product-customization__hero-media img,
.product-customization__hero-media svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.3s ease;
}

.product-customization__panel {
  min-width: 0;
  padding-block-start: 24px;
}

.product-customization__eyebrow p {
  font-family: var(--font-body--family);
  color: #2A2A2A;
  font-size: 14px;
  line-height: 16.8px;
  letter-spacing: 1.12px;
  font-weight: 400;
  text-transform: uppercase;
}

.product-customization__heading {
  padding-block-start: 8px;
}

.product-customization__heading h2 {
  font-family: var(--font-heading--family);
  color: #2a2a2a;
  font-size: 18px;
  line-height: 23.4px;
  letter-spacing: -0.36px;
  font-weight: 400;
}

.product-customization fieldset.product-customization__step {
  margin-block-start: 16px;
}

.product-customization legend.product-customization__label {
  padding-block-end: 12px;
}

.product-customization__label {
  font-family: var(--font-body--family);
  color: #2A2A2A;
  font-size: 12px;
  line-height: 14.4px;
  font-weight: 600;
}

.product-customization__selected {
  margin-inline-start: 8px;
  font-weight: 400;
}

.product-customization__designs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
}

/* Contain the visually hidden radios inside the section. Without a positioned parent they
   resolve against <body>, outside the theme's .page-wrapper scroller, so focusing one on
   click scrolls the overflow-hidden <html> and slides the whole page out of view. */
.product-customization__design,
.product-customization__finishes {
  position: relative;
}

.product-customization__design-input,
.product-customization__finish-input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.product-customization__design-label {
  display: block;
  cursor: pointer;
}

.product-customization__design-image {
  position: relative;
  display: block;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background-color: #f2f2f2;
  box-shadow: 0 0 0 1px transparent;
  transition: box-shadow 0.3s ease;
}

/* White inner frame on the selected design, inside the dark outline */
.product-customization__design-image::after {
  content: '';
  position: absolute;
  inset: 0;
  box-shadow: inset 0 0 0 3px #ffffff;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.product-customization__design-image img,
.product-customization__design-image svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-customization__design-label:hover .product-customization__design-image img {
  transform: scale(1.04);
}

.product-customization__design-input:checked + .product-customization__design-label .product-customization__design-image {
  box-shadow: 0 0 0 1px #2a2a2a;
}

.product-customization__design-input:checked + .product-customization__design-label .product-customization__design-image::after {
  opacity: 1;
}

.product-customization__design-input:focus-visible + .product-customization__design-label .product-customization__design-image {
  outline: 2px solid #2a2a2a;
  outline-offset: 2px;
}

.product-customization__finishes {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  padding: 4px;
}

.product-customization__finish-label {
  position: relative;
  display: block;
  width: 28px;
  height: 28px;
  cursor: pointer;
}

.product-customization__finish-swatch {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--finish-swatch, #d9d9d9);
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
}

.product-customization__finish-label::after {
  content: '';
  position: absolute;
  inset: -4px;
  border: 1px solid transparent;
  border-radius: 50%;
  transition: border-color 0.3s ease;
}

.product-customization__finish-label:hover::after {
  border-color: #cfc8bd;
}

.product-customization__finish-input:checked + .product-customization__finish-label::after {
  border-color: #2a2a2a;
}

.product-customization__finish-input:focus-visible + .product-customization__finish-label {
  outline: 2px solid #2a2a2a;
  outline-offset: 6px;
  border-radius: 50%;
}

/* Sold out finishes stay selectable but read as unavailable */
.product-customization__finish-label--unavailable .product-customization__finish-swatch {
  opacity: 0.4;
}

.product-customization__finish-label--unavailable::before {
  content: '';
  position: absolute;
  top: 50%;
  left: -2px;
  right: -2px;
  z-index: 1;
  height: 1px;
  background-color: #2a2a2a;
  transform: rotate(-45deg);
}

.product-customization__purchase {
  margin-block-start: 26px;
}

.product-customization__form .add-to-cart-button {
  width: 100%;
  height: auto;
  min-height: 52px;
  padding: 19px 32px;
  border-radius: 0;
  background: #2a2a2a;
  font-family: var(--font-body--family);
  color: #ffffff;
  font-size: 12px;
  line-height: 14.4px;
  letter-spacing: 1.8px;
  font-weight: 400;
  text-transform: uppercase;
}

.product-customization__form .add-to-cart-icon--arrow {
  width: 14px;
  margin-inline-start: 12px;
}

@media (min-width: 769px) {
  /* Both columns scale together in the 1440px proportions (788px image : 532px content).
     The content column keeps a 320px minimum on small desktops so its controls stay usable. */
  .product-customization {
    display: grid;
    grid-template-columns: minmax(0, 788fr) minmax(320px, 532fr);
    align-items: center;
    gap: 0px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(24px, 4.4vw, 60px);
  }

  .product-customization__hero {
    aspect-ratio: 682 / 637;
  }

  .product-customization__panel {
    padding-block-start: 0;
    padding-inline: clamp(24px, 4.4vw, 60px);
  }

  .product-customization__eyebrow p {
    font-size: 20px;
    line-height: 24px;
    letter-spacing: 1.6px;
  }

  .product-customization__heading {
    padding-block-start: 14px;
  }

  .product-customization__heading h2 {
    font-size: 34px;
    line-height: 44.2px;
    letter-spacing: -0.68px;
  }

  .product-customization fieldset.product-customization__step {
    margin-block-start: 24px;
  }

  .product-customization__label {
    font-size: 16px;
    line-height: 19.2px;
  }

  .product-customization__purchase {
    margin-block-start: 24px;
  }

  .product-customization__finish-label {
    width: 33.6px;
    height: 33.6px;
  }

  .product-customization__form .add-to-cart-button {
    width: auto;
    min-width: min(273px, 100%);
  }
}
</style>

<product-customization
  class="product-customization"
  data-design-name="{{ design_name }}"
  data-finish-name="{{ finish_name }}"
  data-add-text="{{ add_text | escape }}"
  data-sold-out-text="{{ sold_out_text | escape }}"
  data-unavailable-text="{{ unavailable_text | escape }}"
  data-use-product-image="{{ use_product_image }}"
>
  <div class="product-customization__hero">
    <div class="product-customization__hero-media">
      {%- if hero_media != blank -%}
        {{
          hero_media
          | image_url: width: 1920
          | image_tag: widths: '750, 1100, 1500, 1920', sizes: '(min-width: 769px) 60vw, 100vw', loading: 'lazy', alt: hero_alt
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>

  <div class="product-customization__panel">
    {%- if eyebrow != blank -%}
      <div class="product-customization__eyebrow">
        <p>{{ eyebrow | escape }}</p>
      </div>
    {%- endif -%}

    {%- if heading != blank -%}
      <div class="product-customization__heading">
        <h2>{{ heading }}</h2>
      </div>
    {%- endif -%}

    {%- if product_count > 0 -%}
      <fieldset class="product-customization__step" {{ design_block.shopify_attributes }}>
        <legend class="product-customization__label">
          {{- design_heading | escape }}
          <span class="product-customization__selected" data-design-value>{{ current_product.title | escape }}</span>
        </legend>
        <div class="product-customization__designs">
          {%- for product in products -%}
            {%- liquid
              assign metafield_image = product.metafields.custom.featured_image
              assign design_media = metafield_image | default: product.featured_media
              assign design_id = design_name | append: '-' | append: forloop.index0
            -%}
            <div class="product-customization__design">
              <input
                type="radio"
                class="product-customization__design-input"
                id="{{ design_id }}"
                name="{{ design_name }}"
                value="{{ forloop.index0 }}"
                {% if forloop.first %}
                  checked
                {% endif %}
              >
              <label class="product-customization__design-label" for="{{ design_id }}">
                <span class="product-customization__design-image">
                  {%- if design_media != blank -%}
                    {{
                      design_media
                      | image_url: width: 400
                      | image_tag:
                        widths: '150, 200, 300, 400',
                        sizes: '(min-width: 769px) 120px, 30vw',
                        loading: 'lazy',
                        alt: ''
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </span>
                <span class="visually-hidden">{{ product.title | escape }}</span>
              </label>
            </div>
          {%- endfor -%}
        </div>
      </fieldset>

      <fieldset
        class="product-customization__step"
        {% if current_product.has_only_default_variant %}
          hidden
        {% endif %}
      >
        <legend class="product-customization__label">
          {{- finish_heading | escape }}
          <span class="product-customization__selected" data-finish-value>{{ current_variant.title | escape }}</span>
        </legend>
        <div class="product-customization__finishes">
          {%- assign finish_option = current_product.options_with_values.first -%}
          {%- for variant in current_product.variants -%}
            {%- liquid
              assign finish_id = finish_name | append: '-' | append: variant.id
              assign finish_swatch = null
              for value in finish_option.values
                if value.name == variant.option1
                  assign finish_swatch = value.swatch
                  break
                endif
              endfor
            -%}
            <input
              type="radio"
              class="product-customization__finish-input"
              id="{{ finish_id }}"
              name="{{ finish_name }}"
              value="{{ variant.id }}"
              {% if variant.id == current_variant.id %}
                checked
              {% endif %}
            >
            <label
              class="product-customization__finish-label{% unless variant.available %} product-customization__finish-label--unavailable{% endunless %}"
              for="{{ finish_id }}"
            >
              <span
                class="product-customization__finish-swatch"
                style="--finish-swatch: {% render 'finish-swatch-background', name: variant.title, swatch: finish_swatch %};"
              ></span>
              <span class="visually-hidden">{{ variant.title | escape }}</span>
            </label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- elsif request.design_mode -%}
      <div class="product-customization__step">
        <p>
          Add a "Designs" block and select products. Only products available on the Online Store sales channel can be
          shown.
        </p>
      </div>
    {%- endif -%}

    {%- if current_product != blank -%}
      <div class="product-customization__purchase">
        <product-form-component
          class="product-customization__form"
          data-section-id="{{ section.id }}"
          data-product-id="{{ current_product.id }}"
          data-product-url="{{ current_product.url }}"
          on:submit="/handleSubmit"
          data-quantity-default="{{ current_variant.quantity_rule.min | default: 1 }}"
          data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
        >
          <div
            class="visually-hidden"
            aria-live="assertive"
            role="status"
            aria-atomic="true"
            ref="liveRegion"
          ></div>
          {%- form 'product', current_product, id: product_form_id, data-type: 'add-to-cart-form' -%}
            <input
              type="hidden"
              name="id"
              ref="variantId"
              value="{{ current_variant.id }}"
            >
            <div class="product-form-buttons" ref="productFormButtons">
              <span class="product-form-text__error hidden" ref="addToCartTextError">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
              </span>
              {% render 'add-to-cart-button',
                id: button_id,
                class: 'add-to-cart-button',
                can_add_to_cart: can_add_to_cart,
                show_icon: true,
                icon: 'arrow',
                product: current_product,
                add_to_cart_text: add_to_cart_text
              %}
            </div>
          {%- endform -%}
        </product-form-component>
      </div>

      <script type="application/json" data-product-customization-data>
        [
          {%- for product in products -%}
            {%- assign finish_option = product.options_with_values.first -%}
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "url": {{ product.url | json }},
              "single": {{ product.has_only_default_variant | json }},
              "image": {% if product.featured_media != blank %}{
                "mediaId": {{ product.featured_media.id | json }},
                "src": {{ product.featured_media | image_url: width: 1500 | json }},
                "srcset": "",
                "thumb": {{ product.featured_media | image_url: width: 100 | json }},
                "alt": {{ product.featured_media.alt | default: product.title | json }}
              }{% else %}null{% endif %},
              "variants": [
                {%- for variant in product.variants -%}
                  {%- liquid
                    assign variant_media = variant.featured_media | default: product.featured_media
                    assign variant_alt = variant_media.alt | default: product.title
                    capture variant_srcset
                      for width in hero_widths
                        echo variant_media | image_url: width: width
                        echo ' ' | append: width | append: 'w'
                        unless forloop.last
                          echo ', '
                        endunless
                      endfor
                    endcapture

                    assign finish_swatch = null
                    for value in finish_option.values
                      if value.name == variant.option1
                        assign finish_swatch = value.swatch
                        break
                      endif
                    endfor
                    capture variant_swatch
                      render 'finish-swatch-background', name: variant.title, swatch: finish_swatch
                    endcapture
                  -%}
                  {
                    "id": {{ variant.id | json }},
                    "title": {{ variant.title | json }},
                    "available": {{ variant.available | json }},
                    "swatch": {{ variant_swatch | strip | json }},
                    "quantityMin": {{ variant.quantity_rule.min | default: 1 | json }},
                    "image": {% if variant_media != blank %}{
                      "mediaId": {{ variant_media.id | json }},
                      "src": {{ variant_media | image_url: width: 1500 | json }},
                      "srcset": {{ variant_srcset | json }},
                      "thumb": {{ variant_media | image_url: width: 100 | json }},
                      "alt": {{ variant_alt | json }}
                    }{% else %}null{% endif %}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    {%- endif -%}
  </div>
</product-customization>

<script>
  (() => {
    if (customElements.get('product-customization')) return;

    class ProductCustomization extends HTMLElement {
      connectedCallback() {
        const data = this.querySelector('[data-product-customization-data]');
        if (!data) return;

        this.products = JSON.parse(data.textContent);
        this.form = this.querySelector('product-form-component');
        this.variantInput = this.querySelector('input[name="id"]');
        this.finishes = this.querySelector('.product-customization__finishes');
        this.finishStep = this.finishes.closest('fieldset');
        this.heroImage = this.querySelector('.product-customization__hero-media img');

        const checkedDesign = this.querySelector(`input[name="${this.dataset.designName}"]:checked`);
        this.product = this.products[Number(checkedDesign?.value ?? 0)];

        // Full-size hero images are fetched on intent (hover, press, focus) and cached by URL,
        // so selecting a design rarely waits on the network and never requests an image twice.
        this.imageLoaders = new Map();
        this.imageToken = 0;

        this.addEventListener('change', this.onChange);
        this.addEventListener('pointerover', this.onIntent);
        this.addEventListener('pointerdown', this.onIntent);
        this.addEventListener('focusin', this.onIntent);
      }

      disconnectedCallback() {
        this.removeEventListener('change', this.onChange);
        this.removeEventListener('pointerover', this.onIntent);
        this.removeEventListener('pointerdown', this.onIntent);
        this.removeEventListener('focusin', this.onIntent);
      }

      /** Starts loading the hero image for the design or finish the visitor is about to pick. */
      onIntent = (event) => {
        if (!(event.target instanceof Element)) return;

        const label = event.target.closest('.product-customization__design-label, .product-customization__finish-label');
        const input = label?.control;
        if (!input) return;

        if (input.name === this.dataset.designName) {
          const product = this.products[Number(input.value)];
          const variant = product && this.defaultVariant(product);
          this.preloadImage(variant ? variant.image : product?.image);
        } else if (input.name === this.dataset.finishName) {
          const variant = this.product?.variants.find((item) => item.id === Number(input.value));
          this.preloadImage(variant?.image);
        }
      };

      defaultVariant(product) {
        return product.variants.find((item) => item.available) ?? product.variants[0];
      }

      onChange = (event) => {
        const { name, value } = event.target;

        if (name === this.dataset.designName) this.selectProduct(Number(value));
        if (name === this.dataset.finishName) this.selectVariant(Number(value));
      };

      selectProduct(index) {
        this.product = this.products[index];
        if (!this.product) return;

        const variant = this.defaultVariant(this.product);
        const image = variant ? variant.image : this.product.image;

        // The design's thumbnail is already loaded; show it right away when it is the same media,
        // then swap in the full-size image once it has decoded.
        this.placeholderSrc = null;
        if (image && this.product.image && image.mediaId === this.product.image.mediaId) {
          const thumb = this.querySelectorAll('.product-customization__design-image img')[index];
          if (thumb?.complete && thumb.naturalWidth) this.placeholderSrc = thumb.currentSrc;
        }

        this.updateText('[data-design-value]', this.product.title);
        this.renderFinishes(variant?.id);

        if (variant) {
          this.selectVariant(variant.id);
        } else {
          this.showProductWithoutVariant();
        }

        this.placeholderSrc = null;
      }

      showProductWithoutVariant() {
        const { product } = this;

        this.form.dataset.productId = product.id;
        this.form.dataset.productUrl = product.url;
        this.updateText('[data-finish-value]', '');
        this.updateButton({ available: false, image: product.image });
        this.updateImage(product.image);
      }

      renderFinishes(selectedId) {
        const { finishName } = this.dataset;

        const options = this.product.variants.flatMap((variant) => {
          const input = document.createElement('input');
          input.type = 'radio';
          input.className = 'product-customization__finish-input';
          input.id = `${finishName}-${variant.id}`;
          input.name = finishName;
          input.value = variant.id;
          input.checked = variant.id === selectedId;

          const label = document.createElement('label');
          label.className = 'product-customization__finish-label';
          label.classList.toggle('product-customization__finish-label--unavailable', !variant.available);
          label.htmlFor = input.id;

          const swatch = document.createElement('span');
          swatch.className = 'product-customization__finish-swatch';
          if (variant.swatch) swatch.style.setProperty('--finish-swatch', variant.swatch);

          const name = document.createElement('span');
          name.className = 'visually-hidden';
          name.textContent = variant.title;

          label.append(swatch, name);

          return [input, label];
        });

        const hasFinishes = !this.product.single && this.product.variants.length > 0;

        this.finishes.replaceChildren(...(hasFinishes ? options : []));
        this.finishStep.hidden = !hasFinishes;
      }

      selectVariant(id) {
        const { product } = this;
        const variant = product.variants.find((item) => item.id === id);
        if (!variant) return;

        this.variantInput.value = variant.id;

        const productIdInput = this.form.querySelector('input[name="product-id"]');
        if (productIdInput) productIdInput.value = product.id;

        this.form.dataset.productId = product.id;
        this.form.dataset.productUrl = product.url;
        this.form.dataset.quantityDefault = variant.quantityMin || 1;

        this.updateText('[data-finish-value]', variant.title);
        this.updateButton(variant);
        this.updateImage(variant.image);
      }

      updateText(selector, text) {
        const element = this.querySelector(selector);
        if (element) element.textContent = text;
      }

      updateButton(variant) {
        const container = this.querySelector('add-to-cart-component');
        const button = container?.querySelector('button[name="add"]');
        if (!button) return;

        if (variant.image?.thumb) container.dataset.productVariantMedia = variant.image.thumb;

        if (typeof container.enable === 'function') {
          variant.available ? container.enable() : container.disable();
        } else {
          button.disabled = !variant.available;
        }

        const label = variant.available
          ? this.dataset.addText
          : variant.id
          ? this.dataset.soldOutText
          : this.dataset.unavailableText;
        const textNode = [...button.childNodes].find(
          (node) => node.nodeType === Node.TEXT_NODE && node.textContent.trim()
        );
        if (textNode) textNode.textContent = label;
      }

      /** Returns a cached loader that fetches the same candidate the hero image would pick. */
      preloadImage(image) {
        if (!image || !this.heroImage || this.dataset.useProductImage !== 'true') return null;

        let loader = this.imageLoaders.get(image.src);
        if (!loader) {
          loader = new Image();
          loader.decoding = 'async';
          loader.sizes = this.heroImage.sizes;
          loader.srcset = image.srcset;
          loader.src = image.src;
          this.imageLoaders.set(image.src, loader);
        }
        return loader;
      }

      updateImage(image) {
        const loader = this.preloadImage(image);
        if (!loader) return;

        const hero = this.heroImage;
        const token = ++this.imageToken;
        hero.alt = image.alt;

        if (this.placeholderSrc && !(loader.complete && loader.naturalWidth)) {
          hero.srcset = '';
          hero.src = this.placeholderSrc;
        }

        const apply = () => {
          // A newer selection wins; a slow earlier image must not replace it.
          if (token !== this.imageToken) return;
          hero.srcset = image.srcset;
          hero.src = image.src;
        };

        if (loader.complete && loader.naturalWidth) {
          apply();
        } else {
          loader.decode().then(apply, apply);
        }
      }
    }

    customElements.define('product-customization', ProductCustomization);
  })();
</script>

