{%- liquid
  assign background_color = section.settings.background_color
  assign subheading = section.settings.subheading
  assign heading = section.settings.heading
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign mobile_padding_top = section.settings.mobile_padding_top
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom
  assign image_ratio = section.settings.image_ratio | default: 'auto'
  assign section_index = section.index

  assign image_loading = 'lazy'
  if section_index <= 2 and request.page_type != 'product'
    assign image_loading = 'eager'
  endif

  assign list_label = heading | default: subheading | default: 'Steps'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-background: {{ background_color | default: 'transparent' }};
    --section-padding-top: {{ padding_top }}px;
    --section-padding-bottom: {{ padding_bottom }}px;
    --section-mobile-padding-top: {{ mobile_padding_top }}px;
    --section-mobile-padding-bottom: {{ mobile_padding_bottom }}px;
  }
{%- endstyle -%}


<div class="how-work how-work--ratio-{{ image_ratio }}">
  {%- if subheading != blank or heading != blank -%}
    <div class="how-work__header">
      {%- if subheading != blank -%}
        <div class="how-work__subheading">
          <p>{{ subheading | escape }}</p>
        </div>
      {%- endif -%}

      {%- if heading != blank -%}
        <div class="how-work__heading">
          <h2>{{ heading | escape }}</h2>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="how-work__list" role="list" tabindex="0" aria-label="{{ list_label | escape }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign image = block.settings.image
        assign title = block.settings.title
        assign description = block.settings.description

        assign step_number = forloop.index | prepend: '0' | slice: -2, 2
        assign image_alt = image.alt | default: title

        # Video: an uploaded video wins; otherwise the YouTube/Vimeo URL is used.
        assign is_video = false
        if block.settings.media_type == 'video'
          assign is_video = true
          assign video_source = block.settings.video
          assign video_from_url = false
          assign video_type = nil
          if video_source == blank
            assign video_from_url = true
            assign video_source = block.settings.video_url.id
            assign video_type = block.settings.video_url.type
          endif
          assign video_poster = block.settings.video_cover_image | default: block.settings.video.preview_image

          # Browsers block autoplay with sound, so autoplay always starts muted
          assign video_muted = block.settings.video_muted
          if block.settings.video_autoplay
            assign video_muted = true
          endif
        endif
      -%}

      <li class="how-work__item" {{ block.shopify_attributes }}>
        <div class="how-work__media{% if is_video %} how-work__media--video{% endif %}">
          {%- if is_video -%}
            {% render 'video',
              block: block,
              video: video_source,
              video_from_url: video_from_url,
              video_type: video_type,
              video_alt: title,
              video_preview_image: video_poster,
              video_autoplay: block.settings.video_autoplay,
              video_loop: block.settings.video_autoplay,
              video_muted: video_muted,
              video_class: 'how-work__video',
              loading: image_loading
            %}
          {%- elsif image != blank -%}
            {{ image | image_url: width: 1000 | image_tag: class: 'how-work__image', widths: '300, 450, 600, 800, 1000', sizes: '(min-width: 769px) calc((100vw - 140px) / 3), 75vw', loading: image_loading, alt: image_alt }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'how-work__image how-work__image--placeholder' }}
          {%- endif -%}
        </div>

        {%- if title != blank -%}
          <div class="how-work__title">
            <h3>{{ step_number }}. {{ title | escape }}</h3>
          </div>
        {%- endif -%}

        {%- if description != blank -%}
          <div class="how-work__description">
            <p>{{ description | escape }}</p>
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .how-work {
    padding-top: var(--section-mobile-padding-top);
    padding-bottom: var(--section-mobile-padding-bottom);
    background: var(--section-background);
  }

  .how-work__header {
    padding: 0 16px 40px;
    text-align: center;
  }

  .how-work__subheading {
    padding-block-end: 8px;
  }

  .how-work__subheading p {
    margin: 0;
    font-family: var(--font-body--family);
    color: #2A2A2A;
    font-size: 14px;
    line-height: 16.8px;
    letter-spacing: 1.12px;
    font-weight: 400;
    text-transform: uppercase;
  }

  .how-work__heading h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    color: #2A2A2A;
    font-size: 18px;
    line-height: 23.4px;
    letter-spacing: -0.36px;
    font-weight: 400;
  }

  .how-work__list {
    display: grid;
    grid-auto-columns: 82.6%;
    grid-auto-flow: column;
    gap: 12px;
    margin: 0;
    padding: 0 16px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 18px;
    scrollbar-width: none;
  }

  .how-work__list::-webkit-scrollbar {
    display: none;
  }

  .how-work__list:focus-visible {
    outline: 1px solid #1a1a1a;
    outline-offset: 4px;
  }

  .how-work__item {
    scroll-snap-align: start;
  }

  .how-work__media {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background-color: #f2f2f2;
  }

  .how-work__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .how-work__image--placeholder {
    fill: #c4c4c4;
  }

  /* Video fills the step's media ratio and crops like the image does */
  .how-work__media--video :is(deferred-media, .video-placeholder-wrapper) {
    display: block;
    height: 100%;
  }

  .how-work__media--video :is(video, .deferred-media__poster-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .how-work__title {
    padding-block-start: 18px;
  }

  .how-work__title h3 {
    margin: 0;
    font-family: var(--font-body--family);
    color: #2A2A2A;
    font-size: 22px;
    line-height: 26.4px;
    letter-spacing: 1.32px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .how-work__description {
    padding-block-start: 8px;
  }

  .how-work__description p {
    margin: 0;
    font-family: var(--font-body--family);
    color: #2A2A2A;
    font-size: 16px;
    line-height: 19.2px;
    font-weight: 400;
  }

  @media (min-width: 769px) {
    .how-work {
      padding-top: var(--section-padding-top);
      padding-bottom: var(--section-padding-bottom);
    }

    .how-work__header {
      padding: 0 clamp(24px, 4.4vw, 60px) 40px;
    }

    .how-work__subheading {
      padding-block-end: 14px;
    }

    .how-work__subheading p {
      font-size: 20px;
      line-height: 24px;
      letter-spacing: 1.6px;
    }

    .how-work__heading h2 {
      font-size: 34px;
      line-height: 44.2px;
      letter-spacing: -0.68px;
    }

    .how-work__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      padding: 0 clamp(24px, 4.4vw, 60px);
      overflow: visible;
      scroll-snap-type: none;
    }

    .how-work__media {
      aspect-ratio: 347 / 414;
    }

    .how-work__description {
      max-width: none;
    }
  }

  /* Image ratio setting. Auto keeps the ratios above (2:3 on mobile, 347:414 on desktop);
     the others apply on every screen size. Images crop to fill with object-fit: cover. */
  .how-work--ratio-square .how-work__media {
    aspect-ratio: 1 / 1;
  }

  .how-work--ratio-portrait .how-work__media {
    aspect-ratio: 3 / 4;
  }

  .how-work--ratio-landscape .how-work__media {
    aspect-ratio: 4 / 3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How It Works",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No pins. No folding. It stays put all night."
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Media ratio",
      "info": "Auto keeps the original shape. Images and videos are cropped to fit without stretching.",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media Type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "info": "YouTube or Vimeo. Used when no video is uploaded.",
          "accept": ["youtube", "vimeo"],
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "image_picker",
          "id": "video_cover_image",
          "label": "Video Cover Image",
          "info": "Shown before the video plays. Uploaded videos use their own preview by default.",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "checkbox",
          "id": "video_muted",
          "label": "Muted",
          "info": "Autoplay videos always start muted because browsers block autoplay with sound.",
          "default": true,
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "checkbox",
          "id": "video_autoplay",
          "label": "Autoplay",
          "default": false,
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "The step number (01, 02, 03…) is added automatically.",
          "default": "Snap"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Attach design to the magnetic insert."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "settings": {
        "padding_top": 24,
        "padding_bottom": 64
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Snap",
            "description": "Attach design to the magnetic insert."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Slide",
            "description": "Place into your pocket and adjust."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Stand Out",
            "description": "Enjoy a finishing touch that gets noticed."
          }
        }
      ]
    }
  ]
}
{% endschema %}
