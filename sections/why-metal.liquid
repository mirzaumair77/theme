{%- liquid
  assign background_color = section.settings.background_color
  assign mobile_background_color = section.settings.mobile_background_color
  assign subheading = section.settings.subheading
  assign heading = section.settings.heading
  assign column_one_heading = section.settings.column_one_heading
  assign column_two_heading = section.settings.column_two_heading
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign mobile_padding_top = section.settings.mobile_padding_top
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-background: {{ background_color | default: 'transparent' }};
    --section-mobile-background: {{ mobile_background_color | default: background_color | default: 'transparent' }};
    --section-padding-top: {{ padding_top }}px;
    --section-padding-bottom: {{ padding_bottom }}px;
    --section-mobile-padding-top: {{ mobile_padding_top }}px;
    --section-mobile-padding-bottom: {{ mobile_padding_bottom }}px;
  }
{%- endstyle -%}

<div class="why-metal">
  {%- if subheading != blank or heading != blank -%}
    <div class="why-metal__header">
      {%- if subheading != blank -%}
        <div class="why-metal__subheading">
          <p>{{ subheading | escape }}</p>
        </div>
      {%- endif -%}

      {%- if heading != blank -%}
        <div class="why-metal__heading">
          <h2>{{ heading | escape }}</h2>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="why-metal__comparison">
    <div class="why-metal__table" role="table"{% if heading != blank %} aria-label="{{ heading | escape }}"{% endif %}>
      <div class="why-metal__row why-metal__row--head" role="row">
        <div class="why-metal__cell why-metal__cell--label" role="cell"></div>

        <div class="why-metal__cell" role="columnheader">
          <p>{{ column_one_heading | escape }}</p>
        </div>

        <div class="why-metal__cell why-metal__cell--highlight" role="columnheader">
          <p>{{ column_two_heading | escape }}</p>
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- liquid
          assign label = block.settings.label
          assign column_one_text = block.settings.column_one_text
          assign column_two_text = block.settings.column_two_text
        -%}

        <div class="why-metal__row" role="row" {{ block.shopify_attributes }}>
          <div class="why-metal__cell why-metal__cell--label" role="rowheader">
            <p>{{ label | escape }}</p>
          </div>

          <div class="why-metal__cell" role="cell">
            <p>{{ column_one_text | escape }}</p>
          </div>

          <div class="why-metal__cell why-metal__cell--highlight" role="cell">
            <p>{{ column_two_text | escape }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .why-metal {
    padding-top: var(--section-mobile-padding-top);
    padding-bottom: var(--section-mobile-padding-bottom);
    background: var(--section-mobile-background);
  }

  .why-metal__header {
    padding: 0 16px 40px;
    text-align: center;
  }

  .why-metal__subheading {
    padding-block-end: 8px;
  }

  .why-metal__subheading p {
    margin: 0;
    font-family: var(--font-body--family);
    color: #2A2A2A;
    font-size: 14px;
    line-height: 16.8px;
    letter-spacing: 1.12px;
    font-weight: 400;
    text-transform: uppercase;
  }

  .why-metal__heading h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    color: #2A2A2A;
    font-size: 18px;
    line-height: 23.4px;
    letter-spacing: -0.36px;
    font-weight: 400;
  }

  .why-metal__comparison {
    padding: 0 16px;
  }

  .why-metal__table {
    max-width: 886px;
    margin: 0 auto;
    border: 1px solid #CFC8BC;
  }

  .why-metal__row {
    display: grid;
    grid-template-columns: 22% 1fr 1fr;
  }

  .why-metal__row + .why-metal__row {
    border-top: 1px solid #CFC8BC;
  }

  .why-metal__cell {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 18px 8px;
    background-color: #ffffff;
    font-family: var(--font-body--family);
    color: #2A2A2A;
    font-size: 12px;
    line-height: 16.8px;
    font-weight: 400;
  }

  .why-metal__cell + .why-metal__cell {
    border-left: 1px solid #CFC8BC;
  }

  .why-metal__cell p {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
  }

  .why-metal__cell--label {
    font-size: 14px;
    letter-spacing: 1.96px;
    text-transform: uppercase;
  }

  .why-metal__cell--highlight {
    background-color: #FAF8F5;
    font-weight: 600;
  }

  .why-metal__row--head .why-metal__cell {
    background-color: #efeae1;
    color: #2A2A2A;
    font-size: 14px;
    line-height: 16.8px;
    letter-spacing: 0.84px;
    font-weight: 500;
    text-transform: uppercase;
  }

  @media (min-width: 769px) {
    .why-metal {
      padding-top: var(--section-padding-top);
      padding-bottom: var(--section-padding-bottom);
      background: var(--section-background);
    }

    .why-metal__header {
      padding: 0 clamp(24px, 4.4vw, 60px) 40px;
    }

    .why-metal__subheading {
      padding-block-end: 14px;
    }

    .why-metal__subheading p {
      font-size: 20px;
      line-height: 24px;
      letter-spacing: 1.6px;
    }

    .why-metal__heading h2 {
      font-size: 34px;
      line-height: 44.2px;
      letter-spacing: -0.68px;
    }

    .why-metal__comparison {
      padding: 0 clamp(24px, 4.4vw, 64px);
    }

    .why-metal__row {
      grid-template-columns: 15.8% 1fr 1fr;
    }

    .why-metal__cell {
      display: flex;
      padding: 22px;
      font-size: 14px;
    }

    .why-metal__row--head .why-metal__cell {
      text-align: center;
      font-size: 16px;
      line-height: 19.2px;
      letter-spacing: 0.96px;
    }
  }
{% endstylesheet %}

{% schema %}
