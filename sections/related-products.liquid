{% comment %}
  Section contract.
  "You may also like" product recommendations shown as a Swiper carousel.
  Fetches recommendations through the shared product-recommendations component and renders
  each product with the dedicated `product-item-v2` card snippet.
  @example
  <!-- Add "Related products" to a product template; the product defaults to the page's product -->
{% endcomment %}

{%- liquid
  assign background_color = section.settings.background_color
  assign heading = section.settings.heading
  assign selected_product = section.settings.product
  assign recommendation_type = section.settings.recommendation_type
  assign max_products = section.settings.max_products
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign mobile_padding_top = section.settings.mobile_padding_top
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom

  assign product_id = selected_product.id | default: product.id

  # Matches the slide widths in the stylesheet below (30px gap; gutter 16px / 60px; 1.25 → 4.4 slides).
  assign card_image_sizes = '(min-width: 1100px) calc((100vw - 222px) / 4.4), (min-width: 769px) calc((100vw - 186px) / 3.2), (min-width: 600px) calc((100vw - 71px) / 2.3), calc((100vw - 40px) / 1.25)'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --related-products-background: {{ background_color }};
    --related-products-padding-top: {{ padding_top }}px;
    --related-products-padding-bottom: {{ padding_bottom }}px;
    --related-products-mobile-padding-top: {{ mobile_padding_top }}px;
    --related-products-mobile-padding-bottom: {{ mobile_padding_bottom }}px;
  }
{%- endstyle -%}

<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- comment -%} Early render: recommendations arrive by hydration, after the cards' CSS is needed. {%- endcomment -%}
{% render 'product-item-v2-styles' %}
{% render 'product-recommendations-styles' %}

{%- capture heading_markup -%}
  {%- if heading != blank -%}
    <div class="related-products__heading">
      <h2>{{ heading | escape }}</h2>
    </div>
  {%- endif -%}
{%- endcapture -%}

<product-recommendations
  id="related-products-{{ section.id }}"
  class="related-products"
  data-url="{{ routes.product_recommendations_url }}?limit={{ max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product_id }}"
  data-intent="{{ recommendation_type }}"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-hydration-key="related-products-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  {%- if recommendations.performed or selected_product == blank -%}
    {%- liquid
      if selected_product == blank
        # Onboarding mode: render placeholder cards
        assign products = null
        for i in (1..max_products)
          assign products = products | append: ', '
          assign products = products | split: ','
        endfor
      elsif recommendations.performed and recommendations.products_count == 0
        # No recommendations found, pull from catalog
        if recommendation_type == 'related'
          assign products = collections.all.products | reject: 'id', selected_product.id
        else
          assign products = null
        endif
      else
        assign products = recommendations.products
      endif

      if products != blank and products.size > 0
        assign has_recommendations = 'true'
      else
        assign has_recommendations = 'false'
      endif
    -%}

    <related-products-slider data-has-recommendations="{{ has_recommendations }}">
      <div class="related-products__header">
        {{ heading_markup }}

        <div class="related-products__arrows">
          <button
            type="button"
            class="related-products__arrow related-products__arrow--prev"
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
            disabled
          >
            <svg aria-hidden="true" focusable="false"  xmlns="http://www.w3.org/2000/svg" width="32" height="20" viewBox="0 0 32 20" fill="none"><g transform="matrix(-1 0 0 -1 32 20)">
              <path d="M-9.53674e-07 9.71875L32 9.71875M22.6667 0.71875L32 9.71875L22.6667 18.7188" stroke-width="1.6" stroke="currentColor"/>
            </g></svg>
          </button>
          <button
            type="button"
            class="related-products__arrow related-products__arrow--next"
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
          >
            <svg aria-hidden="true" focusable="false"  xmlns="http://www.w3.org/2000/svg" width="32" height="20" viewBox="0 0 32 20" fill="none">
              <path d="M-9.53674e-07 9.71875L32 9.71875M22.6667 0.71875L32 9.71875L22.6667 18.7188" stroke-width="1.6" stroke="currentColor"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="related-products__slider">
        <div class="related-products__track">
          {%- for product in products limit: max_products -%}
            <div class="related-products__slide">
              {% render 'product-item-v2', product: product, image_sizes: card_image_sizes, loading: 'lazy' %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </related-products-slider>
  {%- else -%}
    <div class="related-products__header">
      {{ heading_markup }}
    </div>

    <div class="related-products__skeleton">
      {%- for i in (1..4) -%}
        <div
          class="product-recommendations__skeleton-item"
          aria-label="{{ 'accessibility.loading_product_recommendations' | t }}"
        ></div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if button_label != blank and button_link != blank -%}
    <div class="related-products__button">
      <a href="{{ button_link }}">
        {{- button_label | escape -}}
        <svg aria-hidden="true" focusable="false" width="14" height="8" viewBox="0 0 14 8" fill="none">
          <path d="M0 4h13m0 0L9.5.5M13 4 9.5 7.5" stroke="currentColor"/>
        </svg>
      </a>
    </div>
  {%- endif -%}
</product-recommendations>

<script>
  (() => {
    if (customElements.get('related-products-slider')) return;

    let swiperPromise;

    // Swiper is loaded by theme.liquid. This inline script can run before a deferred/async
    // Swiper script has executed, so wait for window.Swiper rather than assuming it exists.
    const whenSwiperReady = () => {
      swiperPromise ??= new Promise((resolve, reject) => {
        const hasSwiper = () => Boolean(window.Swiper);
        if (hasSwiper()) return resolve();

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => hasSwiper() && resolve(), { once: true });
        }

        if (document.readyState === 'complete') return reject(new Error('Swiper is not available'));

        window.addEventListener(
          'load',
          () => (hasSwiper() ? resolve() : reject(new Error('Swiper is not available'))),
          { once: true }
        );
      });

      return swiperPromise;
    };

    class RelatedProductsSlider extends HTMLElement {
      connectedCallback() {
        if (this.abortController) return;

        this.abortController = new AbortController();
        const { signal } = this.abortController;

        whenSwiperReady()
          .then(() => {
            if (!signal.aborted) this.init();
          })
          .catch(() => {});
      }

      disconnectedCallback() {
        this.abortController?.abort();
        this.abortController = null;
        this.swiper?.destroy(true, true);
        this.swiper = null;
      }

      init() {
        const slider = this.querySelector('.related-products__slider');
        if (!slider || this.swiper) return;

        const prevEl = this.querySelector('.related-products__arrow--prev');
        const nextEl = this.querySelector('.related-products__arrow--next');

        slider.scrollLeft = 0;

        this.swiper = new Swiper(slider, {
          wrapperClass: 'related-products__track',
          slideClass: 'related-products__slide',
          slidesPerView: 1.25,
          spaceBetween: 15,
          speed: 500,
          watchOverflow: true,
          navigation: {
            prevEl,
            nextEl,
            disabledClass: 'related-products__arrow--disabled',
            lockClass: 'related-products__arrow--locked',
          },
          a11y: {
            prevSlideMessage: prevEl?.getAttribute('aria-label'),
            nextSlideMessage: nextEl?.getAttribute('aria-label'),
            slideRole: 'group',
          },
          breakpoints: {
            600: { slidesPerView: 2.3, spaceBetween: 30 },
            769: { slidesPerView: 3.2, spaceBetween: 30 },
            // 4 full cards with the next one peeking in
            1100: { slidesPerView: 4.4, spaceBetween: 30 },
          },
        });

        slider.classList.add('related-products__slider--ready');
      }
    }

    customElements.define('related-products-slider', RelatedProductsSlider);
  })();
</script>

{% stylesheet %}
  .related-products {
    --related-products-gutter: 16px;
    --related-products-gap: 30px;
    --related-products-per-view: 1.25;

    display: block;
    padding-block: var(--related-products-mobile-padding-top) var(--related-products-mobile-padding-bottom);
    background: var(--related-products-background);
    color: #121212;
    overflow: hidden;
    padding-inline: var(--related-products-gutter);
  }

  .related-products__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block-end: 16px;
  }

  .related-products__heading {
    min-width: 0;
  }

  .related-products__heading h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    color: #2A2A2A;
    font-size: 20px;
    line-height: 23px;
    letter-spacing: -0.4px;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .related-products__arrows {
    display: none;
  }

  .related-products__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: #2A2A2A;
    cursor: pointer;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .related-products__arrow:hover:not(:disabled) {
    transform: translateX(3px);
  }

  .related-products__arrow--prev:hover:not(:disabled) {
    transform: translateX(-3px);
  }

  .related-products__arrow:disabled,
  .related-products__arrow--disabled {
    color: #cfc8bc;
    cursor: default;
  }

  .related-products__arrow--locked {
    display: none;
  }

  .related-products__arrow:focus-visible {
    outline: 1px solid #121212;
    outline-offset: 2px;
  }

  .related-products__arrow svg {
    width: 100%;
    height: auto;
  }

  .related-products__skeleton {
    overflow: visible;
  }

  /*
    Full-bleed viewport: the slider spans the section edge to edge and carries the gutter as its
    own padding. Slides are laid out (and Swiper measures them) inside the padding, so the first
    slide starts one gutter from the left and the last slide stops one gutter from the right,
    while neighbouring slides stay visible through the gutters as they move.
  */
  .related-products__slider {
    margin-inline: calc(-1 * var(--related-products-gutter));
    padding-inline: var(--related-products-gutter);
    scroll-padding-inline: var(--related-products-gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .related-products__slider::-webkit-scrollbar {
    display: none;
  }

  /* Swiper drives the track with transforms; clip at the section edges, not at the gutter */
  .related-products__slider--ready {
    overflow: hidden;
    scroll-snap-type: none;
  }

  .related-products__track {
    display: flex;
    transition-property: transform;
  }

  .related-products__slide,
  .related-products__skeleton > * {
    flex-shrink: 0;
    min-width: 0;
    width: calc((100% - (var(--related-products-per-view) - 1) * var(--related-products-gap)) / var(--related-products-per-view));
    margin-inline-end: var(--related-products-gap);
    scroll-snap-align: start;
  }

  /* The slider's end padding is the trailing gutter */
  .related-products__slide:last-child {
    margin-inline-end: 0;
  }

  .related-products__skeleton {
    display: flex;
  }

  .related-products__button {
    display: flex;
    justify-content: center;
    padding-block-start: 16px;
  }

  .related-products__button a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 32px;
    border: 1px solid #2A2A2A;
    background-color: transparent;
    font-family: var(--font-inter, var(--font-body--family));
    color: #2A2A2A;
    font-size: 12px;
    line-height: normal;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .related-products__button a:hover {
    background-color: #121212;
    color: #ffffff;
  }

  .related-products__button a:focus-visible {
    outline: 1px solid #121212;
    outline-offset: 3px;
  }

  .related-products__button svg {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .related-products__button a:hover svg {
    transform: translateX(3px);
  }

  @media (min-width: 600px) {
    .related-products {
      --related-products-per-view: 2.3;
    }
  }

  @media (min-width: 769px) {
    .related-products {
      --related-products-gutter: 60px;
      --related-products-per-view: 3.2;

      padding-block: var(--related-products-padding-top) var(--related-products-padding-bottom);
    }
    
    .related-products__header {
      padding-block-end: 30px;
    }
    
    .related-products__heading h2 {
      font-size: 34px;
      line-height: normal;
      letter-spacing: -1.02px;
    }

    .related-products__arrows {
      display: flex;
      align-items: center;
      gap: 32px;
      flex-shrink: 0;
    }
  }

  @media (min-width: 1100px) {
    .related-products {
      --related-products-per-view: 4.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-products__arrow,
    .related-products__button a,
    .related-products__button svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section-related-products",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop best sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Recommendations"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "Type",
      "options": [
        {
          "value": "related",
          "label": "Related"
        },
        {
          "value": "complementary",
          "label": "Complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Product count",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Related products",
      "category": "t:categories.products",
      "settings": {
        "product": "{{ closest.product }}"
      }
    }
  ]
}
{% endschema %}
