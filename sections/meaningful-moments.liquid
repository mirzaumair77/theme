{%- liquid
  assign background_color = section.settings.background_color
  assign heading = section.settings.heading
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign mobile_padding_top = section.settings.mobile_padding_top
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom
  assign section_index = section.index
  assign track_id = 'MeaningfulMomentsTrack-' | append: section.id
  assign track_label = heading | default: 'Featured products'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-background: {{ background_color | default: 'transparent' }};
    --section-padding-top: {{ padding_top }}px;
    --section-padding-bottom: {{ padding_bottom }}px;
    --section-mobile-padding-top: {{ mobile_padding_top }}px;
    --section-mobile-padding-bottom: {{ mobile_padding_bottom }}px;
  }
{%- endstyle -%}

<div class="meaningful-moments">
  {%- if heading != blank -%}
    <div class="meaningful-moments__heading">
      <h2>{{ heading | escape }}</h2>
    </div>
  {%- endif -%}

  <meaningful-moments-slider class="meaningful-moments__slider">
    <button type="button" class="meaningful-moments__arrow meaningful-moments__arrow--prev" aria-label="Previous slide" aria-controls="{{ track_id }}" disabled>
      <svg width="18" height="34" viewBox="0 0 18 34" fill="none" aria-hidden="true" focusable="false">
        <path d="M17 1L1 17L17 33" stroke="currentColor" stroke-width="1"/>
      </svg>
    </button>

    <div class="meaningful-moments__viewport">
    <ul id="{{ track_id }}" class="meaningful-moments__track" role="list" aria-label="{{ track_label | escape }}">
      {%- for block in section.blocks -%}
        {%- liquid
          # Product display on: product card + image fallback. Off: the image links to the block's URL.
          assign product = nil
          assign link = nil
          if block.settings.product_display == 'disabled'
            assign link = block.settings.link
          else
            assign product = block.settings.product
          endif
          assign image = block.settings.image | default: product.featured_media

          assign image_loading = 'lazy'
          if section_index <= 2 and forloop.index <= 4 and request.page_type != 'product'
            assign image_loading = 'eager'
          endif

          assign image_alt = image.alt | default: product.title
        -%}

        <li class="meaningful-moments__slide" {{ block.shopify_attributes }}>
          {%- if link != blank -%}
            <a class="meaningful-moments__media" href="{{ link }}"{% if image_alt == blank %} aria-label="{{ track_label | escape }}"{% endif %}>
          {%- else -%}
            <div class="meaningful-moments__media">
          {%- endif -%}
            {%- if image != blank -%}
              {{ image | image_url: width: 900 | image_tag: class: 'meaningful-moments__image', widths: '300, 450, 600, 900', sizes: '(min-width: 769px) 24vw, 74vw', loading: image_loading, alt: image_alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'meaningful-moments__image meaningful-moments__image--placeholder' }}
            {%- endif -%}
          {%- if link != blank -%}</a>{%- else -%}</div>{%- endif -%}

          {%- if product != blank -%}
            <div class="meaningful-moments__product">
              <a href="{{ product.url }}">
                <div class="meaningful-moments__product-image">
                  {%- if product.featured_media != blank -%}
                    {{ product.featured_media | image_url: width: 160 | image_tag: class: 'meaningful-moments__thumbnail', widths: '80, 160', sizes: '64px', loading: 'lazy', alt: '' }}
                  {%- endif -%}
                </div>

                <div class="meaningful-moments__product-info">
                  <div class="meaningful-moments__product-title">
                    <p>{{ product.title | escape }}</p>
                  </div>

                  <div class="meaningful-moments__product-price">
                    <p>{{ product.price | money }}</p>
                  </div>
                </div>
              </a>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    </div>

    <button type="button" class="meaningful-moments__arrow meaningful-moments__arrow--next" aria-label="Next slide" aria-controls="{{ track_id }}">
      <svg width="18" height="34" viewBox="0 0 18 34" fill="none" aria-hidden="true" focusable="false">
        <path d="M1 1L17 17L1 33" stroke="currentColor" stroke-width="1"/>
      </svg>
    </button>
  </meaningful-moments-slider>
</div>

<script>
  (() => {
    if (customElements.get('meaningful-moments-slider')) return;

    let swiperPromise;

    // Swiper is loaded by theme.liquid. This inline script can run before a deferred/async
    // Swiper script has executed, so wait for window.Swiper rather than assuming it exists.
    const whenSwiperReady = () => {
      swiperPromise ??= new Promise((resolve, reject) => {
        const hasSwiper = () => Boolean(window.Swiper);
        if (hasSwiper()) return resolve();

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => hasSwiper() && resolve(), { once: true });
        }

        if (document.readyState === 'complete') return reject(new Error('Swiper is not available'));

        window.addEventListener(
          'load',
          () => (hasSwiper() ? resolve() : reject(new Error('Swiper is not available'))),
          { once: true }
        );
      });

      return swiperPromise;
    };

    class MeaningfulMomentsSlider extends HTMLElement {
      connectedCallback() {
        if (this.abortController) return;

        this.abortController = new AbortController();
        const { signal } = this.abortController;

        // Theme editor: bring the selected slide into view.
        this.addEventListener(
          'shopify:block:select',
          (event) => {
            const slides = [...this.querySelectorAll('.meaningful-moments__slide')];
            const index = slides.indexOf(event.target.closest('.meaningful-moments__slide'));
            if (index > -1) this.swiper?.slideTo(index);
          },
          { signal }
        );

        whenSwiperReady()
          .then(() => {
            if (!signal.aborted) this.init();
          })
          .catch(() => {});
      }

      disconnectedCallback() {
        this.abortController?.abort();
        this.abortController = null;
        this.swiper?.destroy(true, true);
        this.swiper = null;
      }

      init() {
        const viewport = this.querySelector('.meaningful-moments__viewport');
        if (!viewport || this.swiper) return;

        const prevEl = this.querySelector('.meaningful-moments__arrow--prev');
        const nextEl = this.querySelector('.meaningful-moments__arrow--next');

        viewport.scrollLeft = 0;

        this.swiper = new Swiper(viewport, {
          wrapperClass: 'meaningful-moments__track',
          slideClass: 'meaningful-moments__slide',
          slidesPerView: 1.32,
          spaceBetween: 8,
          slidesOffsetBefore: 16,
          slidesOffsetAfter: 16,
          speed: 500,
          watchOverflow: true,
          navigation: {
            prevEl,
            nextEl,
            disabledClass: 'meaningful-moments__arrow--disabled',
          },
          a11y: {
            prevSlideMessage: prevEl?.getAttribute('aria-label'),
            nextSlideMessage: nextEl?.getAttribute('aria-label'),
            slideRole: 'group',
          },
          breakpoints: {
            769: { slidesPerView: 3.85, spaceBetween: 8, slidesOffsetBefore: 0, slidesOffsetAfter: 0 },
          },
        });

        this.classList.add('meaningful-moments__slider--ready');
      }
    }

    customElements.define('meaningful-moments-slider', MeaningfulMomentsSlider);
  })();
</script>

{% stylesheet %}
  .meaningful-moments {
    padding-top: var(--section-mobile-padding-top);
    padding-bottom: var(--section-mobile-padding-bottom);
    background: var(--section-background);
    padding-inline: 16px;
  }

  .meaningful-moments__heading {
    padding-block-end: 40px;
    text-align: center;
  }

  .meaningful-moments__heading h2 {
    margin: 0;
    color: #2A2A2A;
    font-size: 18px;
    line-height: 23.4px;
    letter-spacing: -0.36px;
    font-style: italic;
    font-weight: 400;
  }

  .meaningful-moments__slider {
    position: relative;
    display: block;
  }

  .meaningful-moments__arrow {
    display: none;
  }

  .meaningful-moments__track {
    position: relative;
    display: grid;
    grid-auto-columns: 74%;
    grid-auto-flow: column;
    gap: 8px;
    margin: 0;
    padding: 0 16px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
  }

  .meaningful-moments__track::-webkit-scrollbar {
    display: none;
  }

  .meaningful-moments__viewport {
    min-width: 0;
  }

  /* Swiper drives the track once ready: drop the scroll-snap fallback layout */
  .meaningful-moments__slider--ready .meaningful-moments__viewport {
    overflow: hidden;
    margin-inline: -16px;
  }

  .meaningful-moments__slider--ready .meaningful-moments__track {
    display: flex;
    gap: 0;
    padding: 0;
    overflow: visible;
    scroll-snap-type: none;
    transition-property: transform;
  }

  .meaningful-moments__slider--ready .meaningful-moments__slide {
    flex-shrink: 0;
  }

  .meaningful-moments__slide {
    position: relative;
    min-width: 0;
    scroll-snap-align: start;
  }

  .meaningful-moments__media {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f2f2f2;
  }

  .meaningful-moments__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meaningful-moments__image--placeholder {
    fill: #c4c4c4;
  }

  .meaningful-moments__product {
    margin-top: 14px;
  }

  .meaningful-moments__product a {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .meaningful-moments__product a:focus-visible {
    outline: 1px solid #1a1a1a;
    outline-offset: 2px;
  }

  .meaningful-moments__product-image {
    flex: 0 0 43px;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .meaningful-moments__thumbnail {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .meaningful-moments__product-info {
    display: flex;
    flex: 1;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
  }

  .meaningful-moments__product-title p,
  .meaningful-moments__product-price p {
    margin: 0;
    color: #2A2A2A;
    font-size: 12px;
    font-weight: 400;
  }

  .meaningful-moments__product-title p {
    line-height: 14.4px;
  }

  .meaningful-moments__product-price p {
    line-height: 16.8px;
    white-space: nowrap;
  }

  @media (min-width: 769px) {
    .meaningful-moments {
      padding-top: var(--section-padding-top);
      padding-bottom: var(--section-padding-bottom);
      padding-inline: clamp(24px, 4.4vw, 60px);
    }

    .meaningful-moments__heading h2 {
      font-size: 34px;
      line-height: 44.2px;
      letter-spacing: -0.68px;
    }

    /* 60px total on each side: the slider wrapper's own padding is the arrow column (as in the
       variant group), so the arrows sit inside the wrapper and images never run under them.
       Fixed on every slide position. */
       
    .meaningful-moments__slider--ready .meaningful-moments__viewport {
      margin-inline: 0px;
    }   
    
    .meaningful-moments__arrow {
      position: absolute;
      top: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      background: var(--section-background);
      color: #212121;
      cursor: pointer;
      transition: opacity 0.25s ease;
    }

    /* Each arrow fills its 60px column, mirrored left and right */
    .meaningful-moments__arrow--prev {
      left: 0;
    }

    .meaningful-moments__arrow--next {
      right: 0;
    }

    .meaningful-moments__arrow:disabled,
    .meaningful-moments__arrow--disabled {
      opacity: 0;
      pointer-events: none;
    }

    .meaningful-moments__arrow:focus-visible {
      outline: 1px solid #1a1a1a;
    }

    .meaningful-moments__track {
      grid-auto-columns: calc((100% - 24px) / 3.85);
      padding: 0;
      scroll-padding-inline: 0;
    }

    .meaningful-moments__media {
      aspect-ratio: 297 / 366;
    }

    .meaningful-moments__product-title p,
    .meaningful-moments__product-price p {
      font-size: 14px;
      line-height: 16.8px;
    }
  }

  @media (min-width: 769px) and (hover: hover) {
    .meaningful-moments__product {
      position: absolute;
      right: 6px;
      bottom: 6px;
      left: 6px;
      margin: 0;
      padding: 4px;
      background-color: #ffffff;
      opacity: 0;
      pointer-events: none;
      transform: translateY(8px);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .meaningful-moments__slide:hover .meaningful-moments__product,
    .meaningful-moments__slide:focus-within .meaningful-moments__product {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .meaningful-moments__product a {
      align-items: center;
      gap: 12px;
    }

    .meaningful-moments__product-image {
      flex-basis: 68px;
    }

    .meaningful-moments__product-info {
      flex-direction: column;
      justify-content: center;
      gap: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .meaningful-moments__product,
    .meaningful-moments__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Meaningful Moments",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for moments that matter."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "With Product Display enabled, falls back to the product's featured image if empty."
        },
        {
          "type": "select",
          "id": "product_display",
          "label": "Product Display",
          "options": [
            { "value": "enabled", "label": "Enabled" },
            { "value": "disabled", "label": "Disabled" }
          ],
          "default": "enabled"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Used only when Product Display is enabled."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "The slide image links here.",
          "visible_if": "{{ block.settings.product_display == 'disabled' }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meaningful Moments",
      "settings": {
        "padding_top": 80,
        "padding_bottom": 100,
        "mobile_padding_top": 48,
        "mobile_padding_bottom": 48
      },
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
