{%- liquid
  assign heading = section.settings.heading
  assign open_first = section.settings.open_first
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign mobile_padding_top = section.settings.mobile_padding_top
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom
  assign background = section.settings.background
-%}

<style>
#shopify-section-{{ section.id }} {
  padding-top: {{ mobile_padding_top }}px;
  padding-bottom: {{ mobile_padding_bottom }}px;
  {%- if background != blank %}
    background: {{ background }};
  {%- endif %}
}
@media (min-width: 769px) {
  #shopify-section-{{ section.id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
}

.question-answer {
  display: grid;
  gap: 20px;
  padding-inline: 16px;
  color: #2a2a2a;
}

.question-answer p,
.question-answer h2,
.question-answer h3 {
  margin: 0;
}

.question-answer__heading h2 {
  font-family: var(--font-heading--family);
  color: #2A2A2A;
  font-size: 20px;
  line-height: 23px;
  letter-spacing: -0.4px;
  font-weight: 500;
}

.question-answer__item + .question-answer__item {
  border-top: 1px solid #dddad5;
}

.question-answer__question button {
  position: relative;
  display: block;
  width: 100%;
  padding: 20px 36px 20px 0;
  border: 0;
  background: none;
  font-family: var(--font-body--family);
  color: #2A2A2A;
  font-size: 14px;
  line-height: 16.8px;
  letter-spacing: 1.12px;
  font-weight: 400;
  text-align: start;
  cursor: pointer;
  transition: padding 0.4s ease;
}

.question-answer__item--open .question-answer__question button {
  padding-bottom: 16px;
}

.question-answer__question button:focus-visible {
  outline: 2px solid #2a2a2a;
  outline-offset: 2px;
}

/* Plus icon; the vertical bar turns flat into a minus when open */
.question-answer__question button::before,
.question-answer__question button::after {
  content: '';
  position: absolute;
  top: 50%;
  inset-inline-end: 0;
  width: 12px;
  height: 1px;
  background-color: #2a2a2a;
  transition: transform 0.35s ease;
}

.question-answer__question button::after {
  transform: rotate(90deg);
}

.question-answer__item--open button::after {
  transform: rotate(0deg);
}

.question-answer__panel {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.question-answer__item--open .question-answer__panel {
  grid-template-rows: 1fr;
}

.question-answer__answer {
  min-height: 0;
  overflow: hidden;
  padding-inline-end: 36px;
  font-family: var(--font-body--family);
  color: #2A2A2A;
  font-size: 13px;
  line-height: 19.688px;
  letter-spacing: 0.131px;
  font-weight: 400;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.question-answer__item--open .question-answer__answer {
  opacity: 1;
  transition-delay: 0.1s;
}

/* Bottom spacing inside the clipped panel, so it collapses with the answer */
.question-answer__answer::after {
  content: '';
  display: block;
  height: 22px;
}

.question-answer__answer > * {
  margin: 0;
}

.question-answer__answer > * + * {
  margin-top: 10px;
}

.question-answer__answer a {
  color: inherit;
}

@media (prefers-reduced-motion: reduce) {
  .question-answer__question button::before,
  .question-answer__question button::after,
  .question-answer__panel,
  .question-answer__answer {
    transition: none;
  }
}

@media (min-width: 769px) {
  .question-answer {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 24px;
    padding-inline: clamp(24px, 4.4vw, 60px);
  }

  .question-answer__heading {
    position: sticky;
    top: 80px;
  }

  .question-answer__heading h2 {
    font-size: 34px;
    line-height: 44.2px;
    letter-spacing: -0.68px;
  }

  /* Center the first question on the heading's first line */
  .question-answer__list {
    margin-top: -6px;
  }

  .question-answer__question button {
    font-size: 16px;
    line-height: 19.2px;
    letter-spacing: 1.28px;
  }

  .question-answer__answer {
    max-width: 473px;
    padding-inline-end: 0;
    font-size: 14px;
    line-height: 19.6px;
    letter-spacing: normal;
  }

  .question-answer__answer::after {
    height: 18px;
  }
}
</style>

<question-answer class="question-answer">
  {%- if heading != blank -%}
    <div class="question-answer__heading">
      <h2>{{ heading | escape }}</h2>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="question-answer__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign question = block.settings.question
          assign answer = block.settings.answer

          assign is_open = false
          if open_first and forloop.first
            assign is_open = true
          endif

          assign button_id = 'QuestionAnswerButton-' | append: block.id
          assign panel_id = 'QuestionAnswerPanel-' | append: block.id
        -%}
        <div
          class="question-answer__item{% if is_open %} question-answer__item--open{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="question-answer__question">
            <button
              type="button"
              id="{{ button_id }}"
              aria-expanded="{{ is_open }}"
              aria-controls="{{ panel_id }}"
            >
              {{- question | escape -}}
            </button>
          </div>
          <div
            class="question-answer__panel"
            id="{{ panel_id }}"
            role="region"
            aria-labelledby="{{ button_id }}"
            {% unless is_open %}
              inert
            {% endunless %}
          >
            <div class="question-answer__answer">
              {{ answer }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</question-answer>

<script>
  (() => {
    if (customElements.get('question-answer')) return;

    class QuestionAnswer extends HTMLElement {
      connectedCallback() {
        this.addEventListener('click', this.onClick);
        this.addEventListener('keydown', this.onKeydown);
        this.addEventListener('shopify:block:select', this.onBlockSelect);
      }

      disconnectedCallback() {
        this.removeEventListener('click', this.onClick);
        this.removeEventListener('keydown', this.onKeydown);
        this.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      get buttons() {
        return [...this.querySelectorAll('.question-answer__question button')];
      }

      toggle(item, open) {
        const button = item.querySelector('.question-answer__question button');
        const panel = item.querySelector('.question-answer__panel');
        const shouldOpen = open ?? button.getAttribute('aria-expanded') !== 'true';

        item.classList.toggle('question-answer__item--open', shouldOpen);
        button.setAttribute('aria-expanded', String(shouldOpen));
        panel.inert = !shouldOpen;
      }

      onClick = (event) => {
        const button = event.target.closest('.question-answer__question button');
        if (!button) return;
        this.toggle(button.closest('.question-answer__item'));
      };

      onKeydown = (event) => {
        const button = event.target.closest('.question-answer__question button');
        if (!button) return;

        const buttons = this.buttons;
        const index = buttons.indexOf(button);
        const targets = {
          ArrowDown: buttons[(index + 1) % buttons.length],
          ArrowUp: buttons[(index - 1 + buttons.length) % buttons.length],
          Home: buttons[0],
          End: buttons[buttons.length - 1],
        };
        const target = targets[event.key];

        if (!target) return;
        event.preventDefault();
        target.focus();
      };

      onBlockSelect = (event) => {
        const item = event.target.closest('.question-answer__item');
        if (item) this.toggle(item, true);
      };
    }

    customElements.define('question-answer', QuestionAnswer);
  })();
</script>

{% schema %}
{
  "name": "Questions & Answers",
  "tag": "section",
  "class": "section-question-answer",
  "max_blocks": 20,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "header",
      "content": "Accordion"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question by default",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you ship internationally?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Free ground shipping on all US orders. We do ship internationally to select countries.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions & Answers",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Free ground shipping on all US orders. We do ship internationally to select countries.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long will my order take?",
            "answer": "<p>Most orders ship within 3–5 business days. Handcrafted and custom pieces may take longer.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you make custom pieces?",
            "answer": "<p>Yes. Contact us with your idea and we'll walk you through the process.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What if it doesn't fit?",
            "answer": "<p>We offer easy exchanges and returns. Reach out and we'll make it right.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How does the Pocket Square™ stay in place?",
            "answer": "<p>Each piece is designed with a discreet clip that holds securely inside your pocket.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
