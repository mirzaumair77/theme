{%- liquid
  assign autoplay = section.settings.autoplay
  assign autoplay_delay = section.settings.autoplay_delay
  assign transition_effect = section.settings.transition_effect
  assign desktop_height = section.settings.desktop_height
  assign mobile_height = section.settings.mobile_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign mobile_padding_top = section.settings.mobile_padding_top
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom
  assign background = section.settings.background
  assign hero_height = section.settings.hero_height | default: 'large'
  assign overlay_enabled = section.settings.overlay_enabled
  assign slide_count = section.blocks.size

  # Large uses the height sliders; fit screen and auto are sized in CSS.
  case hero_height
    when 'small'
      assign mobile_height = 440
      assign desktop_height = 520
    when 'medium'
      assign mobile_height = 640
      assign desktop_height = 614
  endcase
-%}

<style>
#shopify-section-{{ section.id }} {
  --hero-height-mobile: {{ mobile_height }}px;
  --hero-height-desktop: {{ desktop_height }}px;
  padding-top: {{ mobile_padding_top }}px;
  padding-bottom: {{ mobile_padding_bottom }}px;
  {%- if background != blank %}
    background: {{ background }};
  {%- endif %}
}
@media (min-width: 769px) {
  #shopify-section-{{ section.id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
}
{%- if overlay_enabled %}
  /* Overlay: a full-width gradient along the bottom of the banner, above the image or video
     and below the slide content. Shorter slides cap it at their own height. */
  #shopify-section-{{ section.id }} .hero-banner__media::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 402.883px;
    max-height: 100%;
    background: linear-gradient(180deg, rgba(42, 42, 42, 0) 0%, #2a2a2a 100%);
    pointer-events: none;
  }
{%- endif %}

.hero-banner {
  position: relative;
  display: block;
}

.hero-banner p,
.hero-banner h2 {
  margin: 0;
}

.hero-banner__slider {
  overflow: hidden;
}

.hero-banner__track {
  display: flex;
  transition-property: transform;
}

.hero-banner__slide {
  position: relative;
  flex-shrink: 0;
  width: 100%;
  height: var(--hero-height-mobile);
  transition-property: transform, opacity;
}

.hero-banner__media {
  position: absolute;
  inset: 0;
  background-color: #1a1a1a;
}

/* Darkens the lower part of the media so the content stays legible */
.hero-banner__media::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.6) 100%);
  pointer-events: none;
}

/* With separate desktop and mobile images, show the one for the current breakpoint */
@media (max-width: 768px) {
  .hero-banner__media .hero-banner__image--desktop {
    display: none;
  }
}

@media (min-width: 769px) {
  .hero-banner__media .hero-banner__image--mobile {
    display: none;
  }
}

.hero-banner--fit-screen .hero-banner__slide {
  height: calc(100svh - var(--header-group-height, 0px));
}

/* A transparent header overlays the hero, so the hero fills the whole screen */
body:has(#header-component[transparent]) .hero-banner--fit-screen .hero-banner__slide {
  height: 100svh;
}

/* With a transparent header, the theme pulls the first section up by --header-group-height,
   which is the announcement bar's height (the floating header itself isn't counted). Push the
   hero back down by the same amount so it starts below the bar, with the header over its top;
   fit screen gives up that height to still end at the bottom of the screen. */
body:has(#header-component[transparent]):has(#header-group .announcement-bar) .hero-banner {
  margin-top: var(--header-group-height, 0px);
}

body:has(#header-component[transparent]):has(#header-group .announcement-bar)
  .hero-banner--fit-screen
  .hero-banner__slide {
  height: calc(100svh - var(--header-group-height, 0px));
}

/* Auto keeps the media's ratio; the mobile minimum leaves room for the slide content */
.hero-banner--auto .hero-banner__slide {
  height: auto;
  min-height: 440px;
  aspect-ratio: var(--hero-ratio-mobile, 4 / 5);
}

.hero-banner__media img,
.hero-banner__media svg,
.hero-banner__media video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-banner__video-wrapper {
  height: 100%;
}

.hero-banner__video-toggle {
  position: absolute;
  top: 16px;
  right: 16px;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.25);
  color: #ffffff;
  cursor: pointer;
  transition: background-color 0.3s ease, border-color 0.3s ease;
}

.hero-banner__video-toggle:hover {
  border-color: #ffffff;
  background-color: rgba(0, 0, 0, 0.45);
}

.hero-banner__video-toggle:focus-visible {
  outline: 2px solid #ffffff;
  outline-offset: 2px;
}

.hero-banner__video-toggle svg {
  width: 12px;
  height: 12px;
}

.hero-banner__video-toggle .hero-banner__icon-play,
.hero-banner[data-videos-paused] .hero-banner__video-toggle .hero-banner__icon-pause {
  display: none;
}

.hero-banner[data-videos-paused] .hero-banner__video-toggle .hero-banner__icon-play {
  display: block;
}

@media (max-width: 768px) {
  .hero-banner__video--desktop {
    display: none;
  }
}

@media (min-width: 769px) {
  .hero-banner__video--mobile {
    display: none;
  }
}

.hero-banner__media svg {
  fill: rgba(255, 255, 255, 0.25);
}

.hero-banner__content {
  position: absolute;
  inset-inline: 0;
  bottom: 0;
  z-index: 1;
  padding: 0 16px 24px;
  color: #ffffff;
}

.hero-banner__eyebrow p {
  font-family: var(--font-body--family);
  color: #ffffff;
  font-size: 12px;
  line-height: 14.4px;
  font-weight: 400;
  text-transform: uppercase;
}

.hero-banner__heading {
  max-width: 640px;
  padding-block-start: 12px;
}

.hero-banner__heading h2 {
  font-family: var(--font-heading--family);
  color: #ffffff;
  font-variant-numeric: lining-nums proportional-nums;
  font-size: 28px;
  line-height: 25.48px;
  letter-spacing: -0.56px;
  font-weight: 400;
}

.hero-banner__description {
  max-width: 549px;
  padding-block-start: 12px;
}

.hero-banner__description p {
  font-family: var(--font-body--family);
  color: #ffffff;
  font-size: 14px;
  line-height: 1.5;
  font-weight: 400;
}

.hero-banner__buttons {
  display: flex;
  gap: 12px;
  padding-block-start: 20px;
}

.hero-banner__button {
  flex: 1 1 0;
  min-width: 0;
}

.hero-banner__button--primary {
  flex-grow: 1.9;
}

.hero-banner__button a {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 52px;
  padding: 12px;
  border: 1px solid #ffffff;
  border-radius: 0;
  font-family: var(--font-body--family);
  font-size: 12px;
  line-height: 14.4px;
  letter-spacing: 1.8px;
  font-weight: 400;
  text-align: center;
  text-transform: uppercase;
  text-decoration: none;
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
}

.hero-banner__button a:focus-visible {
  outline: 2px solid #ffffff;
  outline-offset: 3px;
}

.hero-banner__button--primary a {
  background-color: #ffffff;
  color: #2a2a2a;
}

.hero-banner__button--primary a:hover {
  background-color: rgba(255, 255, 255, 0.85);
}

.hero-banner__button--secondary a {
  border-color: rgba(255, 255, 255, 0.8);
  background-color: transparent;
  color: #ffffff;
}

.hero-banner__button--secondary a:hover {
  border-color: #ffffff;
  background-color: #ffffff;
  color: #2a2a2a;
}

.hero-banner__pagination {
  position: absolute;
  inset-inline: 0;
  bottom: 5px;
  z-index: 2;
  display: flex;
  justify-content: center;
  gap: 8px;
}

.hero-banner__bullet {
  width: 24px;
  height: 14px;
  padding: 6px 0;
  border: 0;
  background-color: rgba(255, 255, 255, 0.4);
  background-clip: content-box;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.hero-banner__bullet--active {
  background-color: #ffffff;
}

.hero-banner__bullet:focus-visible {
  outline: 2px solid #ffffff;
  outline-offset: 2px;
}

@media (prefers-reduced-motion: no-preference) {
  .hero-banner__slide--active .hero-banner__content > * {
    animation: hero-banner-fade-up 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-banner__slide--active .hero-banner__content > :nth-child(2) {
    animation-delay: 0.1s;
  }

  .hero-banner__slide--active .hero-banner__content > :nth-child(3) {
    animation-delay: 0.2s;
  }

  .hero-banner__slide--active .hero-banner__content > :nth-child(4) {
    animation-delay: 0.3s;
  }
}

@keyframes hero-banner-fade-up {
  from {
    opacity: 0;
    transform: translateY(16px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (min-width: 769px) {
  .hero-banner__slide {
    height: var(--hero-height-desktop);
  }

  .hero-banner--auto .hero-banner__slide {
    min-height: 0;
    aspect-ratio: var(--hero-ratio-desktop, 16 / 9);
  }

  .hero-banner__video-toggle {
    top: auto;
    right: 56px;
    bottom: 56px;
    width: 36px;
    height: 36px;
  }

  .hero-banner__content {
    padding: 0 clamp(24px, 4.4vw, 60px) 60px;
  }

  .hero-banner__eyebrow p {
    font-size: 20px;
    line-height: 24px;
    letter-spacing: 1.6px;
  }

  .hero-banner__heading h2 {
    font-size: 52px;
    line-height: 47.32px;
    letter-spacing: -1.04px;
  }

  .hero-banner__description {
    padding-block-start: 20px;
  }

  .hero-banner__description p {
    font-size: 16px;
    line-height: 19.2px;
  }

  .hero-banner__buttons {
    gap: 20px;
  }

  .hero-banner__button {
    flex: none;
  }

  .hero-banner__button a {
    min-width: 207px;
    min-height: 48px;
    padding: 14px 32px;
  }

  .hero-banner__button--primary a {
    min-width: 257px;
  }

  .hero-banner__pagination {
    inset-inline: auto 56px;
    bottom: 24px;
  }
}
</style>

<hero-banner
  class="hero-banner hero-banner--{{ hero_height | replace: '_', '-' }}"
  data-autoplay="{{ autoplay }}"
  data-autoplay-delay="{{ autoplay_delay }}"
  data-effect="{{ transition_effect }}"
>
  <div class="hero-banner__slider">
    <div class="hero-banner__track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign image = block.settings.image
          assign mobile_image = block.settings.mobile_image
          assign eyebrow_text = block.settings.eyebrow_text
          assign heading = block.settings.heading
          assign description = block.settings.description
          assign button_1_label = block.settings.button_1_label
          assign button_1_link = block.settings.button_1_link
          assign button_2_label = block.settings.button_2_label
          assign button_2_link = block.settings.button_2_link
          assign media_type = block.settings.media_type | default: 'image'
          assign video = block.settings.video
          assign mobile_video = block.settings.mobile_video

          if image == blank
            assign image = mobile_image
          endif

          if video == blank
            assign video = mobile_video
          endif

          # Auto height follows the selected media's ratio, per breakpoint.
          assign ratio_desktop = blank
          assign ratio_mobile = blank
          if hero_height == 'auto'
            if media_type == 'video' and video != blank
              assign ratio_desktop = video.aspect_ratio
              assign ratio_mobile = mobile_video.aspect_ratio | default: video.aspect_ratio
            elsif media_type != 'video' and image != blank
              assign ratio_desktop = image.aspect_ratio
              assign ratio_mobile = mobile_image.aspect_ratio | default: image.aspect_ratio
            endif
          endif

          assign image_alt = image.alt | default: heading | escape

          if forloop.first and section.index <= 2
            assign loading = 'eager'
            assign priority = 'high'
          else
            assign loading = 'lazy'
            assign priority = 'auto'
          endif
        -%}
        <div
          class="hero-banner__slide{% if forloop.first %} hero-banner__slide--active{% endif %}"
          data-index="{{ forloop.index0 }}"
          {% if ratio_desktop != blank %}
            style="--hero-ratio-desktop: {{ ratio_desktop }}; --hero-ratio-mobile: {{ ratio_mobile }};"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="hero-banner__media">
            {%- if media_type == 'video' -%}
              {%- if video != blank -%}
                {%- liquid
                  if forloop.first and section.index <= 2
                    assign video_preload = 'metadata'
                  else
                    assign video_preload = 'none'
                  endif

                  if mobile_video != blank and mobile_video != video
                    assign video_class = 'hero-banner__video hero-banner__video--desktop'
                  else
                    assign video_class = 'hero-banner__video'
                  endif
                -%}
                {%- capture video_markup -%}
                  {{
                    video
                    | video_tag:
                      image_size: '1920x',
                      class: video_class,
                      muted: true,
                      loop: true,
                      playsinline: true,
                      controls: false,
                      preload: video_preload
                  }}
                  {%- if mobile_video != blank and mobile_video != video -%}
                    {{
                      mobile_video
                      | video_tag:
                        image_size: '1100x',
                        class: 'hero-banner__video hero-banner__video--mobile',
                        muted: true,
                        loop: true,
                        playsinline: true,
                        controls: false,
                        preload: video_preload
                    }}
                  {%- endif -%}
                {%- endcapture -%}
                {%- comment -%}
                  Background video: decorative, muted, and played by the component. Posters download as soon as they
                  are in the markup, so slides that start hidden keep theirs in data-poster until they become active.
                {%- endcomment -%}
                <div class="hero-banner__video-wrapper" aria-hidden="true">
                  {%- if video_preload == 'none' -%}
                    {{ video_markup | replace: ' poster="', ' data-poster="' }}
                  {%- else -%}
                    {{ video_markup }}
                  {%- endif -%}
                </div>
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag }}
              {%- endif -%}
            {%- elsif image != blank -%}
              {%- if mobile_image != blank and mobile_image != image -%}
                {%- comment -%}
                  Separate desktop and mobile images: each renders at its own breakpoint. The hidden one declares a
                  1px slot there, so the browser fetches only its smallest size instead of a full-width file.
                {%- endcomment -%}
                {{
                  image
                  | image_url: width: 3840
                  | image_tag:
                    widths: '375, 550, 750, 1100, 1500, 1920, 2560, 3840',
                    sizes: '(max-width: 768px) 1px, 100vw',
                    loading: loading,
                    fetchpriority: priority,
                    alt: image_alt,
                    class: 'hero-banner__image hero-banner__image--desktop'
                }}
                {{
                  mobile_image
                  | image_url: width: 1500
                  | image_tag:
                    widths: '375, 550, 750, 1100, 1500',
                    sizes: '(min-width: 769px) 1px, 100vw',
                    loading: loading,
                    fetchpriority: priority,
                    alt: image_alt,
                    class: 'hero-banner__image hero-banner__image--mobile'
                }}
              {%- else -%}
                {{
                  image
                  | image_url: width: 3840
                  | image_tag:
                    widths: '375, 550, 750, 1100, 1500, 1920, 2560, 3840',
                    sizes: '100vw',
                    loading: loading,
                    fetchpriority: priority,
                    alt: image_alt,
                    class: 'hero-banner__image'
                }}
              {%- endif -%}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag }}
            {%- endif -%}
          </div>

          <div class="hero-banner__content">
            {%- if eyebrow_text != blank -%}
              <div class="hero-banner__eyebrow">
                <p>{{ eyebrow_text | escape }}</p>
              </div>
            {%- endif -%}

            {%- if heading != blank -%}
              <div class="hero-banner__heading">
                <h2>{{ heading | escape }}</h2>
              </div>
            {%- endif -%}

            {%- if description != blank -%}
              <div class="hero-banner__description">
                {{ description }}
              </div>
            {%- endif -%}

            {%- if button_1_label != blank or button_2_label != blank -%}
              <div class="hero-banner__buttons">
                {%- if button_1_label != blank -%}
                  <div class="hero-banner__button hero-banner__button--primary">
                    <a
                      {% if button_1_link != blank %}
                        href="{{ button_1_link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                    >
                      {{- button_1_label | escape -}}
                    </a>
                  </div>
                {%- endif -%}
                {%- if button_2_label != blank -%}
                  <div class="hero-banner__button hero-banner__button--secondary">
                    <a
                      {% if button_2_link != blank %}
                        href="{{ button_2_link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                    >
                      {{- button_2_label | escape -}}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if media_type == 'video' and video != blank -%}
            <button
              type="button"
              class="hero-banner__video-toggle"
              aria-label="Pause background video"
              data-label-pause="Pause background video"
              data-label-play="Play background video"
            >
              <svg class="hero-banner__icon-pause" aria-hidden="true" focusable="false" viewBox="0 0 12 12">
                <path d="M3 1.5v9M9 1.5v9" stroke="currentColor" stroke-width="1.6"/>
              </svg>
              <svg class="hero-banner__icon-play" aria-hidden="true" focusable="false" viewBox="0 0 12 12">
                <path d="M3 1.5v9l7.5-4.5z" fill="currentColor"/>
              </svg>
            </button>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if slide_count > 1 -%}
    <div class="hero-banner__pagination"></div>
  {%- endif -%}
</hero-banner>

<script>
  (() => {
    if (customElements.get('hero-banner')) return;

    // Swiper loads once, globally, from layout/theme.liquid; wait for it if it's still loading.
    const loadSwiper = () =>
      new Promise((resolve, reject) => {
        if (window.Swiper) return resolve();

        const script = document.querySelector('script[src*="swiper-bundle"]');
        if (!script) return reject(new Error('Swiper script not found'));

        script.addEventListener('load', resolve, { once: true });
        script.addEventListener('error', reject, { once: true });
      });

    class HeroBanner extends HTMLElement {
      connectedCallback() {
        this.abortController = new AbortController();
        const { signal } = this.abortController;

        // Background videos play only on the active slide, at the matching breakpoint,
        // and stay paused for reduced motion until the visitor presses play.
        this.mobileQuery = window.matchMedia('(max-width: 768px)');
        this.videosPaused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.mobileQuery.addEventListener('change', () => this.syncVideos(), { signal });
        this.addEventListener('click', this.onVideoToggle, { signal });
        this.syncVideos();

        if (this.querySelectorAll('.hero-banner__slide').length < 2) return;

        this.addEventListener('shopify:block:select', this.onBlockSelect, { signal });
        this.addEventListener('shopify:block:deselect', this.onBlockDeselect, { signal });

        loadSwiper()
          .then(() => this.init())
          .catch(() => {});
      }

      disconnectedCallback() {
        this.abortController?.abort();

        for (const video of this.querySelectorAll('video')) {
          video.pause();
        }

        if (this.swiper) {
          this.swiper.destroy(true, true);
          this.swiper = null;
        }
      }

      init() {
        if (!this.isConnected || this.swiper) return;

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.autoplayEnabled = this.dataset.autoplay === 'true' && !reducedMotion;

        this.swiper = new Swiper(this.querySelector('.hero-banner__slider'), {
          wrapperClass: 'hero-banner__track',
          slideClass: 'hero-banner__slide',
          slideActiveClass: 'hero-banner__slide--active',
          effect: this.dataset.effect,
          fadeEffect: { crossFade: true },
          speed: reducedMotion ? 0 : 800,
          rewind: true,
          autoplay: this.autoplayEnabled
            ? {
                delay: Number(this.dataset.autoplayDelay) * 1000,
                disableOnInteraction: false,
                pauseOnMouseEnter: true
              }
            : false,
          pagination: {
            el: this.querySelector('.hero-banner__pagination'),
            clickable: true,
            bulletElement: 'button',
            bulletClass: 'hero-banner__bullet',
            bulletActiveClass: 'hero-banner__bullet--active'
          },
          a11y: {
            containerRoleDescriptionMessage: 'carousel',
            slideRole: 'group'
          },
          on: {
            init: (swiper) => {
              this.updateInert(swiper);
              this.syncVideos();
            },
            slideChange: (swiper) => {
              this.updateInert(swiper);
              this.syncVideos();
            }
          }
        });
      }

      syncVideos() {
        const slides = [...this.querySelectorAll('.hero-banner__slide')];
        const hiddenClass = this.mobileQuery.matches ? 'hero-banner__video--desktop' : 'hero-banner__video--mobile';
        const activeIndex = this.swiper ? this.swiper.activeIndex : slides.findIndex((slide) => slide.classList.contains('hero-banner__slide--active'));

        slides.forEach((slide, index) => {
          const isActive = slides.length < 2 || index === activeIndex;

          for (const video of slide.querySelectorAll('video')) {
            if (isActive && !this.videosPaused && !video.classList.contains(hiddenClass)) {
              video.muted = true;
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        });

        this.toggleAttribute('data-videos-paused', this.videosPaused);

        for (const button of this.querySelectorAll('.hero-banner__video-toggle')) {
          button.setAttribute('aria-label', this.videosPaused ? button.dataset.labelPlay : button.dataset.labelPause);
        }
      }

      onVideoToggle = (event) => {
        if (!(event.target instanceof Element) || !event.target.closest('.hero-banner__video-toggle')) return;

        this.videosPaused = !this.videosPaused;
        this.syncVideos();
      };

      updateInert(swiper) {
        swiper.slides.forEach((slide, index) => {
          slide.inert = index !== swiper.activeIndex;
        });
      }

      onBlockSelect = (event) => {
        if (!this.swiper) return;
        this.swiper.slideTo(Number(event.target.dataset.index));
        this.swiper.autoplay.stop();
      };

      onBlockDeselect = () => {
        if (this.swiper && this.autoplayEnabled) this.swiper.autoplay.start();
      };
    }

    customElements.define('hero-banner', HeroBanner);
  })();
</script>

