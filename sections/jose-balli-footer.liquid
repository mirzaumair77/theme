{%- liquid
  assign newsletter_heading = section.settings.newsletter_heading
  assign newsletter_text = section.settings.newsletter_text
  assign button_label = section.settings.button_label
  assign logo = section.settings.logo
  assign logo_width = section.settings.logo_width
  assign copyright = section.settings.copyright
  assign legal_menu = section.settings.legal_menu
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign mobile_padding_top = section.settings.mobile_padding_top
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom
  assign current_year = 'now' | date: '%Y'
  assign logo_alt = logo.alt | default: shop.name | escape

  if button_label == blank
    assign button_label = 'actions.sign_up' | t
  endif

  if copyright == blank
    assign copyright = '© ' | append: current_year | append: ' ' | append: shop.name
  endif
-%}

<style>
#shopify-section-{{ section.id }} {
  --jbf-padding-top: {{ mobile_padding_top }}px;
  --jbf-padding-bottom: {{ mobile_padding_bottom }}px;
  --jbf-logo-width: {{ logo_width }}px;
}

@media (min-width: 769px) {
  #shopify-section-{{ section.id }} {
    --jbf-padding-top: {{ padding_top }}px;
    --jbf-padding-bottom: {{ padding_bottom }}px;
  }
}

.jose-balli-footer {
  background-color: #ffffff;
  color: #2a2a2a;
  font-family: var(--font-body--family);
}

.jose-balli-footer p,
.jose-balli-footer h2,
.jose-balli-footer h3 {
  margin: 0;
}

.jose-balli-footer ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.jose-balli-footer a {
  color: inherit;
  text-decoration: none;
}

.jose-balli-footer a:focus-visible,
.jose-balli-footer button:focus-visible,
.jose-balli-footer summary:focus-visible {
  outline: 2px solid #2a2a2a;
  outline-offset: 2px;
}

/* Newsletter band */
.jose-balli-footer__newsletter {
  padding: 40px 16px;
  background-color: #F7F5F0;
  text-align: center;
}

.jose-balli-footer__newsletter-inner {
  display: grid;
  gap: 24px;
  max-width: 960px;
  margin: 0 auto;
}

.jose-balli-footer__heading h2 {
  font-family: var(--font-heading--family);
  color: #2A2A2A;
  font-size: 24px;
  line-height: 33.6px;
  letter-spacing: -0.48px;
  font-weight: 400;
}

.jose-balli-footer__heading em {
  font-style: italic;
}

.jose-balli-footer__text {
  padding-block-start: 8px;
}

.jose-balli-footer__text p {
  color: #2A2A2A;
  font-size: 14px;
  line-height: 16.8px;
  font-weight: 400;
}

.jose-balli-footer__input-group {
  display: flex;
}

.jose-balli-footer__input {
  flex: 1;
  width: 100%;
  min-width: 0;
  height: 46px;
  padding: 0 14px;
  border: 1px solid #ebe7e1;
  border-inline-end: 0;
  border-radius: 0;
  background-color: #ffffff;
  font-family: inherit;
  color: #2A2A2A;
  font-size: 12px;
  line-height: 16.8px;
  font-weight: 400;
  text-align: start;
  transition: border-color 0.3s ease;
}

.jose-balli-footer__input::placeholder {
  color: #2A2A2A;
  opacity: 1;
}

.jose-balli-footer__input:focus {
  border-color: #2A2A2A;
}

.jose-balli-footer__input:focus-visible {
  outline: none;
}

.jose-balli-footer__input[aria-invalid='true'] {
  border-color: #c4302b;
}

.jose-balli-footer__button {
  flex: none;
  width: 108px;
  height: 40px;
  padding: 0 12px;
  border: 0;
  border-radius: 0;
  background-color: #efeae1;
  font-family: inherit;
  color: #2A2A2A;
  font-size: 12px;
  line-height: 14.4px;
  letter-spacing: 0.72px;
  font-weight: 400;
  text-transform: uppercase;
  white-space: nowrap;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.jose-balli-footer__button:hover {
  background-color: #e2dbd1;
}

.jose-balli-footer__message {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 12px;
  font-size: 13px;
  line-height: 1.4;
}

.jose-balli-footer__message svg {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

/* Links and logo */
.jose-balli-footer__main {
  display: flex;
  flex-direction: column;
  padding: var(--jbf-padding-top) 20px var(--jbf-padding-bottom);
}

.jose-balli-footer__menu + .jose-balli-footer__menu {
  border-top: 1px solid #D6D0C6;
}

.jose-balli-footer__menu-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22.5px 0;
  cursor: pointer;
  list-style: none;
}

.jose-balli-footer__menu-heading::-webkit-details-marker {
  display: none;
}

.jose-balli-footer__menu-heading h3 {
  font-family: inherit;
  color: #2A2A2A;
  font-size: 14px;
  line-height: 16.8px;
  letter-spacing: 1.12px;
  font-weight: 500;
  text-transform: uppercase;
}

/* Plus icon; the vertical bar collapses into a minus when open */
.jose-balli-footer__menu-icon {
  position: relative;
  flex: none;
  width: 11.25px;
  height: 11.25px;
}

.jose-balli-footer__menu-icon::before,
.jose-balli-footer__menu-icon::after {
  content: '';
  position: absolute;
  inset: 50% 0 auto;
  height: 1px;
  background-color: #2a2a2a;
  transition: transform 0.3s ease;
}

.jose-balli-footer__menu-icon::after {
  transform: rotate(90deg);
}

.jose-balli-footer__menu[open] .jose-balli-footer__menu-icon::after {
  transform: rotate(0deg);
}

.jose-balli-footer__menu-list {
  display: grid;
  gap: 8px;
  padding-block-end: 22.5px !important;
  color: #2A2A2A;
  font-size: 13px;
  line-height: 19.688px;
  font-weight: 400;
}

.jose-balli-footer__menu-list a {
  transition: opacity 0.3s ease;
}

.jose-balli-footer__menu-list a:hover {
  opacity: 0.6;
}

.jose-balli-footer__logo {
  align-self: center;
  width: calc(var(--jbf-logo-width) * 1.17);
  max-width: 77.6%;
  margin-top: 40px;
}

.jose-balli-footer__menus:empty + .jose-balli-footer__logo {
  margin-top: 0;
}

.jose-balli-footer__logo img {
  display: block;
  width: 100%;
  height: auto;
}

.jose-balli-footer__logo p {
  font-family: var(--font-heading--family);
  font-size: 26px;
  line-height: 1.1;
  text-align: center;
}

/* Bottom bar */
.jose-balli-footer__bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 10px 40px;
  padding: 20px 16px;
  background-color: #F7F5F0;
  color: #2A2A2A;
  font-size: 12px;
  line-height: 16.8px;
  font-weight: 300;
}

.jose-balli-footer__legal {
  display: none;
}

.jose-balli-footer__legal ul {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 30px;
}

.jose-balli-footer__legal a:hover {
  opacity: 0.6;
}

@media (min-width: 769px) {
  .jose-balli-footer__newsletter {
    padding: 40px clamp(24px, 4.4vw, 60px);
    text-align: start;
  }

  .jose-balli-footer__newsletter-inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 559px);
    align-items: center;
    gap: 40px;
  }

  .jose-balli-footer__heading h2 {
    font-size: 40px;
    line-height: 48px;
    letter-spacing: -0.8px;
  }

  .jose-balli-footer__text {
    padding-block-start: 15px;
  }

  .jose-balli-footer__input,
  .jose-balli-footer__button {
    height: 58px;
  }

  .jose-balli-footer__input {
    padding: 0 24px;
    font-size: 14px;
    line-height: 16.8px;
  }

  .jose-balli-footer__button {
    min-width: 200px;
    font-size: 14px;
    line-height: 16.8px;
    letter-spacing: 1.12px;
  }

  .jose-balli-footer__message {
    justify-content: flex-start;
  }

  .jose-balli-footer__main {
    display: grid;
    grid-template-columns: minmax(0, 1.62fr) minmax(0, 4fr);
    align-items: center;
    padding-inline: 56px;
  }

  .jose-balli-footer__menus {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-column: 2;
    grid-row: 1;
    align-self: start;
    column-gap: 24px;
  }

  .jose-balli-footer__menu + .jose-balli-footer__menu {
    border-top: 0;
  }

  .jose-balli-footer__menu-heading {
    padding: 0 0 16px;
    cursor: default;
    pointer-events: none;
  }

  .jose-balli-footer__menu-heading h3 {
    font-size: 16px;
    line-height: 19.2px;
  }

  .jose-balli-footer__menu-icon {
    display: none;
  }

  .jose-balli-footer__menu-list {
    gap: 10px;
    padding-block-end: 0;
    font-size: 14px;
    line-height: 16.8px;
  }

  .jose-balli-footer__logo,
  .jose-balli-footer__menus:empty + .jose-balli-footer__logo {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    width: var(--jbf-logo-width);
    max-width: calc(100% - 48px);
    margin: 0 0 0 24px;
  }

  .jose-balli-footer__bottom {
    justify-content: space-between;
    padding: 20px clamp(24px, 4.4vw, 60px);
  }

  .jose-balli-footer__legal {
    display: block;
  }
}
</style>

<div class="jose-balli-footer">
  <div class="jose-balli-footer__newsletter">
    <div class="jose-balli-footer__newsletter-inner">
      <div class="jose-balli-footer__intro">
        {%- if newsletter_heading != blank -%}
          <div class="jose-balli-footer__heading">
            <h2>{{ newsletter_heading }}</h2>
          </div>
        {%- endif -%}
        {%- if newsletter_text != blank -%}
          <div class="jose-balli-footer__text">
            <p>{{ newsletter_text | escape }}</p>
          </div>
        {%- endif -%}
      </div>

      <div class="jose-balli-footer__signup">
        {%- form 'customer', class: 'jose-balli-footer__form' -%}
          <div class="jose-balli-footer__input-group">
            <label for="EmailInput-{{ section.id }}" class="visually-hidden">
              {{- 'blocks.email_signup.label' | t -}}
            </label>
            <input
              id="EmailInput-{{ section.id }}"
              class="jose-balli-footer__input"
              type="email"
              name="contact[email]"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
              required
              {% if form.errors and form.id == blank %}
                autofocus
                aria-invalid="true"
                aria-describedby="Email-signup__message-error-{{ section.id }}"
              {% elsif form.posted_successfully? and form.id == blank %}
                aria-describedby="Email-signup__message-success-{{ section.id }}"
              {% endif %}
            >
            <button class="jose-balli-footer__button">
              {{- button_label | escape -}}
            </button>
          </div>

          {%- if form.errors and form.id == blank -%}
            <div
              id="Email-signup__message-error-{{ section.id }}"
              class="jose-balli-footer__message"
              tabindex="-1"
            >
              <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                {%- render 'icon', icon: 'error' -%}
              </svg>
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? and form.id == blank -%}
            <div
              id="Email-signup__message-success-{{ section.id }}"
              class="jose-balli-footer__message"
              tabindex="-1"
            >
              {{ 'icon-checkmark.svg' | inline_asset_content }}
              <p>{{ 'blocks.email_signup.success' | t }}</p>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>

  <div class="jose-balli-footer__main">
    <div class="jose-balli-footer__menus">
      {%- for block in section.blocks -%}
        {%- liquid
          assign menu_heading = block.settings.heading
          assign menu = block.settings.menu
          assign instagram_link = block.settings.instagram_link
          assign facebook_link = block.settings.facebook_link
          assign tiktok_link = block.settings.tiktok_link
        -%}
        {%- comment -%}
          Rendered open so the links stay reachable without JavaScript; the script below
          collapses them into an accordion on mobile and keeps them open on desktop.
        {%- endcomment -%}
        <details class="jose-balli-footer__menu" open {{ block.shopify_attributes }}>
          <summary class="jose-balli-footer__menu-heading">
            <h3>{{ menu_heading | default: menu.title | escape }}</h3>
            <span class="jose-balli-footer__menu-icon" aria-hidden="true"></span>
          </summary>

          <ul class="jose-balli-footer__menu-list">
            {%- for link in menu.links -%}
              <li>
                <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
            {%- if instagram_link != blank -%}
              <li><a href="{{ instagram_link }}" target="_blank" rel="noopener">Instagram</a></li>
            {%- endif -%}
            {%- if facebook_link != blank -%}
              <li><a href="{{ facebook_link }}" target="_blank" rel="noopener">Facebook</a></li>
            {%- endif -%}
            {%- if tiktok_link != blank -%}
              <li><a href="{{ tiktok_link }}" target="_blank" rel="noopener">TikTok</a></li>
            {%- endif -%}
          </ul>
        </details>
      {%- endfor -%}
    </div>

    <div class="jose-balli-footer__logo">
      {%- if logo != blank -%}
        {{
          logo
          | image_url: width: 600
          | image_tag:
            widths: '150, 225, 300, 450, 600',
            sizes: '(min-width: 769px) 300px, 70vw',
            loading: 'lazy',
            alt: logo_alt
        }}
      {%- else -%}
        <p>{{ shop.name | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="jose-balli-footer__bottom">
    {%- if legal_menu.links.size > 0 -%}
      <nav class="jose-balli-footer__legal" aria-label="{{ legal_menu.title | escape }}">
        <ul>
          {%- for link in legal_menu.links -%}
            <li>
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="jose-balli-footer__copyright">
      <p>{{ copyright | escape }}</p>
    </div>
  </div>
</div>

<script>
  (() => {
    const footer = document.currentScript?.previousElementSibling;
    if (!footer) return;

    // Menus are accordions on mobile and always-open columns on desktop.
    const desktop = window.matchMedia('(min-width: 769px)');

    const sync = () => {
      // The theme editor replaces the section on re-render; drop the stale listener.
      if (!footer.isConnected) {
        desktop.removeEventListener('change', sync);
        return;
      }

      for (const menu of footer.querySelectorAll('.jose-balli-footer__menu')) {
        menu.open = desktop.matches;
        const summary = menu.querySelector('summary');
        if (desktop.matches) {
          summary?.setAttribute('tabindex', '-1');
        } else {
          summary?.removeAttribute('tabindex');
        }
      }
    };

    footer.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (desktop.matches && event.target.closest('.jose-balli-footer__menu-heading')) event.preventDefault();
    });

    desktop.addEventListener('change', sync);
    sync();
  })();
</script>

{% schema %}
{
  "name": "Jose Balli footer",
  "tag": "div",
  "class": "section-jose-balli-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "paragraph",
      "content": "Sign-ups create customer profiles with email marketing consent, using the theme's native newsletter form."
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Enjoy 10% off"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Text",
      "default": "on your first order"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Next step"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Use a dark logo on a transparent background."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "info": "Shown slightly larger on mobile.",
      "min": 60,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 190
    },
    {
      "type": "header",
      "content": "Bottom"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "info": "Leave empty to show © current year and store name."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu",
      "info": "Shown on desktop."
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "paragraph",
      "content": "Spacing around the menus and logo."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave empty to use the menu's title.",
          "default": "Help"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "header",
          "content": "Social links"
        },
        {
          "type": "paragraph",
          "content": "Listed after the menu links."
        },
        {
          "type": "url",
          "id": "instagram_link",
          "label": "Instagram"
        },
        {
          "type": "url",
          "id": "facebook_link",
          "label": "Facebook"
        },
        {
          "type": "url",
          "id": "tiktok_link",
          "label": "TikTok"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Jose Balli footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "Services" } },
        { "type": "menu", "settings": { "heading": "About" } },
        { "type": "menu", "settings": { "heading": "Social" } }
      ]
    }
  ]
}
{% endschema %}
