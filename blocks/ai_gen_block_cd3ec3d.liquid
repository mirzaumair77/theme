<div class="jbps-compare-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="jbps-compare-{{ ai_gen_id }}__head"><h2 class="jbps-compare-{{ ai_gen_id }}__title">{{ block.settings.title }}</h2><p class="jbps-compare-{{ ai_gen_id }}__lede">{{ block.settings.lede }}</p></div><div class="jbps-compare-{{ ai_gen_id }}__table" role="table" aria-label="{{ block.settings.title | escape }}"><div class="jbps-compare-{{ ai_gen_id }}__row jbps-compare-{{ ai_gen_id }}__row--header" role="row"><div class="jbps-compare-{{ ai_gen_id }}__cell jbps-compare-{{ ai_gen_id }}__cell--label" role="columnheader"></div><div class="jbps-compare-{{ ai_gen_id }}__cell jbps-compare-{{ ai_gen_id }}__cell--them" role="columnheader">{{ block.settings.traditional_label }}</div><div class="jbps-compare-{{ ai_gen_id }}__cell jbps-compare-{{ ai_gen_id }}__cell--us" role="columnheader">{{ clean_title }}</div></div>{% for i in (1..5) %}{% assign label_key = 'row_' | append: i | append: '_label' %}{% assign old_key = 'row_' | append: i | append: '_old' %}{% assign new_key = 'row_' | append: i | append: '_new' %}<div class="jbps-compare-{{ ai_gen_id }}__row" role="row"><div class="jbps-compare-{{ ai_gen_id }}__cell jbps-compare-{{ ai_gen_id }}__cell--label" role="rowheader">{{ block.settings[label_key] }}</div><div class="jbps-compare-{{ ai_gen_id }}__cell jbps-compare-{{ ai_gen_id }}__cell--them" role="cell"><span class="jbps-compare-{{ ai_gen_id }}__mark jbps-compare-{{ ai_gen_id }}__mark--no" aria-hidden="true">&times;</span>{{ block.settings[old_key] }}</div><div class="jbps-compare-{{ ai_gen_id }}__cell jbps-compare-{{ ai_gen_id }}__cell--us" role="cell"><span class="jbps-compare-{{ ai_gen_id }}__mark jbps-compare-{{ ai_gen_id }}__mark--yes" aria-hidden="true">&#10003;</span>{{ block.settings[new_key] }}</div></div>{% endfor %}</div><p class="jbps-compare-{{ ai_gen_id }}__foot">{{ block.settings.foot }}</p></div>
