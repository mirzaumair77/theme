{% doc %}
  @prompt
    I want a shop by category carousel block, I want the layout to mimic this sites https://www.monicavinader.com/us/. The transparent with the line and white lettering.,  Make the text alignment to the bottom left with the white line above the collection name., I want the white bar almost completely filling the image. and remove the item count number, I want the navigation arrows above the images in the top right corner as simple minimalist arrows, remove the dots at the bottom with a button in the bottom left that says "shop all" that goes to all jewelry page. I want the carousel to be full width and 6 categories total., I want a gap between each card, I want the carousel to fill the screen. Especially on fullscreen view. Let me adjust the width and height of the cards as well as the gap between., I want to be able to adjust the width of the cards and the text color., I want a thin box around the navigation arrows and a title text box
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-category-carousel__header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding: 0 20px;
  }

  .ai-category-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 400;
  }

  .ai-category-carousel__nav-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
    border: {{ block.settings.nav_border_width }}px solid {{ block.settings.nav_border_color }};
    padding: 4px;
  }

  .ai-category-carousel__arrow-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.text_color }};
    transition: opacity 0.3s ease;
  }

  .ai-category-carousel__arrow-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-category-carousel__arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-category-carousel__arrow-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    stroke-width: 1.5;
  }

  .ai-category-carousel__shop-all-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: 14px;
    cursor: pointer;
    padding: 8px 16px;
    transition: opacity 0.3s ease;
  }

  .ai-category-carousel__shop-all-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-category-carousel__track-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    width: 100%;
  }

  .ai-category-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-category-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.card_gap }}px * 5)) / 6);
    min-width: {{ block.settings.card_width }}px;
    height: {{ block.settings.card_height }}px;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    display: block;
  }

  .ai-category-carousel__card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-category-carousel__card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-carousel__card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-category-carousel__card-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.4) 0%, transparent 100%);
  }

  .ai-category-carousel__card-line-{{ ai_gen_id }} {
    width: {{ block.settings.line_width }}%;
    height: 1px;
    background-color: {{ block.settings.text_color }};
    margin-bottom: 12px;
  }

  .ai-category-carousel__card-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 18px;
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  @media screen and (max-width: 1200px) {
    .ai-category-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.card_gap }}px * 3)) / 4);
    }
  }

  @media screen and (max-width: 990px) {
    .ai-category-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.card_gap }}px * 2)) / 3);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-category-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.card_gap }}px) / 2);
    }

    .ai-category-carousel__header-{{ ai_gen_id }} {
      padding: 0 10px;
    }
  }
{% endstyle %}

<category-carousel-{{ ai_gen_id }} class="ai-category-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-carousel__header-{{ ai_gen_id }}">
    <a href="{{ block.settings.shop_all_link }}" class="ai-category-carousel__shop-all-{{ ai_gen_id }}">
      {{ block.settings.shop_all_text }}
    </a>
    <div style="display: flex; align-items: center; gap: 20px;">
      {% if block.settings.title != blank %}
        <h2 class="ai-category-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      <div class="ai-category-carousel__nav-{{ ai_gen_id }}">
        <button class="ai-category-carousel__arrow-{{ ai_gen_id }} ai-category-carousel__prev-{{ ai_gen_id }}" aria-label="Previous">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button class="ai-category-carousel__arrow-{{ ai_gen_id }} ai-category-carousel__next-{{ ai_gen_id }}" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="ai-category-carousel__track-wrapper-{{ ai_gen_id }}">
    <div class="ai-category-carousel__track-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}
        
        <a 
          href="{% if collection %}{{ collection.url }}{% else %}#{% endif %}" 
          class="ai-category-carousel__card-{{ ai_gen_id }}"
        >
          {% if collection and collection.featured_image %}
            <img
              src="{{ collection.featured_image | image_url: width: 800 }}"
              alt="{{ collection.featured_image.alt | escape }}"
              loading="lazy"
              width="800"
              height="{{ block.settings.card_height }}"
              class="ai-category-carousel__card-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-category-carousel__card-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          
          <div class="ai-category-carousel__card-overlay-{{ ai_gen_id }}">
            <div class="ai-category-carousel__card-line-{{ ai_gen_id }}"></div>
            <h3 class="ai-category-carousel__card-title-{{ ai_gen_id }}">
              {% if collection %}
                {{ collection.title }}
              {% else %}
                Category {{ i }}
              {% endif %}
            </h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</category-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.track = this.querySelector('.ai-category-carousel__track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-category-carousel__prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-category-carousel__next-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-category-carousel__card-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupEventListeners();
        this.updateButtons();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.slide(-1));
        this.nextButton.addEventListener('click', () => this.slide(1));
      }

      slide(direction) {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const slideAmount = cardWidth + gap;
        
        this.currentIndex += direction;
        
        const maxIndex = this.cards.length - this.getVisibleCards();
        if (this.currentIndex < 0) {
          this.currentIndex = 0;
        } else if (this.currentIndex > maxIndex) {
          this.currentIndex = maxIndex;
        }
        
        const translateX = -(this.currentIndex * slideAmount);
        this.track.style.transform = `translateX(${translateX}px)`;
        
        this.updateButtons();
      }

      getVisibleCards() {
        const width = window.innerWidth;
        if (width <= 749) return 2;
        if (width <= 990) return 3;
        if (width <= 1200) return 4;
        return 6;
      }

      updateButtons() {
        const maxIndex = this.cards.length - this.getVisibleCards();
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
      }
    }

    customElements.define('category-carousel-{{ ai_gen_id }}', CategoryCarousel{{ ai_gen_id }});
  })();
</script>

