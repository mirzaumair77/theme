{% doc %}
  @prompt
    <style>
      #shopify-section-{{ section.id }} {
        background-color: {{ section.settings.background_color }};
        {% if section.settings.background_image != blank %}
          background:
                  linear-gradient(0deg, rgba(240, 231, 209, 0.40) 0%, rgba(240, 231, 209, 0.40) 100%),
                  url({{ section.settings.background_image | img_url: 'master' }});
          background-size: 150%;
          background-position: left;
        {% endif %}
      }
    </style>
    
    <article class="jb-newsletter__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'Heading' %}
            {% assign tag = block.settings.tag | default: 'h2' %}
            {% assign space = block.settings.margin_bottom | default: '0' %}
            {% if tag == 'h1' or tag == 'h2' or tag == 'h3' or tag == 'h4' or tag == 'h5' or tag == 'h6' %}
              <{{ tag }} class="jb-newsletter__heading" style="margin-bottom: {{ space }};">
                {{ block.settings.text }}
              </{{ tag }}>
            {% else %}
              <p class="jb-newsletter__text" style="margin-bottom: {{ space }};">
                {{ block.settings.text }}
              </p>
            {% endif %}
          {% when 'Form' %}
            <form
              id="jb-shopify-section-{{ section.id }}-newsletter-form"
              method="post"
              accept-charset="UTF-8"
              class="jb-newsletter__form"
              data-kl-site="{{ block.settings.klaviyo_site_id }}"
              data-kl-list="{{ block.settings.klaviyo_list_id }}"
            >
              <input
                type="email"
                name="jbnewsletterform"
                placeholder="{{ block.settings.placeholder }}"
                required
                class="jb-newsletter__input"
              >
              <button type="submit" class="jb-newsletter__button">
                {{ block.settings.button_text }}
                {% if block.settings.show_icon %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="9" viewBox="0 0 20 9" fill="none">
                    <path d="M19.8536 4.85355C20.0488 4.65829 20.0488 4.34171 19.8536 4.14645L16.6716 0.964466C16.4763 0.769204 16.1597 0.769204 15.9645 0.964466C15.7692 1.15973 15.7692 1.47631 15.9645 1.67157L18.7929 4.5L15.9645 7.32843C15.7692 7.52369 15.7692 7.84027 15.9645 8.03553C16.1597 8.2308 16.4763 8.2308 16.6716 8.03553L19.8536 4.85355ZM0.5 4C0.223858 4 0 4.22386 0 4.5C0 4.77614 0.223858 5 0.5 5V4.5V4ZM19.5 4.5V4L0.5 4V4.5V5L19.5 5V4.5Z" fill="black"/>
                  </svg>
                {% endif %}
              </button>
            </form>
            <script>
              (function () {
                const form = document.getElementById('{{ "jb-shopify-section-" | append: section.id | append: "-newsletter-form" }}');
                if (!form) return;
                console.log("Form script loaded for section {{ section.id }}");
    
                form.addEventListener('submit', async (e) => {
                  e.preventDefault();
    
                  const email = form.querySelector('input[type="email"]')?.value.trim();
                  const siteId = form.dataset.klSite;
                  const listId = form.dataset.klList;
    
                  console.log("Submitting email:", email, "to site:", siteId, "list:", listId);
    
                  if (!email || !siteId || !listId) return;
    
                  const payload = {
                    data: {
                      type: 'subscription',
                      attributes: {
                        profile: {
                          data: {
                            type: 'profile',
                            attributes: { email }
                          }
                        }
                      },
                      relationships: { list: { data: { type: 'list', id: listId } } }
                    }
                  };
    
                  try {
                    const res = await fetch(`https://a.klaviyo.com/client/subscriptions/?company_id=${encodeURIComponent(siteId)}`, {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/json',
                        'revision': '2025-07-15'
                      },
                      body: JSON.stringify(payload)
                    });
    
                    if (res.ok) {
                      form.reset();
                      form.querySelector('button')?.classList.add('is-success');
                    } else {
                      form.querySelector('button')?.classList.add('is-error');
                    }
                  } catch (err) {
                    form.querySelector('button')?.classList.add('is-error');
                  }
                });
              })();
            </script>
          {% when '@app' %}
            <!-- App block placeholder -->
            {% render block %}
          {% when 'custom_liquid' %}
            {{ block.settings.custom_liquid }}
        {% endcase %}
      {% endfor %}
    </article>
    
