{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .jb-occasions-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1100px;
    margin-inline: auto;
    color: {{ block.settings.text_color }};
  }

  .jb-occasions-{{ ai_gen_id }}__head {
    margin-bottom: 40px;
    text-align: center;
  }

  .jb-occasions-{{ ai_gen_id }}__title {
    margin: 0 0 12px;
    color: {{ block.settings.heading_color }};
    font-family: var(--font-heading--family, serif);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 400;
    line-height: 1.15;
  }

  .jb-occasions-{{ ai_gen_id }}__lede {
    max-width: 560px;
    margin: 0 auto;
    color: {{ block.settings.muted_color }};
    font-family: var(--font-body--family, sans-serif);
    font-size: 16px;
    line-height: 1.55;
  }

  .jb-occasions-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .jb-occasions-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid {{ block.settings.border_color }};
    background: {{ block.settings.card_background }};
    text-align: center;
  }

  .jb-occasions-{{ ai_gen_id }}__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: {{ block.settings.placeholder_color }};
  }

  .jb-occasions-{{ ai_gen_id }}__media img,
  .jb-occasions-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .jb-occasions-{{ ai_gen_id }}__media svg { padding: 28%; color: {{ block.settings.muted_color }}; }

  .jb-occasions-{{ ai_gen_id }}__content { padding: 28px 22px 30px; }

  .jb-occasions-{{ ai_gen_id }}__card-title {
    margin: 0 0 10px;
    color: {{ block.settings.heading_color }};
    font-family: var(--font-heading--family, serif);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
  }

  .jb-occasions-{{ ai_gen_id }}__body {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: var(--font-body--family, sans-serif);
    font-size: 15px;
    line-height: 1.6;
  }

  @media screen and (min-width: 750px) {
    .jb-occasions-{{ ai_gen_id }}__grid { grid-template-columns: repeat(3, 1fr); }
  }
{% endstyle %}

<div class="jb-occasions-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="jb-occasions-{{ ai_gen_id }}__head">
    <h2 class="jb-occasions-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2>
    <p class="jb-occasions-{{ ai_gen_id }}__lede">{{ block.settings.intro }}</p>
  </div>

  <div class="jb-occasions-{{ ai_gen_id }}__grid">
    {% for i in (1..3) %}
      {% liquid
        assign title_key = 'card_' | append: i | append: '_title'
        assign body_key = 'card_' | append: i | append: '_body'
        assign image_key = 'card_' | append: i | append: '_image'
        assign title = block.settings[title_key]
        assign body = block.settings[body_key]
        assign image = block.settings[image_key]
      %}
      <article class="jb-occasions-{{ ai_gen_id }}__card">
        <div class="jb-occasions-{{ ai_gen_id }}__media">
          {% if image != blank %}
            {{ image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 750px) 33vw, 100vw', alt: title }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="jb-occasions-{{ ai_gen_id }}__content">
          <h3 class="jb-occasions-{{ ai_gen_id }}__card-title">{{ title }}</h3>
          <p class="jb-occasions-{{ ai_gen_id }}__body">{{ body }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Occasion cards",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One piece. Every occasion it matters." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "You don't own three outfits' worth of accessories. You own one that belongs everywhere." },
    { "type": "header", "content": "Card 1" },
    { "type": "text", "id": "card_1_title", "label": "Title", "default": "The wedding" },
    { "type": "textarea", "id": "card_1_body", "label": "Description", "default": "Groomsman, best man, or the guy who cleaned up better than expected. It holds through the toasts, the dancing, and the photos that end up framed." },
    { "type": "image_picker", "id": "card_1_image", "label": "Image" },
    { "type": "header", "content": "Card 2" },
    { "type": "text", "id": "card_2_title", "label": "Title", "default": "The date" },
    { "type": "textarea", "id": "card_2_body", "label": "Description", "default": "The dinner reservation you actually got dressed for. One less thing to think about while you're trying not to think about anything." },
    { "type": "image_picker", "id": "card_2_image", "label": "Image" },
    { "type": "header", "content": "Card 3" },
    { "type": "text", "id": "card_3_title", "label": "Title", "default": "The work event" },
    { "type": "textarea", "id": "card_3_body", "label": "Description", "default": "The client dinner. The award you have to walk up for. The photo on LinkedIn you didn't know was being taken." },
    { "type": "image_picker", "id": "card_3_image", "label": "Image" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder background", "default": "#F5F5F5" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#D9D9D9" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#555555" }
  ],
  "presets": [ { "name": "Occasion cards" } ],
  "tag": null,
  "class": "occasion-cards-block"
}
{% endschema %}