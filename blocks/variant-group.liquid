{%- doc -%}
  Variant Group (Pocket Square PDP).

  Lists the products referenced by the current product's `custom.variant_group`
  metafield, a list of Variant Group metaobjects with the fields:
  - `product` (product reference, required)
  - `featured_image` (image, optional; falls back to the product's featured image)
  - `title` (single-line text, optional; falls back to the product title)

  The current product always renders first and active, then the other referenced
  products in metafield order (duplicates skipped). Grid/List and Show more/less are
  handled by `variant-group.js`; without JavaScript every item stays reachable.

  @example
  {% content_for 'block', type: 'variant-group', id: 'variant-group' %}
{%- enddoc -%}

{%- liquid
  assign current_product = closest.product
  assign group_entries = current_product.metafields.custom.variant_group.value
  assign products_shown = block.settings.products_shown
  assign list_id = 'VariantGroup-' | append: block.id

  # Selected Color value of the product being viewed; carried to sibling PDP links.
  assign selected_color = ''
  for current_option in current_product.options_with_values
    assign current_option_key = current_option.name | downcase | strip
    if current_option_key == 'color' or current_option_key == 'colour'
      assign selected_color = current_option.selected_value
      break
    endif
  endfor

  # The current product's own entry (if referenced) supplies its title/image overrides.
  assign current_entry = nil
  assign seen_product_ids = ',' | append: current_product.id | append: ','
  assign other_count = 0

  for entry in group_entries
    assign entry_product = entry.product.value
    if entry_product == blank
      continue
    endif

    if entry_product.id == current_product.id
      if current_entry == nil
        assign current_entry = entry
      endif
      continue
    endif

    assign entry_id_token = ',' | append: entry_product.id | append: ','
    if seen_product_ids contains entry_id_token
      continue
    endif

    assign seen_product_ids = seen_product_ids | append: entry_product.id | append: ','
    assign other_count = other_count | plus: 1
  endfor

  assign total_count = other_count | plus: 1
  assign has_more = false
  if total_count > products_shown
    assign has_more = true
  endif

  # Grid renders as a one-row slider; any other saved value falls back to it.
  assign layout = 'grid'
  if block.settings.default_layout == 'list'
    assign layout = 'list'
  endif

  assign current_title = current_entry.title.value | default: current_product.title
  assign original_title = current_product.title
  assign current_image = current_entry.featured_image.value | default: current_product.featured_image

  # Render only with siblings to choose from (always in the editor so the block stays selectable).
  assign should_render = false
  if current_product != blank
    if other_count > 0 or request.design_mode
      assign should_render = true
    endif
  endif
-%}

{%- if should_render -%}
  <script
    src="{{ 'variant-group.js' | asset_url }}"
    type="module"
  ></script>

  <variant-group-component
    class="variant-group spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    data-layout="{{ layout }}"
    data-expanded="false"
    {{ block.shopify_attributes }}
  >
    <div class="variant-group__header">
      <p class="variant-group__heading">
        <span class="variant-group__label">{{ block.settings.heading | escape }}</span>
        <span
          class="variant-group__current"
          ref="currentTitle"
        >
          {{- current_title | escape -}}
        </span>
      </p>

      <div
        class="variant-group__layouts"
        role="group"
        aria-label="{{ 'products.variant_group.layout' | t }}"
      >
        <button
          type="button"
          class="variant-group__layout-button button-unstyled"
          aria-pressed="{% if layout == 'grid' %}true{% else %}false{% endif %}"
          aria-controls="{{ list_id }}"
          ref="layoutButtons[]"
          data-layout-value="grid"
          on:click="/setLayout/grid"
        >
          {{ 'products.variant_group.grid' | t }}
        </button>
        <button
          type="button"
          class="variant-group__layout-button button-unstyled"
          aria-pressed="{% if layout == 'list' %}true{% else %}false{% endif %}"
          aria-controls="{{ list_id }}"
          ref="layoutButtons[]"
          data-layout-value="list"
          on:click="/setLayout/list"
        >
          {{ 'products.variant_group.list' | t }}
        </button>
      </div>
    </div>

    <div class="variant-group__viewport">
    <ul
      id="{{ list_id }}"
      class="variant-group__list list-unstyled"
      role="list"
      ref="list"
    >
      {%- render 'variant-group-item',
        item_product: current_product,
        item_title: original_title,
        item_image: current_image,
        is_current: true,
        selected_color: selected_color,
        is_extra: false
      -%}

      {%- liquid
        assign rendered_ids = ',' | append: current_product.id | append: ','
        assign position = 1

        for entry in group_entries
          assign entry_product = entry.product.value
          if entry_product == blank
            continue
          endif

          assign entry_id_token = ',' | append: entry_product.id | append: ','
          if rendered_ids contains entry_id_token
            continue
          endif

          assign rendered_ids = rendered_ids | append: entry_product.id | append: ','
          assign position = position | plus: 1

          # Item cards always show the product's original title, matching the current item.
          assign entry_title = entry_product.title
          assign entry_image = entry.featured_image.value | default: entry_product.featured_image

          assign is_extra = false
          if position > products_shown
            assign is_extra = true
          endif

          render 'variant-group-item', item_product: entry_product, item_title: entry_title, item_image: entry_image, is_current: false, selected_color: selected_color, is_extra: is_extra
        endfor
      -%}
    </ul>

      {%- comment -%} Slider arrows; shown only in the Grid layout. {%- endcomment -%}
      <button
        type="button"
        class="variant-group__arrow variant-group__arrow--previous button-unstyled"
        aria-label="{{ 'products.add_ons.previous' | t }}"
        aria-controls="{{ list_id }}"
        ref="previous"
        on:click="/scrollPrevious"
        hidden
      >
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-slider-arrow.svg' | inline_asset_content -}}</span>
      </button>
      <button
        type="button"
        class="variant-group__arrow variant-group__arrow--next button-unstyled"
        aria-label="{{ 'products.add_ons.next' | t }}"
        aria-controls="{{ list_id }}"
        ref="next"
        on:click="/scrollNext"
        hidden
      >
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-slider-arrow.svg' | inline_asset_content -}}</span>
      </button>
    </div>

    {%- if has_more -%}
      <button
        type="button"
        class="variant-group__toggle button-unstyled"
        aria-expanded="false"
        aria-controls="{{ list_id }}"
        ref="toggle"
        on:click="/toggleExpanded"
      >
        <span class="variant-group__toggle-more">{{ 'actions.show_more' | t }}</span>
        <span class="variant-group__toggle-less">{{ 'actions.show_less' | t }}</span>
      </button>
    {%- endif -%}
  </variant-group-component>
{%- endif -%}

{% stylesheet %}
  .variant-group {
    --variant-group-gap: var(--gap-xs);
    --variant-group-arrow-width: 2rem;
    --variant-group-border: rgb(var(--color-foreground-rgb) / var(--opacity-15));
    --variant-group-active-surface: #F7F5F0;

    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    min-width: 0;
  }

  .variant-group__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
  }

  .variant-group__heading {
    margin: 0;
    font-size: var(--font-size--2xs);
    line-height: 14.4px;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .variant-group__label {
    font-weight: 700;
  }

  .variant-group__label::after {
    content: ':';
    margin-inline-end: 0.25em;
  }

  /* Grid / List segmented control */
  .variant-group__layouts {
    display: inline-flex;
    padding: var(--padding-3xs);
    border-radius: 999px;
    background-color: #efeae1;
 }

  .variant-group__layout-button {
    padding: 4px 14px;
    border-radius: 999px;
    color: var(--color-foreground);
    font-size: 11px;
    line-height: 13.2px;
    font-weight: 400;
    cursor: pointer;

    &[aria-pressed='true'] {
      background-color: var(--color-background);
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid currentcolor;
      outline-offset: calc(var(--focus-outline-width) * -1);
    }
  }

  /* Items */
  .variant-group__list {
    margin: 0;
    padding: 0;
  }

  /* Only the List layout holds back items behind "Show more"; the Grid slider shows them all */
  .variant-group[data-layout='list'][data-expanded='false'] .variant-group__item--extra {
    display: none;
  }

  .variant-group__viewport {
    overflow: hidden;
    position: relative;
    min-width: 0;
  }

  /* Without JavaScript every item stays reachable */
  variant-group-component:not(:defined) .variant-group__item--extra {
    display: block;
  }

  variant-group-component:not(:defined) :is(.variant-group__toggle, .variant-group__layouts) {
    display: none;
  }

  .variant-group__link {
    display: flex;
    min-width: 0;
    color: inherit;
    text-decoration: none;

    &:focus-visible {
      outline: var(--focus-outline-width) solid currentcolor;
      outline-offset: var(--focus-outline-offset);
    }
  }

  .variant-group__media {
    display: block;
    flex-shrink: 0;
    overflow: hidden;
    aspect-ratio: 1;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .variant-group__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .variant-group__title {
    display: block;
    color: #2A2A2A;
    font-size: 14px;
    line-height: 16.8px;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .variant-group__meta {
    display: block;
    font-size: var(--font-size--xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .variant-group__check {
    display: none;
  }

  /* Grid layout: one scrolling row of image tiles, with the next arrow in its own column at
     the row's end. The fractional count always leaves part of the next design showing.
     Text stays available to assistive tech. */
  .variant-group[data-layout='grid'] {
    --variant-group-gap: 4px;
    --variant-group-visible: 4.35;
    --variant-group-slide-width: calc(100% / var(--variant-group-visible) - var(--variant-group-gap));

    @media screen and (min-width: 750px) {
      --variant-group-visible: 5.25;
    }

    .variant-group__viewport {
      padding-inline-end: var(--variant-group-arrow-width);
    }

    .variant-group__list {
      display: flex;
      gap: var(--variant-group-gap);
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: x mandatory;
      /* Once scrolled, tiles snap clear of the previous arrow */
      scroll-padding-inline-start: var(--variant-group-arrow-width);
      scrollbar-width: none;
    }

    .variant-group__list::-webkit-scrollbar {
      display: none;
    }

    .variant-group__item {
      box-sizing: border-box;
      flex: 0 0 var(--variant-group-slide-width);
      width: var(--variant-group-slide-width);
      min-width: var(--variant-group-slide-width);
      max-width: var(--variant-group-slide-width);
      scroll-snap-align: start;
    }

    /* Padding and border sit inside the tile so the item width stays exact */
    .variant-group__link {
      box-sizing: border-box;
      width: 100%;
    }

    .variant-group__link {
      flex-direction: column;
      padding: var(--padding-2xs);
      border: var(--style-border-width) solid transparent;
    }

    .variant-group__link:hover {
      border-color: var(--variant-group-border);
    }

    .variant-group__item--current .variant-group__link {
      border-color: var(--color-foreground);
    }

    .variant-group__media {
      width: 100%;
    }

    /* Static tiles: no hover swap, zoom or fade, and only the rendered image is shown
       (guards against hover effects applied to product links from outside the block) */
    .variant-group__media > :not(.variant-group__image) {
      display: none;
    }

    .variant-group__image,
    .variant-group__link:hover .variant-group__image {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .variant-group__details,
    .variant-group__price {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
  }

  /* Full-height arrows: next sits in the reserved end column, previous covers the row's start */
  .variant-group__arrow {
    position: absolute;
    inset-block: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--variant-group-arrow-width);
    background-color: var(--color-background) !important;
    cursor: pointer;

    .svg-wrapper {
      display: flex;
      width: 9px;
      height: 17px;
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid currentcolor;
      outline-offset: calc(var(--focus-outline-width) * -1);
    }
  }

  /* The display rule above would otherwise override the [hidden] state set by JS */
  .variant-group__arrow[hidden] {
    display: none;
  }

  .variant-group__arrow--previous {
    inset-inline-start: 0;
  }

  .variant-group__arrow--next {
    inset-inline-end: 0;
  }

  /* One right-pointing icon: flipped for "previous", and for "next" in RTL */
  .variant-group__arrow--previous .svg-wrapper,
  [dir='rtl'] .variant-group__arrow--next .svg-wrapper {
    transform: scaleX(-1);
  }

  [dir='rtl'] .variant-group__arrow--previous .svg-wrapper {
    transform: none;
  }

  .variant-group:not([data-layout='grid']) .variant-group__arrow {
    display: none;
  }

  /* List layout: rows with title, finishes, price and a check on the current product */
  .variant-group[data-layout='list'] {
    .variant-group__list {
      display: flex;
      flex-direction: column;
      border: var(--style-border-width) solid var(--variant-group-border);
    }

    .variant-group__item + .variant-group__item {
      border-block-start: var(--style-border-width) solid var(--variant-group-border);
    }

    .variant-group__link {
      align-items: center;
      gap: 14px;
      padding: 10px 16px 10px 12px;
    }

    .variant-group__link:hover,
    .variant-group__item--current .variant-group__link {
      background-color: var(--variant-group-active-surface);
    }

    .variant-group__media {
      width: 3rem;
    }

    .variant-group__details {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      gap: var(--gap-3xs);
      min-width: 0;
    }

    .variant-group__price {
      flex-shrink: 0;
      color: #2a2a2a;
      font-size: 14px;
      line-height: 16.8px;
      font-weight: 400;
      white-space: nowrap;
    }

    .variant-group__check {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 1rem;
      height: 1rem;
      padding: 0.2rem;
      background-color: var(--color-foreground);
      color: var(--color-background);

      svg {
        width: 10px;
        height: 10px;
      }
    }
  }

  /* Show more / Show less */
  .variant-group__toggle {
    align-self: center;
    font-size: var(--font-size--2xs);
    line-height: 16.8px;
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    color: var(--color-foreground);
    cursor: pointer;

    &:focus-visible {
      outline: var(--focus-outline-width) solid currentcolor;
      outline-offset: var(--focus-outline-offset);
    }
  }

  /* The toggle belongs to the List layout; the Grid slider shows every item */
  .variant-group[data-layout='grid'] .variant-group__toggle,
  .variant-group__toggle[aria-expanded='false'] .variant-group__toggle-less,
  .variant-group__toggle[aria-expanded='true'] .variant-group__toggle-more {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .variant-group[data-layout='list'] .variant-group__media {
      width: 3.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.variant_group",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.variant_group_metafield"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Design"
    },
    {
      "type": "select",
      "id": "default_layout",
      "label": "t:settings.default_layout",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "list",
          "label": "t:options.list"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_shown",
      "label": "t:settings.products_shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "t:names.variant_group",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
