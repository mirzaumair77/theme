{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .jb-occasions-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; color:{{ block.settings.text_color }}; }
  .jb-occasions-{{ ai_gen_id }}__head { max-width:680px; margin:0 auto 40px; text-align:center; }
  .jb-occasions-{{ ai_gen_id }}__title { margin:0 0 12px; font-family:{{ settings.type_heading_font.family }},serif; font-size:{{ block.settings.heading_size }}px; line-height:1.15; }
  .jb-occasions-{{ ai_gen_id }}__lede,.jb-occasions-{{ ai_gen_id }}__card-body { color:{{ block.settings.muted_text_color }}; font-family:{{ settings.type_body_font.family }},sans-serif; line-height:1.55; }
  .jb-occasions-{{ ai_gen_id }}__lede { margin:0; font-size:16px; }
  .jb-occasions-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:1fr; gap:24px; }
  .jb-occasions-{{ ai_gen_id }}__card { min-width:0; padding:32px 20px; border:1px solid {{ block.settings.border_color }}; background:{{ block.settings.card_background }}; text-align:center; }
  .jb-occasions-{{ ai_gen_id }}__photo { margin:-32px -20px 24px; }
  .jb-occasions-{{ ai_gen_id }}__photo img { display:block; width:100%; aspect-ratio:4/3; object-fit:cover; }
  .jb-occasions-{{ ai_gen_id }}__placeholder { display:flex; align-items:center; justify-content:center; aspect-ratio:4/3; margin:-32px -20px 24px; background:#f5f5f5; color:#555; }
  .jb-occasions-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; }
  .jb-occasions-{{ ai_gen_id }}__card-title { margin:0 0 10px; font-family:{{ settings.type_heading_font.family }},serif; font-size:24px; line-height:1.2; }
  .jb-occasions-{{ ai_gen_id }}__card-body { margin:0; font-size:15px; }
  .jb-occasions-{{ ai_gen_id }}__foot { margin:40px 0 0; color:{{ block.settings.muted_text_color }}; text-align:center; font-size:15px; font-style:italic; }
  @media screen and (min-width:750px) { .jb-occasions-{{ ai_gen_id }}__grid { grid-template-columns:repeat(3,1fr); } }
  @media screen and (max-width:749px) { .jb-occasions-{{ ai_gen_id }}__title { font-size:30px; } }
{% endstyle %}

<div class="jb-occasions-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="jb-occasions-{{ ai_gen_id }}__head"><h2 class="jb-occasions-{{ ai_gen_id }}__title">{{ block.settings.title }}</h2><p class="jb-occasions-{{ ai_gen_id }}__lede">{{ block.settings.lede }}</p></div>
  <div class="jb-occasions-{{ ai_gen_id }}__grid">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'card_' | append: i | append: '_image'
        assign title_key = 'card_' | append: i | append: '_title'
        assign body_key = 'card_' | append: i | append: '_body'
        assign card_image = block.settings[image_key]
      %}
      <div class="jb-occasions-{{ ai_gen_id }}__card">
        {% if card_image != blank %}<div class="jb-occasions-{{ ai_gen_id }}__photo">{{ card_image | image_url: width: 800 | image_tag: loading:'lazy', widths:'400,600,800', sizes:'(min-width: 750px) 33vw, 100vw', alt:card_image.alt }}</div>{% else %}<div class="jb-occasions-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
        <h3 class="jb-occasions-{{ ai_gen_id }}__card-title">{{ block.settings[title_key] }}</h3><p class="jb-occasions-{{ ai_gen_id }}__card-body">{{ block.settings[body_key] }}</p>
      </div>
    {% endfor %}
  </div>
  {% if block.settings.footnote != blank %}<p class="jb-occasions-{{ ai_gen_id }}__foot">{{ block.settings.footnote }}</p>{% endif %}
</div>

