        height: 48px;
        color: #000;
        margin-bottom: 1.25rem;
      }
      .jbps-occasions__icon svg {
        width: 100%;
        height: 100%;
      }
      .jbps-occasions__card-t,  }
      .jbps-occasions__icon svg {
        width: 100%;
        height: 100%;
      }
      .jbps-occasions__card-title {
        font-family: var(--font-primary--family);
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 0.75rem;
      }
      .jbps-occasions__card-body {
        font-size: 0.9rem;
        line-height: 1.55;
        color: #444444;
        margin: 0;
      }
      .jbps-occasions__foot {
        text-align: center;
        margin: 2.5rem 0 0;
        font-size: 0.95rem;
        font-style: italic;
        color: #555555;
      }
