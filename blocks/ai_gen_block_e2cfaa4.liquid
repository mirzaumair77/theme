{% doc %}
  @prompt
    I want a featured collections block. I want it to feature two collections with the block title above and centered with the text blocks below the collection images., I want the images to fill on fullscreen. The block is too small and narrow on fullscreen, I want the next alignment to the bottom left

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collections-{{ ai_gen_id }} {
    padding: 60px 20px;
    text-align: center;
    max-width: 100%;
  }

  .ai-featured-collections__title-{{ ai_gen_id }} {
    margin: 0 0 60px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-featured-collections__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    width: 100%;max-width: 1400px;
    margin: 0 auto;
  }

  .ai-featured-collections__item-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;display: flex;
    flex-direction: column;}

  .ai-featured-collections__item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-featured-collections__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    margin-bottom: 30px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    flex-grow: 1;
  }

  .ai-featured-collections__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;}

  .ai-featured-collections__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-collections__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-featured-collections__content-{{ ai_gen_id }} {
    text-align: left;
    padding: 0 20px;
    margin-top: auto;
  }

  .ai-featured-collections__collection-title-{{ ai_gen_id }} {
    margin: 0 0 16px;
    font-size: {{ block.settings.collection_title_size }}px;
    color: {{ block.settings.collection_title_color }};
    font-weight: 600;
  }

  .ai-featured-collections__description-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 990px) {
    .ai-featured-collections__grid-{{ ai_gen_id }} {
      gap: 30px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collections-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-featured-collections__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-featured-collections__title-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .ai-featured-collections__content-{{ ai_gen_id }} {
      padding: 0 10px;
    }
  }
{% endstyle %}<div class="ai-featured-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-featured-collections__title-{{ ai_gen_id }}">
      {{ block.settings.title }}
    </h2>
  {% endif %}<div class="ai-featured-collections__grid-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign description_key = 'description_' | append: i
        assign collection = block.settings[collection_key]
        assign description = block.settings[description_key]
      %}

      {% if collection != blank %}<a href="{{ collection.url }}" class="ai-featured-collections__item-{{ ai_gen_id }}">
          <div class="ai-featured-collections__image-wrapper-{{ ai_gen_id }}">
            {% if collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                class="ai-featured-collections__image-{{ ai_gen_id }}"
                loading="lazy"
                width="800"
                height="600"
              >
            {% else %}
              <div class="ai-featured-collections__image-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-featured-collections__content-{{ ai_gen_id }}">
            <h3 class="ai-featured-collections__collection-title-{{ ai_gen_id }}">
              {{ collection.title }}
            </h3>
            {% if description != blank %}
              <div class="ai-featured-collections__description-{{ ai_gen_id }}">
                {{ description }}
              </div>
            {% endif %}
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Featured collections",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Block title",
      "default": "Featured Collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "First collection"
    },
    {
      "type": "richtext",
      "id": "description_1",
      "label": "First collection description",
      "default": "<p>Discover our curated selection of premium products.</p>"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Second collection"
    },
    {
      "type": "richtext",
      "id": "description_2",
      "label": "Second collection description",
      "default": "<p>Explore our latest arrivals and trending items.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3/2",
          "label": "Classic (3:2)"
        },
        {
          "value": "16/9",
          "label": "Wide (16:9)"
        }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Block title size",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Block title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "collection_title_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Collection title size",
      "default": 24
    },
    {
      "type": "color",
      "id": "collection_title_color",
      "label": "Collection title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Featured collections"
    }
  ]
}
{% endschema %}