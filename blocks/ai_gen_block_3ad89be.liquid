{% doc %}
  @prompt
    I want a block for my footer menu in multiple columns with the apprpriate hyperlinks for the each menu item, It's one menu that is organized into seperate columns
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-menu-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-footer-menu-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    width: 100%;
  }

  .ai-footer-menu-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
  }

  .ai-footer-menu-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    text-transform: {% if block.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
  }

  .ai-footer-menu-link-{{ ai_gen_id }} {
    font-family: {{ block.settings.link_font.family }}, {{ block.settings.link_font.fallback_families }};
    font-weight: {{ block.settings.link_font.weight }};
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ai-footer-menu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-footer-menu-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<div class="ai-footer-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-menu-container-{{ ai_gen_id }}">
    {% if block.settings.menu_1 != blank %}
      <div class="ai-footer-menu-column-{{ ai_gen_id }}">
        {% if block.settings.column_1_heading != blank %}
          <h3 class="ai-footer-menu-heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
        {% endif %}
        {% for link in block.settings.menu_1.links %}
          <a href="{{ link.url }}" class="ai-footer-menu-link-{{ ai_gen_id }}">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if block.settings.menu_2 != blank %}
      <div class="ai-footer-menu-column-{{ ai_gen_id }}">
        {% if block.settings.column_2_heading != blank %}
          <h3 class="ai-footer-menu-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
        {% endif %}
        {% for link in block.settings.menu_2.links %}
          <a href="{{ link.url }}" class="ai-footer-menu-link-{{ ai_gen_id }}">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if block.settings.menu_3 != blank %}
      <div class="ai-footer-menu-column-{{ ai_gen_id }}">
        {% if block.settings.column_3_heading != blank %}
          <h3 class="ai-footer-menu-heading-{{ ai_gen_id }}">{{ block.settings.column_3_heading }}</h3>
        {% endif %}
        {% for link in block.settings.menu_3.links %}
          <a href="{{ link.url }}" class="ai-footer-menu-link-{{ ai_gen_id }}">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if block.settings.menu_4 != blank %}
      <div class="ai-footer-menu-column-{{ ai_gen_id }}">
        {% if block.settings.column_4_heading != blank %}
          <h3 class="ai-footer-menu-heading-{{ ai_gen_id }}">{{ block.settings.column_4_heading }}</h3>
        {% endif %}
        {% for link in block.settings.menu_4.links %}
          <a href="{{ link.url }}" class="ai-footer-menu-link-{{ ai_gen_id }}">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

