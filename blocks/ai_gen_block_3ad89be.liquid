      "id": "column_gap",
      "label": "Column gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "link_spacing",
      "label": "Link spacing",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "column_1_heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "column_3_heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Column 4"
    },
    {
      "type": "link_list",
      "id": "menu_4",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "column_4_heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
