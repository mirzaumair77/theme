{%- doc -%}
  Size guide link ("Not sure? Find your size") that opens the ring size guide drawer.
  Detects the product option whose name contains "size" so the drawer can select
  sizes in the variant picker. Renders nothing when the product has no size option.
  All drawer content comes from this block's settings.
{%- enddoc -%}

{%- liquid
  assign drawer_id = 'size-guide-drawer-' | append: block.id
  assign size_option_name = ''
  assign selected_size = ''

  for product_option in closest.product.options_with_values
    assign option_name = product_option.name | downcase
    if option_name contains 'size'
      assign size_option_name = product_option.name
      assign selected_size = product_option.selected_value
      break
    endif
  endfor
-%}

{%- comment -%} Render nothing when the product has no size option. {%- endcomment -%}
{%- if size_option_name != blank -%}
<div
  class="size-guide"
  {{ block.shopify_attributes }}
>
  <div class="size-guide__trigger">
    {%- if block.settings.trigger_text != blank -%}
      <span class="size-guide__trigger-text">
        {{ block.settings.trigger_text | escape }}
      </span>
    {% endif -%}
    <button
      type="button"
      class="button-unstyled size-guide__link"
      aria-haspopup="dialog"
      aria-controls="{{ drawer_id }}"
      on:click="#{{ drawer_id }}/showDialog"
    >
      {{- block.settings.trigger_label | escape -}}
    </button>
  </div>

  {% render 'size-guide-drawer',
    drawer_id: drawer_id,
    settings: block.settings,
    size_option_name: size_option_name,
    selected_size: selected_size
  %}
</div>
{%- endif -%}

{% stylesheet %}
  .size-guide {
    margin-block-start: -12px;
  }

  .size-guide__trigger {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: calc(8px * var(--product-design-type-scale, 1.25));
    font-weight: 500;
    line-height: normal;
  }

  .size-guide__trigger-text {
    color: #7c7c7c;
  }

  .size-guide .size-guide__link {
    display: inline;
    padding-inline-start: 4px;
    color: #2A2A2A;
    font-size: inherit;
    line-height: 1.2;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: auto;
    cursor: pointer;
  }
{% endstylesheet %}

