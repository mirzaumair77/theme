{%- doc -%}
  Renders a promotional image card for one top-level item's mega menu.

  The header menu block captures every child of this type once, then places each card
  inside the mega menu whose top-level link title matches `block.settings.menu_item`
  (compared as handles, so case and punctuation differences are ignored). Output is
  wrapped in `<!--mega-menu-image:handle-->` markers that `_header-menu` uses to route it.
  Cards render nothing until a menu item is entered and an image or heading resolves.

  Collection source: the collection's featured image, title, and URL are the defaults,
  and any filled custom field replaces its counterpart. Custom source: only the custom
  fields are used.

  @example
  {% content_for 'blocks' %}
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign menu_item_key = block_settings.menu_item | strip | handleize
  assign collection = block_settings.collection

  assign card_image = block_settings.image
  assign card_heading = block_settings.heading | strip
  assign card_link_text = block_settings.link_text | strip
  assign card_url = block_settings.link

  if block_settings.content_source == 'collection' and collection != blank
    assign card_image = card_image | default: collection.featured_image
    assign card_heading = card_heading | default: collection.title
    assign card_url = card_url | default: collection.url
  endif

  if card_url != blank and card_link_text == blank
    assign card_link_text = 'content.mega_menu_shop_now' | t
  endif
-%}

{%- if menu_item_key != blank and card_image != blank or menu_item_key != blank and card_heading != blank -%}
  <!--mega-menu-image:{{ menu_item_key }}-->
  <div
    class="mega-menu-image{% if card_image == blank %} mega-menu-image--no-image{% endif %}"
    {{ block.shopify_attributes }}
  >
    {%- if card_image != blank -%}
      {{-
        card_image
        | image_url: width: 1200
        | image_tag:
          class: 'mega-menu-image__media',
          widths: '360, 480, 640, 800, 1000, 1200',
          sizes: '(min-width: 1440px) 515px, 36vw',
          loading: 'lazy',
          alt: card_image.alt
      -}}
    {%- endif -%}

    <div class="mega-menu-image__content">
      {%- if card_heading != blank -%}
        <p
          class="mega-menu-image__heading"
          {% if block_settings.heading_color != blank %}
            style="--mega-menu-image-heading-color: {{ block_settings.heading_color }};"
          {% endif %}
        >
          {{- card_heading | escape -}}
        </p>
      {%- endif -%}
      {%- if card_url != blank -%}
        <a
          href="{{ card_url }}"
          class="mega-menu-image__link"
        >
          {{- card_link_text | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
  <!--/mega-menu-image-->
{%- endif -%}

{% stylesheet %}
  .mega-menu-image {
    --mega-menu-image-text: var(--color-white, #fff);

    position: relative;
    display: flex;
    align-items: flex-end;
    min-width: 0;
    aspect-ratio: 515 / 300;
    overflow: hidden;
    border-radius: var(--menu-image-border-radius, 0);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5, 0.05));
    color: var(--mega-menu-image-text);
    isolation: isolate;
  }

  .mega-menu-image--no-image {
    --mega-menu-image-text: var(--color-foreground);
  }

  .mega-menu-image:not(.mega-menu-image--no-image)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.4), transparent 55%);
    pointer-events: none;
  }

  .mega-menu-image__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--animation-speed-slow, 0.4s) var(--ease-out-cubic, ease-out);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .mega-menu-image:hover .mega-menu-image__media {
      transform: scale(1.03);
    }
  }

  .mega-menu-image__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
    padding: 20px;
  }

  .mega-menu-image__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 21px;
    line-height: 1.2;
    font-weight: 400;
    font-style: italic;
    color: var(--mega-menu-image-heading-color, inherit);
    overflow-wrap: anywhere;
  }

  .mega-menu-image__link {
    padding-block-end: 4px;
    border-block-end: 2px solid currentColor;
    font-family: var(--font-body--family);
    color: inherit;
    font-size: 10px;
    line-height: 1.2;
    font-weight: 400;
    text-decoration: none;

    /* The whole card is the click target; the label keeps the accessible name */
    &::before {
      content: '';
      position: absolute;
      inset: 0;
    }

    &:hover {
      color: inherit;
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid currentColor;
      outline-offset: var(--focus-outline-offset);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.mega_menu_image",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_item",
      "label": "t:settings.mega_menu_item",
      "info": "t:info.mega_menu_item"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "t:settings.mega_menu_content_source",
      "options": [
        {
          "value": "collection",
          "label": "t:options.mega_menu_source_collection"
        },
        {
          "value": "custom",
          "label": "t:options.mega_menu_source_custom"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "header",
      "content": "t:content.mega_menu_custom_content",
      "info": "t:content.mega_menu_custom_content_info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.mega_menu_heading_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:settings.mega_menu_link_text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.mega_menu_image"
    }
  ]
}
{% endschema %}
