{% doc %}
  @prompt
    I want a block for a featured set of products. Let me select the 4 products with an image on the left. I want to be able to adjust the overall height of the block so it doesnt take up too much of the screen. Also with add to cart buttons, necessary variants swatches for the products cards. Give me any necessary customizations i'll need for sizes.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-featured-products__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-products__layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    height: {{ block.settings.block_height }}px;
    align-items: stretch;
  }

  .ai-featured-products__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    height: 100%;
  }

  .ai-featured-products__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-products__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-products__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-featured-products__products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    height: 100%;
  }

  .ai-featured-products__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-featured-products__card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.product_image_border_radius }}px;
  }

  .ai-featured-products__card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-products__card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-products__card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-featured-products__card-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .ai-featured-products__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-featured-products__card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-featured-products__card-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
  }

  .ai-featured-products__variants-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-featured-products__variant-label-{{ ai_gen_id }} {
    font-size: 12px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-featured-products__swatches-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ai-featured-products__swatch-{{ ai_gen_id }} {
    position: relative;
    cursor: pointer;
  }

  .ai-featured-products__swatch-input-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .ai-featured-products__swatch-label-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.swatch_size }}px;
    height: {{ block.settings.swatch_size }}px;
    border-radius: {{ block.settings.swatch_border_radius }}px;
    border: 2px solid {{ block.settings.swatch_border_color }};
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 11px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
    background-color: #fff;
  }

  .ai-featured-products__swatch-input-{{ ai_gen_id }}:checked + .ai-featured-products__swatch-label-{{ ai_gen_id }} {
    border-color: {{ block.settings.swatch_selected_border }};
    border-width: 3px;
    box-shadow: 0 0 0 1px {{ block.settings.swatch_selected_border }};
  }

  .ai-featured-products__swatch-label-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
  }

  .ai-featured-products__add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 20px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: auto;
  }

  .ai-featured-products__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-1px);
  }

  .ai-featured-products__add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-featured-products__empty-state-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 989px) {
    .ai-featured-products__layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      height: auto;
    }

    .ai-featured-products__image-wrapper-{{ ai_gen_id }} {
      height: 300px;
    }

    .ai-featured-products__products-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-products__products-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-featured-products__card-{{ ai_gen_id }} {
      padding: 16px;
    }
  }
{% endstyle %}

<featured-products-{{ ai_gen_id }} class="ai-featured-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-products__container-{{ ai_gen_id }}">
    <div class="ai-featured-products__layout-{{ ai_gen_id }}">
      <div class="ai-featured-products__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.featured_image %}
          <img
            src="{{ block.settings.featured_image | image_url: width: 1000 }}"
            alt="{{ block.settings.featured_image.alt | escape }}"
            class="ai-featured-products__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.featured_image.width }}"
            height="{{ block.settings.featured_image.height }}"
          >
        {% else %}
          <div class="ai-featured-products__image-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-featured-products__products-grid-{{ ai_gen_id }}">
        {% liquid
          assign product_1 = block.settings.product_1
          assign product_2 = block.settings.product_2
          assign product_3 = block.settings.product_3
          assign product_4 = block.settings.product_4
          assign products = product_1 | concat: product_2 | concat: product_3 | concat: product_4
        %}

        {% for i in (1..4) %}
          {% liquid
            assign product_key = 'product_' | append: i
            assign product = block.settings[product_key]
          %}

          {% if product != blank %}
            <div class="ai-featured-products__card-{{ ai_gen_id }}" data-product-card="{{ i }}">
              <div class="ai-featured-products__card-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 500 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-featured-products__card-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                  >
                {% else %}
                  <div class="ai-featured-products__card-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-featured-products__card-content-{{ ai_gen_id }}">
                <h3 class="ai-featured-products__card-title-{{ ai_gen_id }}">
                  {{ product.title }}
                </h3>

                <div class="ai-featured-products__card-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-featured-products__card-price-compare-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>

                {% if product.has_only_default_variant == false %}
                  <div class="ai-featured-products__variants-{{ ai_gen_id }}">
                    {% for option in product.options_with_values %}
                      <div>
                        <p class="ai-featured-products__variant-label-{{ ai_gen_id }}">
                          {{ option.name }}
                        </p>
                        <div class="ai-featured-products__swatches-{{ ai_gen_id }}">
                          {% for value in option.values %}
                            <div class="ai-featured-products__swatch-{{ ai_gen_id }}">
                              <input
                                type="radio"
                                name="option-{{ i }}-{{ option.position }}"
                                value="{{ value | escape }}"
                                id="swatch-{{ ai_gen_id }}-{{ i }}-{{ option.position }}-{{ forloop.index }}"
                                class="ai-featured-products__swatch-input-{{ ai_gen_id }}"
                                data-product-index="{{ i }}"
                                data-option-position="{{ option.position }}"
                                {% if forloop.first %}checked{% endif %}
                              >
                              <label
                                for="swatch-{{ ai_gen_id }}-{{ i }}-{{ option.position }}-{{ forloop.index }}"
                                class="ai-featured-products__swatch-label-{{ ai_gen_id }}"
                                title="{{ value | escape }}"
                              >
                                {{ value | truncate: 3, '' }}
                              </label>
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}

                <button
                  class="ai-featured-products__add-to-cart-{{ ai_gen_id }}"
                  data-product-id="{{ product.id }}"
                  data-product-index="{{ i }}"
                  {% if product.available == false %}disabled{% endif %}
                >
                  {% if product.available %}
                    {{ block.settings.button_text }}
                  {% else %}
                    Sold out
                  {% endif %}
                </button>
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {% if product_1 == blank and product_2 == blank and product_3 == blank and product_4 == blank %}
          <div class="ai-featured-products__empty-state-{{ ai_gen_id }}">
            Next, select up to 4 products to feature
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</featured-products-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.productVariants = {};
      }

      connectedCallback() {
        this.initializeProducts();
        this.setupEventListeners();
      }

      initializeProducts() {
        const products = [
          {% for i in (1..4) %}
            {% liquid
              assign product_key = 'product_' | append: i
              assign product = block.settings[product_key]
            %}
            {% if product != blank %}
              {
                id: {{ product.id }},
                index: {{ i }},
                variants: {{ product.variants | json }},
                options: {{ product.options_with_values | json }}
              }{% unless forloop.last %},{% endunless %}
            {% endif %}
          {% endfor %}
        ];

        products.forEach(product => {
          this.productVariants[product.index] = {
            variants: product.variants,
            options: product.options,
            selectedOptions: {}
          };

          product.options.forEach((option, idx) => {
            this.productVariants[product.index].selectedOptions[idx + 1] = option.values[0];
          });
        });
      }

      setupEventListeners() {
        const swatchInputs = this.querySelectorAll('.ai-featured-products__swatch-input-{{ ai_gen_id }}');
        swatchInputs.forEach(input => {
          input.addEventListener('change', (e) => this.handleSwatchChange(e));
        });

        const addToCartButtons = this.querySelectorAll('.ai-featured-products__add-to-cart-{{ ai_gen_id }}');
        addToCartButtons.forEach(button => {
          button.addEventListener('click', (e) => this.handleAddToCart(e));
        });
      }

      handleSwatchChange(event) {
        const input = event.target;
        const productIndex = parseInt(input.dataset.productIndex);
        const optionPosition = parseInt(input.dataset.optionPosition);
        const value = input.value;

        if (this.productVariants[productIndex]) {
          this.productVariants[productIndex].selectedOptions[optionPosition] = value;
        }
      }

      getSelectedVariant(productIndex) {
        const productData = this.productVariants[productIndex];
        if (!productData) return null;

        const selectedOptions = productData.selectedOptions;
        const variant = productData.variants.find(v => {
          return Object.keys(selectedOptions).every(position => {
            const optionKey = 'option' + position;
            return v[optionKey] === selectedOptions[position];
          });
        });

        return variant;
      }

      async handleAddToCart(event) {
        const button = event.target;
        const productIndex = parseInt(button.dataset.productIndex);
        const variant = this.getSelectedVariant(productIndex);

        if (!variant) {
          console.error('No variant selected');
          return;
        }

        if (!variant.available) {
          return;
        }

        button.disabled = true;
        const originalText = button.textContent;
        button.textContent = 'Adding...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variant.id,
              quantity: 1
            })
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          button.textContent = 'Added!';

          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);

          document.dispatchEvent(new CustomEvent('cart:refresh'));

        } catch (error) {
          console.error('Error adding to cart:', error);
          button.textContent = 'Error';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }
    }

    customElements.define('featured-products-{{ ai_gen_id }}', FeaturedProducts{{ ai_gen_id }});
  })();
</script>

