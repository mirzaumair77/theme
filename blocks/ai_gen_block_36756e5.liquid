{% doc %}
  @prompt
    I want a block for a featured set of products. Let me select the 4-6 products with an image on the left. I want to be able to adjust the overall height of the block so it doesnt take up too much of the screen. Also with add to cart buttons, necessary variants swatches for the products cards. Give me any necessary customizations i'll need for sizes. I want the products in a grid on the right side with an image on the left with text and a button over the image. the product cards should have the swatch options/images showing not just text options, i want the product grid to be contained in the size of the block. I dont want to scroll between the products. Underneath the product should display just like the product cards on the collection page., product titles, prices, and swatches arent displaying underneath the product image, make the product cards display exactly like they appear on the collection page., the swatches aren't displaying properly, move the add to cart button to be in the bottom right corner of the image just like it is on the collection page. Also the swatches for the variants arent displaying correctly, Pull the variant swatch reference from the same place as it is on the collection page. Also display the variant swatch title to the right of the swatches middle aligned vertically, remove "Color:" and add the swatch references to show the appropriate color image and also display the color title on the right side of the swatches
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: {{ block.settings.block_height }}vh;
    overflow: hidden;
  }

  .ai-featured-products-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    height: 100%;
    padding: 20px;
  }

  .ai-featured-image-section-{{ ai_gen_id }} {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
  }

  .ai-featured-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-image-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40px;
    text-align: center;
  }

  .ai-featured-heading-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
    margin: 0 0 16px 0;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-featured-subtext-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
    margin: 0 0 24px 0;
    font-size: {{ block.settings.subtext_size }}px;
  }

  .ai-featured-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    transition: all 0.3s ease;
  }

  .ai-featured-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ai-products-grid-section-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    overflow: hidden;
    align-content: start;
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 4px;
    overflow: hidden;
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
  }

  .ai-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-quick-add-button-{{ ai_gen_id }} {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ settings.quick_add_background }};
    color: {{ settings.quick_add_text }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 2;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-quick-add-button-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-quick-add-button-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-quick-add-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-product-info-{{ ai_gen_id }} {
    padding: 12px 8px;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0 0 8px 0;
    font-weight: 500;
    color: #000;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0 0 12px 0;
    color: #000;
  }

  .ai-variant-swatches-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-swatches-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .ai-swatch-option-{{ ai_gen_id }} {
    width: {{ settings.variant_swatch_width }}px;
    height: {{ settings.variant_swatch_height }}px;
    border-radius: {{ settings.variant_swatch_radius }}px;
    border: {{ settings.variant_swatch_border_width }}px {{ settings.variant_swatch_border_style }} rgba(0, 0, 0, {{ settings.variant_swatch_border_opacity | divided_by: 100.0 }});
    cursor: pointer;
    transition: all 0.2s ease;
    overflow: hidden;
    position: relative;
  }

  .ai-swatch-option-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-swatch-option-{{ ai_gen_id }}.selected {
    border-color: #000;
    border-width: 2px;
  }

  .ai-swatch-color-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  .ai-swatch-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-selected-variant-name-{{ ai_gen_id }} {
    font-size: 12px;
    color: #666;
    display: flex;
    align-items: center;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-products-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-products-grid-section-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-featured-products-{{ ai_gen_id }} {
      height: auto;
    }
  }
{% endstyle %}

<featured-products-{{ ai_gen_id }} class="ai-featured-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-products-container-{{ ai_gen_id }}">
    <div class="ai-featured-image-section-{{ ai_gen_id }}">
      {% if block.settings.featured_image %}
        <img
          src="{{ block.settings.featured_image | image_url: width: 1000 }}"
          alt="{{ block.settings.featured_image.alt | escape }}"
          class="ai-featured-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.featured_image.width }}"
          height="{{ block.settings.featured_image.height }}"
        >
      {% else %}
        <div style="width: 100%; height: 100%; background: #f4f4f4; display: flex; align-items: center; justify-content: center;">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
      <div class="ai-featured-image-overlay-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-featured-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subtext != blank %}
          <p class="ai-featured-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
        {% endif %}
        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-featured-cta-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-products-grid-section-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign product = block.settings[product_key]
        %}
        
        {% if product != blank %}
          <div class="ai-product-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
            <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 500 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="500"
                  height="500"
                >
              {% else %}
                <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #f4f4f4; display: flex; align-items: center; justify-content: center;">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              
              <button 
                class="ai-quick-add-button-{{ ai_gen_id }}"
                data-product-handle="{{ product.handle }}"
                aria-label="Add {{ product.title }} to cart"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
              </button>
            </div>

            <div class="ai-product-info-{{ ai_gen_id }}">
              <h3 class="ai-product-title-{{ ai_gen_id }}">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              
              <div class="ai-product-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              {% assign swatch_option = null %}
              {% for option in product.options_with_values %}
                {% assign option_name_downcase = option.name | downcase %}
                {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' or option_name_downcase contains 'stone' %}
                  {% assign swatch_option = option %}
                  {% break %}
                {% endif %}
              {% endfor %}

              {% if swatch_option %}
                <div class="ai-variant-swatches-{{ ai_gen_id }}">
                  <div class="ai-swatches-wrapper-{{ ai_gen_id }}">
                    {% for value in swatch_option.values %}
                      {% assign swatch_file_name = value | handle | append: '.png' %}
                      {% assign swatch_image = swatch_file_name | file_img_url: '50x50' | prepend: 'https:' %}
                      
                      <div 
                        class="ai-swatch-option-{{ ai_gen_id }} {% if forloop.first %}selected{% endif %}"
                        data-value="{{ value | escape }}"
                        title="{{ value }}"
                      >
                        {% if settings.show_variant_image %}
                          <img 
                            src="{{ swatch_image }}" 
                            alt="{{ value }}"
                            class="ai-swatch-image-{{ ai_gen_id }}"
                            onerror="this.parentElement.innerHTML='<div class=\'ai-swatch-color-{{ ai_gen_id }}\' style=\'background-color: {{ value | handle }}\'></div>'"
                          >
                        {% else %}
                          <div class="ai-swatch-color-{{ ai_gen_id }}" style="background-color: {{ value | handle }}"></div>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                  <span class="ai-selected-variant-name-{{ ai_gen_id }}" data-card-id="{{ product.id }}">
                    {{ swatch_option.values.first }}
                  </span>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</featured-products-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupQuickAdd();
        this.setupSwatches();
      }

      setupQuickAdd() {
        const buttons = this.querySelectorAll('.ai-quick-add-button-{{ ai_gen_id }}');
        
        buttons.forEach(button => {
          button.addEventListener('click', async (e) => {
            e.preventDefault();
            const productHandle = button.dataset.productHandle;
            
            try {
              const response = await fetch(`/products/${productHandle}.js`);
              const product = await response.json();
              
              if (product.variants && product.variants.length > 0) {
                const firstAvailableVariant = product.variants.find(v => v.available) || product.variants[0];
                
                const formData = {
                  items: [{
                    id: firstAvailableVariant.id,
                    quantity: 1
                  }]
                };

                const addResponse = await fetch('/cart/add.js', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify(formData)
                });

                if (addResponse.ok) {
                  window.dispatchEvent(new CustomEvent('cart:refresh'));
                  
                  button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
                  
                  setTimeout(() => {
                    button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>';
                  }, 2000);
                }
              }
            } catch (error) {
              console.error('Error adding to cart:', error);
            }
          });
        });
      }

      setupSwatches() {
        const swatches = this.querySelectorAll('.ai-swatch-option-{{ ai_gen_id }}');
        
        swatches.forEach(swatch => {
          swatch.addEventListener('click', function() {
            const card = this.closest('.ai-product-card-{{ ai_gen_id }}');
            const swatchGroup = this.closest('.ai-variant-swatches-{{ ai_gen_id }}');
            const variantName = swatchGroup.querySelector('.ai-selected-variant-name-{{ ai_gen_id }}');
            const selectedValue = this.dataset.value;
            
            swatchGroup.querySelectorAll('.ai-swatch-option-{{ ai_gen_id }}').forEach(s => {
              s.classList.remove('selected');
            });
            
            this.classList.add('selected');
            
            if (variantName) {
              variantName.textContent = selectedValue;
            }
          });
        });
      }
    }

    customElements.define('featured-products-{{ ai_gen_id }}', FeaturedProducts{{ ai_gen_id }});
  })();
</script>

