{% doc %}
  @prompt
    
    
    <div
      class="footer-utilities spacing-style"
      style="{% render 'spacing-style', settings: block.settings %} --border-width: {{ block.settings.divider_thickness }}px;"
      {{ block.shopify_attributes }}
    >
      <div class="footer-utilities__group footer-utilities__group--left">
        {% content_for 'block', type: '_footer-copyright', id: 'copyright' %}
        {% content_for 'block', type: '_footer-policy-list', id: 'policy_list' %}
      </div>
    
      <div class="footer-utilities__group footer-utilities__group--right">
        {% content_for 'block', type: '_footer-social-icons', id: 'social_icons' %}
      </div>
    </div>
    
    {% style %}
      .footer-utilities {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--gap-lg);
        text-wrap: nowrap;
        border-top: var(--border-width) solid var(--color-border);
        color: var(--color-foreground-muted);
    
        @media screen and (min-width: 750px) {
          flex-direction: row;
          justify-content: space-between;
          gap: var(--gap-md);
          align-items: center;
          text-align: left;
        }
      }
    
      .footer-utilities a {
        color: var(--color-foreground-muted);
      }
    
      .footer-utilities__group {
        width: 100%;
        display: flex;
        flex: 1 1 max-content;
        text-align: center;
        flex-direction: column;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--gap-md);
    
        @media screen and (min-width: 750px) {
          flex-direction: row;
          align-items: baseline;
          gap: var(--gap-2xs) var(--gap-xl);
          text-align: left;
        }
      }
    
      .footer-utilities__group--right {
        @media screen and (min-width: 750px) {
          justify-content: flex-end;
        }
      }
    
      .footer-utilities__group:empty {
        @media screen and (max-width: 749px) {
          display: none;
        }
      }
    {% endstyle %}
    
    {% schema %}
    {
      "name": "t:names.footer_utilities",
      "tag": null,
      "settings": [
        {
          "type": "header",
          "content": "t:content.appearance"
        },
        {
          "type": "range",
          "id": "divider_thickness",
          "label": "t:settings.divider_thickness",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "unit": "px",
          "default": 1
        },
        {
          "type": "header",
          "content": "t:content.padding"
        },
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "t:settings.top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 20
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "t:settings.bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 20
        }
      ],
      "presets": [
        {
          "name": "t:names.footer_utilities",
          "category": "t:categories.footer"
        }
      ]
    }
    {% endschema %}
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-utilities-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    border-top: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};
  }

  .ai-footer-utilities__container-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    color: {{ block.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-footer-utilities__container-{{ ai_gen_id }} {
      flex-direction: row;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
    }
  }

  .ai-footer-utilities__container-{{ ai_gen_id }} a {
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-footer-utilities__container-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-footer-utilities__group-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    flex: 1 1 max-content;
    text-align: center;
    flex-direction: column;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .ai-footer-utilities__group-{{ ai_gen_id }} {
      flex-direction: row;
      align-items: baseline;
      gap: 8px 32px;
      text-align: left;
    }
  }

  .ai-footer-utilities__group-{{ ai_gen_id }}--right {
    @media screen and (min-width: 750px) {
      justify-content: flex-end;
    }
  }

  .ai-footer-utilities__copyright-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
  }

  .ai-footer-utilities__policy-list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    list-style: none;
    padding: 0;
    margin: 0;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .ai-footer-utilities__policy-list-{{ ai_gen_id }} {
      justify-content: flex-start;
    }
  }

  .ai-footer-utilities__policy-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
  }

  .ai-footer-utilities__social-icons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .ai-footer-utilities__social-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    transition: opacity 0.2s ease;
  }

  .ai-footer-utilities__social-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-footer-utilities__social-link-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.text_color }};
  }
{% endstyle %}

<footer-utilities-{{ ai_gen_id }}
  class="ai-footer-utilities-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-footer-utilities__container-{{ ai_gen_id }}">
    <div class="ai-footer-utilities__group-{{ ai_gen_id }}">
      {% if block.settings.show_copyright %}
        <p class="ai-footer-utilities__copyright-{{ ai_gen_id }}">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        </p>
      {% endif %}

      {% if block.settings.show_policies %}
        <ul class="ai-footer-utilities__policy-list-{{ ai_gen_id }}">
          {% for policy in shop.policies %}
            {% if policy != blank %}
              <li class="ai-footer-utilities__policy-item-{{ ai_gen_id }}">
                <a href="{{ policy.url }}">{{ policy.title }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <div class="ai-footer-utilities__group-{{ ai_gen_id }} ai-footer-utilities__group-{{ ai_gen_id }}--right">
      {% if block.settings.show_social_icons %}
        <div class="ai-footer-utilities__social-icons-{{ ai_gen_id }}">
          {% if block.settings.social_facebook_link != blank %}
            <a
              href="{{ block.settings.social_facebook_link }}"
              class="ai-footer-utilities__social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Facebook"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.social_instagram_link != blank %}
            <a
              href="{{ block.settings.social_instagram_link }}"
              class="ai-footer-utilities__social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Instagram"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.social_twitter_link != blank %}
            <a
              href="{{ block.settings.social_twitter_link }}"
              class="ai-footer-utilities__social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Twitter"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.social_pinterest_link != blank %}
            <a
              href="{{ block.settings.social_pinterest_link }}"
              class="ai-footer-utilities__social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Pinterest"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.social_youtube_link != blank %}
            <a
              href="{{ block.settings.social_youtube_link }}"
              class="ai-footer-utilities__social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="YouTube"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.social_tiktok_link != blank %}
            <a
              href="{{ block.settings.social_tiktok_link }}"
              class="ai-footer-utilities__social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="TikTok"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</footer-utilities-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterUtilities{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('footer-utilities-{{ ai_gen_id }}', FooterUtilities{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Footer utilities",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "Show copyright",
      "default": true
    },
    {
      "type": "header",
      "content": "Policies"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "social_facebook_link",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_twitter_link",
      "label": "Twitter"
    },
    {
      "type": "url",
      "id": "social_pinterest_link",
      "label": "Pinterest"
    },
    {
      "type": "url",
      "id": "social_youtube_link",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "social_tiktok_link",
      "label": "TikTok"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "Divider thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Footer utilities"
    }
  ]
}
{% endschema %}
