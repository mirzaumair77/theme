{% doc %}
  @prompt
    I want a shop by category carousel block, I want the layout to mimic this sites https://www.monicavinader.com/us/. The transparent with the line and white lettering.,  Make the text alignment to the bottom left with the white line above the collection name., I want the white bar almost completely filling the image. and remove the item count number, I want the navigation arrows above the images in the top right corner as simple minimalist arrows, remove the dots at the bottom with a button in the bottom left that says "shop all" that goes to all jewelry page

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-carousel-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-carousel-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-category-carousel-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .ai-category-carousel-text-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-carousel-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;font-size: {{ block.settings.heading_size }}px;
    font-weight: 300;
    letter-spacing: 1px;
  }

  .ai-category-carousel-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0;
    opacity: 0.8;
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: 300;
  }

  .ai-category-carousel-nav-top-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .ai-category-carousel-nav-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: none;
    background: none;
    color: {{ block.settings.nav_button_text_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    opacity: 0.7;
  }

  .ai-category-carousel-nav-button-{{ ai_gen_id }}:hover {
    opacity: 1;transform: translateX(2px);
  }

  .ai-category-carousel-nav-button-{{ ai_gen_id }}:first-child:hover {
    transform: translateX(-2px);
  }

  .ai-category-carousel-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;transform: none;
  }

  .ai-category-carousel-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke-width: 1;
  }

  .ai-category-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-category-carousel-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.3s ease;
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-category-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.card_width }}px;
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .ai-category-carousel-card-{{ ai_gen_id }}:hover {
    transform: scale(1.02);
  }

  .ai-category-carousel-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
  }

  .ai-category-carousel-image-container-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;transition: transform 0.3s ease;
  }

  .ai-category-carousel-card-{{ ai_gen_id }}:hover .ai-category-carousel-image-container-{{ ai_gen_id }} img {
    transform: scale(1.05);
  }

  .ai-category-carousel-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-carousel-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-category-carousel-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    text-align: left;
    padding:30px;
  }

  .ai-category-carousel-divider-{{ ai_gen_id }} {
    width: calc(100% - 60px);
    height: 1px;
    background-color: {{ block.settings.overlay_text_color }};
    margin: 0 0 16px;
    opacity: 0.9;
  }

  .ai-category-carousel-category-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_title_size }}px;
    font-weight: 300;
    margin: 0;
    color: {{ block.settings.overlay_text_color }};
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .ai-category-carousel-footer-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-start;
    margin-top: 32px;
  }

  .ai-category-carousel-shop-all-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background-color: {{ block.settings.shop_all_bg_color }};
    color: {{ block.settings.shop_all_text_color }};
    border: 1px solid {{ block.settings.shop_all_border_color }};
    border-radius: {{ block.settings.shop_all_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.shop_all_font_size }}px;
    font-weight: 300;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  .ai-category-carousel-shop-all-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.shop_all_hover_bg_color }};
    color: {{ block.settings.shop_all_hover_text_color }};
    border-color: {{ block.settings.shop_all_hover_border_color }};
    transform: translateY(-1px);
  }

  @media screen and (max-width: 768px) {
    .ai-category-carousel-card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width | times: 0.8 }}px;
    }

    .ai-category-carousel-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-category-carousel-track-{{ ai_gen_id }} {
      gap: {{ block.settings.card_gap | times: 0.5 }}px;
    }

    .ai-category-carousel-overlay-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-category-carousel-category-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.category_title_size | times: 0.9 }}px;letter-spacing: 1px;
    }

    .ai-category-carousel-divider-{{ ai_gen_id }} {
      width: calc(100% - 40px);
      margin-bottom: 12px;
    }

    .ai-category-carousel-header-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .ai-category-carousel-nav-top-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-category-carousel-footer-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<category-carousel-{{ ai_gen_id }}
  class="ai-category-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-category-carousel-container-{{ ai_gen_id }}">
    <div class="ai-category-carousel-header-{{ ai_gen_id }}">
      <div class="ai-category-carousel-text-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-category-carousel-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-category-carousel-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>

      <div class="ai-category-carousel-nav-top-{{ ai_gen_id }}">
        <button 
          class="ai-category-carousel-nav-button-{{ ai_gen_id }}" 
          data-prev
          aria-label="Previous categories"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
        </button>

        <button 
          class="ai-category-carousel-nav-button-{{ ai_gen_id }}" 
          data-next
          aria-label="Next categories"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="9,18 15,12 9,6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="ai-category-carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-category-carousel-track-{{ ai_gen_id }}" data-track>
        {% for i in (1..6) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign collection = block.settings[collection_key]%}
          
          {% if collection != blank %}
            <a 
              href="{{ collection.url }}" 
              class="ai-category-carousel-card-{{ ai_gen_id }}"
            >
              <div class="ai-category-carousel-image-container-{{ ai_gen_id }}">
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 400}}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    loading="lazy"
                    width="400"
                    height="{{ block.settings.image_height }}"
                  >
                {% else %}
                  <div class="ai-category-carousel-image-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-category-carousel-overlay-{{ ai_gen_id }}">
                  <div class="ai-category-carousel-divider-{{ ai_gen_id }}"></div>
                  <h3 class="ai-category-carousel-category-title-{{ ai_gen_id }}">{{ collection.title }}</h3></div>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-category-carousel-footer-{{ ai_gen_id }}">
      {% if block.settings.shop_all_link != blank %}
        <a href="{{ block.settings.shop_all_link }}" class="ai-category-carousel-shop-all-{{ ai_gen_id }}">
          {{ block.settings.shop_all_text }}
        </a>
      {% endif %}
    </div>
  </div>
</category-carousel-{{ ai_gen_id }}><script>
  (function() {
    class CategoryCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.itemsPerView = 3;
        this.cardWidth = {{ block.settings.card_width }};
        this.cardGap = {{ block.settings.card_gap }};}

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.cards = this.track.querySelectorAll('.ai-category-carousel-card-{{ ai_gen_id }}');
        
        this.calculateItemsPerView();
        this.updateCarousel();
        this.setupEventListeners();
        window.addEventListener('resize', () => {
          this.calculateItemsPerView();
          this.updateCarousel();
        });
      }

      calculateItemsPerView() {
        const containerWidth = this.track.parentElement.offsetWidth;
        const itemWidth = this.cardWidth + this.cardGap;
        this.itemsPerView = Math.floor(containerWidth / itemWidth);
        
        if (window.innerWidth <= 768) {
          this.itemsPerView = Math.max(1, Math.floor(containerWidth / (this.cardWidth * 0.8 + this.cardGap * 0.5)));
        }this.itemsPerView = Math.min(this.itemsPerView, this.cards.length);
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());
      }

      prev() {
        this.currentIndex = Math.max(0, this.currentIndex -1);
        this.updateCarousel();
      }

      next() {
        const maxIndex = Math.max(0, this.cards.length - this.itemsPerView);
        this.currentIndex = Math.min(maxIndex, this.currentIndex + 1);
        this.updateCarousel();
      }

      updateCarousel() {
        const translateX = -this.currentIndex * (this.cardWidth + this.cardGap);
        this.track.style.transform = `translateX(${translateX}px)`;
        
        const maxIndex = Math.max(0, this.cards.length - this.itemsPerView);
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
      }
    }

    customElements.define('category-carousel-{{ ai_gen_id }}', CategoryCarousel{{ ai_gen_id }});
  })();
</script>

