{% doc %}
  @prompt
    I want a carousel where i can manualy input my reviews and number of stars with the reviewers name. I want it to show 3 at a time with 4 total reviews

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-carousel-{{ ai_gen_id }} {
    position: relative;
    max-width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;}

  .ai-review-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
  }

  .ai-review-carousel__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0;
  }

  .ai-review-carousel__container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-review-carousel__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: 20px;
  }

  .ai-review-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 14px);
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-review-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
  }

  .ai-review-carousel__star-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    color: {{ block.settings.star_color }};
  }

  .ai-review-carousel__star--empty-{{ ai_gen_id }} {
    color: {{ block.settings.empty_star_color }};
  }

  .ai-review-carousel__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .ai-review-carousel__author-{{ ai_gen_id }} {
    color: {{ block.settings.author_color }};
    font-size: {{ block.settings.author_size }}px;
    font-weight: 600;
    margin: 0;
  }

  .ai-review-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  .ai-review-carousel__button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.button_border_color }};
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-review-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_color }};
  }

  .ai-review-carousel__button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-review-carousel__button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 990px) {
    .ai-review-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 10px);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-review-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-review-carousel__track-{{ ai_gen_id }} {
      gap: 16px;
    }
  }
{% endstyle %}

<review-carousel-{{ ai_gen_id }}
  class="ai-review-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <div class="ai-review-carousel__header-{{ ai_gen_id }}">
      <h2 class="ai-review-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    </div>
  {% endif %}

  <div class="ai-review-carousel__container-{{ ai_gen_id }}">
    <div class="ai-review-carousel__track-{{ ai_gen_id }}" data-track>
      {% for i in (1..4) %}
        {% liquid
          assign review_text_key = 'review_' | append: i | append: '_text'
          assign review_author_key = 'review_' | append: i | append: '_author'
          assign review_stars_key = 'review_' | append: i | append: '_stars'
          
          assign review_text = block.settings[review_text_key]
          assign review_author = block.settings[review_author_key]
          assign review_stars = block.settings[review_stars_key]%}

        {% if review_text != blank and review_author != blank %}
          <div class="ai-review-carousel__slide-{{ ai_gen_id }}">
            <div class="ai-review-carousel__stars-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                <svg
                  class="ai-review-carousel__star-{{ ai_gen_id }} {% if star > review_stars %}ai-review-carousel__star--empty-{{ ai_gen_id }}{% endif %}"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>
            <p class="ai-review-carousel__text-{{ ai_gen_id }}">{{ review_text }}</p>
            <p class="ai-review-carousel__author-{{ ai_gen_id }}">{{ review_author }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="ai-review-carousel__controls-{{ ai_gen_id }}">
    <button
      class="ai-review-carousel__button-{{ ai_gen_id }}"
      data-prev
      aria-label="Previous reviews"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
    </button>
    <button
      class="ai-review-carousel__button-{{ ai_gen_id }}"
      data-next
      aria-label="Next reviews"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9,18 15,12 9,6"></polyline>
      </svg>
    </button>
  </div>
</review-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slidesPerView = 3;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.slides = this.querySelectorAll('.ai-review-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');

        this.totalSlides = this.slides.length;
        this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);

        this.setupEventListeners();this.updateButtons();this.handleResize();

        window.addEventListener('resize', () => this.handleResize());
      }

      handleResize() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.slidesPerView = 1;} else if (width <= 990) {
          this.slidesPerView = 2;
        } else {
          this.slidesPerView = 3;
        }

        this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);
        this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
        this.updateCarousel();
        this.updateButtons();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.goToPrev());
        this.nextButton.addEventListener('click', () => this.goToNext());
      }

      goToPrev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
          this.updateButtons();
        }
      }

      goToNext() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
          this.updateButtons();
        }
      }

      updateCarousel() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = 20;
        const offset = this.currentIndex * (slideWidth + gap);
        this.track.style.transform = `translateX(-${offset}px)`;
      }

      updateButtons() {
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= this.maxIndex;
      }
    }

    customElements.define('review-carousel-{{ ai_gen_id }}', ReviewCarousel{{ ai_gen_id }});
  })();
</script>

