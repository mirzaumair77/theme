{% doc %}
  @prompt
    {%- liquid
      assign clean_title = product.title | remove: '™' | strip
      assign wedding_image = nil
      for img in product.images
        if img.alt contains 'wedding' or img.src contains 'wedding'
          assign wedding_image = img
          break
        endif
      endfor
      assign wedding_alt = wedding_image.alt | default: clean_title
    -%}
    <div class="jbps-occasions">
      <div class="jbps-occasions__head">
        <h2 class="jbps-occasions__title">One Piece. Every Occasion It Matters.</h2>
        <p class="jbps-occasions__lede">You don't own three outfits' worth of accessories. You own one that belongs everywhere.</p>
      </div>
    
      <div class="jbps-occasions__grid">
        <div class="jbps-occasions__card{% if wedding_image %} jbps-occasions__card--photo{% endif %}">
          {%- if wedding_image -%}
            <div class="jbps-occasions__photo">
              {{ wedding_image | image_url: width: 600 | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 750px) 33vw, 100vw',
                widths: '300,450,600',
                alt: wedding_alt
              -}}
            </div>
          {%- else -%}
            <span class="jbps-occasions__icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="18" cy="27" r="10" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="30" cy="27" r="10" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </span>
          {%- endif -%}
          <div class="jbps-occasions__card-content">
            <h3 class="jbps-occasions__card-title">The Wedding</h3>
            <p class="jbps-occasions__card-body">Groomsman, best man, or the guy who cleaned up better than expected. It holds through the toasts, the dancing, and the photos that end up framed.</p>
          </div>
        </div>
    
        <div class="jbps-occasions__card">
          <span class="jbps-occasions__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 8c0 6 4 8 4 13a5 5 0 01-10 0c0-5 4-7 4-13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19 21v14M14 40h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M32 12v22M26 40h12M27 12h10l-5 9-5-9z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <h3 class="jbps-occasions__card-title">The Date</h3>
          <p class="jbps-occasions__card-body">The dinner reservation you actually got dressed for. One less thing to think about while you're trying not to think about anything.</p>
        </div>
    
        <div class="jbps-occasions__card">
          <span class="jbps-occasions__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="18" width="32" height="20" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M18 18v-4a4 4 0 014-4h4a4 4 0 014 4v4" stroke="currentColor" stroke-width="1.5"/>
              <path d="M8 27h32" stroke="currentColor" stroke-width="1.5"/>
              <path d="M22 27h4v4h-4z" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </span>
          <h3 class="jbps-occasions__card-title">The Work Event</h3>
          <p class="jbps-occasions__card-body">The client dinner. The award you have to walk up for. The photo on LinkedIn you didn't know was being taken.</p>
        </div>
      </div>
    
     
    </div>
    
    <style>
      .jbps-occasions {
        max-width: 1100px;
        margin-inline: auto;
        font-family: var(--font-body--family);
        color: #000;
      }
      .jbps-occasions__head { text-align: center; margin-bottom: 2.5rem; }
      .jbps-occasions__title {
        font-family: var(--font-primary--family);
        font-size: clamp(1.5rem, 2.5vw, 2.25rem);
        font-weight: 600;
        margin: 0 0 0.75rem;
        line-height: 1.15;
      }
      .jbps-occasions__lede {
        font-size: 1rem;
        color: #555555;
        max-width: 46ch;
        margin: 0 auto;
        line-height: 1.5;
      }
      .jbps-occasions__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
      @media screen and (min-width: 750px) {
        .jbps-occasions__grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
      }
      .jbps-occasions__card {
        text-align: center;
        padding: 2rem 1.25rem;
        border: 1px solid #e7e7e7;
        display: flex;
        flex-direction: column;
      }
      .jbps-occasions__card--photo {
        padding: 0 0 2rem;
      }
      .jbps-occasions__photo {
        margin-bottom: 1.25rem;
      }
      .jbps-occasions__photo img {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
      }
      .jbps-occasions__card--photo .jbps-occasions__card-content {
        padding: 0 1.25rem;
      }
      .jbps-occasions__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        color: #000;
        margin-bottom: 1.25rem;
      }
      .jbps-occasions__icon svg {
        width: 100%;
        height: 100%;
      }
      .jbps-occasions__card-t,  .jbps-occasions__card-title {
        font-family: var(--font-primary--family);
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 0.75rem;
      }
      .jbps-occasions__card-body {
        font-size: 0.9rem;
        line-height: 1.55;
        color: #444444;
        margin: 0;
      }
      .jbps-occasions__foot {
        text-align: center;
        margin: 2.5rem 0 0;
        font-size: 0.95rem;
        font-style: italic;
        color: #555555;
      }
    </style>
    
    Add this at the end
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .jbps-occasions-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1100px;
    margin-inline: auto;
    color: {{ block.settings.text_color }};
    font-family: var(--font-body--family, Poppins, sans-serif);
  }
  .jbps-occasions-{{ ai_gen_id }}__head { margin: 0 auto 2.5rem; max-width: 650px; text-align: center; }
  .jbps-occasions-{{ ai_gen_id }}__title { margin: 0 0 .75rem; color: {{ block.settings.text_color }}; font-family: var(--font-heading--family, Lora, serif); font-size: clamp(1.5rem, 2.5vw, 2.25rem); font-weight: 500; line-height: 1.15; }
  .jbps-occasions-{{ ai_gen_id }}__lede { max-width: 46ch; margin: 0 auto; color: {{ block.settings.muted_text_color }}; font-size: 1rem; line-height: 1.5; }
  .jbps-occasions-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  .jbps-occasions-{{ ai_gen_id }}__card { display: flex; flex-direction: column; padding: 2rem 1.25rem; border: 1px solid {{ block.settings.border_color }}; text-align: center; }
  .jbps-occasions-{{ ai_gen_id }}__card--photo { padding: 0 0 2rem; }
  .jbps-occasions-{{ ai_gen_id }}__photo { margin-bottom: 1.25rem; }
  .jbps-occasions-{{ ai_gen_id }}__photo img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .jbps-occasions-{{ ai_gen_id }}__placeholder { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; margin-bottom: 1.25rem; background: {{ block.settings.placeholder_color }}; }
  .jbps-occasions-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; max-width: 220px; color: {{ block.settings.muted_text_color }}; }
  .jbps-occasions-{{ ai_gen_id }}__card-content { flex: 1; }
  .jbps-occasions-{{ ai_gen_id }}__card--photo .jbps-occasions-{{ ai_gen_id }}__card-content { padding: 0 1.25rem; }
  .jbps-occasions-{{ ai_gen_id }}__icon { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; margin: 0 auto 1.25rem; color: {{ block.settings.text_color }}; }
  .jbps-occasions-{{ ai_gen_id }}__icon svg { width: 100%; height: 100%; }
  .jbps-occasions-{{ ai_gen_id }}__card-title { margin: 0 0 .75rem; color: {{ block.settings.text_color }}; font-family: var(--font-heading--family, Lora, serif); font-size: 1.1rem; font-weight: 600; line-height: 1.2; }
  .jbps-occasions-{{ ai_gen_id }}__card-body { margin: 0; color: {{ block.settings.body_text_color }}; font-size: .9rem; line-height: 1.55; }
  .jbps-occasions-{{ ai_gen_id }}__foot { margin: 2.5rem 0 0; color: {{ block.settings.muted_text_color }}; font-size: .95rem; font-style: italic; text-align: center; }
  @media screen and (min-width: 750px) { .jbps-occasions-{{ ai_gen_id }}__grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
{% endstyle %}

<div class="jbps-occasions-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="jbps-occasions-{{ ai_gen_id }}__head">
    <h2 class="jbps-occasions-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
    <p class="jbps-occasions-{{ ai_gen_id }}__lede">{{ block.settings.introduction | escape }}</p>
  </div>
  <div class="jbps-occasions-{{ ai_gen_id }}__grid">
    {% assign occasion_titles = block.settings.wedding_title | append: '|' | append: block.settings.date_title | append: '|' | append: block.settings.work_title | split: '|' %}
    {% assign occasion_bodies = block.settings.wedding_body | append: '|' | append: block.settings.date_body | append: '|' | append: block.settings.work_body | split: '|' %}
    {% for occasion in (1..3) %}
      <div class="jbps-occasions-{{ ai_gen_id }}__card{% if occasion == 1 and block.settings.wedding_image %} jbps-occasions-{{ ai_gen_id }}__card--photo{% endif %}">
        {% if occasion == 1 %}
          {% if block.settings.wedding_image %}<div class="jbps-occasions-{{ ai_gen_id }}__photo">{{ block.settings.wedding_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700', sizes: '(min-width: 750px) 33vw, 100vw', alt: block.settings.wedding_image.alt | default: block.settings.wedding_title }}</div>{% else %}<div class="jbps-occasions-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
        {% else %}<span class="jbps-occasions-{{ ai_gen_id }}__icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="1.5"/><path d="M24 16v16M16 24h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>{% endif %}
        <div class="jbps-occasions-{{ ai_gen_id }}__card-content"><h3 class="jbps-occasions-{{ ai_gen_id }}__card-title">{{ occasion_titles[forloop.index0] | escape }}</h3><p class="jbps-occasions-{{ ai_gen_id }}__card-body">{{ occasion_bodies[forloop.index0] | escape }}</p></div>
      </div>
    {% endfor %}
  </div>
  {% if block.settings.footer_text != blank %}<p class="jbps-occasions-{{ ai_gen_id }}__foot">{{ block.settings.footer_text | escape }}</p>{% endif %}
</div>

{% schema %}
{"name":"Occasion cards","tag":null,"class":"occasion-cards-block","settings":[{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Heading","default":"One Piece. Every Occasion It Matters."},{"type":"textarea","id":"introduction","label":"Introduction","default":"You don't own three outfits' worth of accessories. You own one that belongs everywhere."},{"type":"image_picker","id":"wedding_image","label":"Wedding image"},{"type":"text","id":"wedding_title","label":"Wedding title","default":"The Wedding"},{"type":"textarea","id":"wedding_body","label":"Wedding text","default":"Groomsman, best man, or the guy who cleaned up better than expected. It holds through the toasts, the dancing, and the photos that end up framed."},{"type":"text","id":"date_title","label":"Date title","default":"The Date"},{"type":"textarea","id":"date_body","label":"Date text","default":"The dinner reservation you actually got dressed for. One less thing to think about while you're trying not to think about anything."},{"type":"text","id":"work_title","label":"Work title","default":"The Work Event"},{"type":"textarea","id":"work_body","label":"Work text","default":"The client dinner. The award you have to walk up for. The photo on LinkedIn you didn't know was being taken."},{"type":"text","id":"footer_text","label":"Footer text","default":"One piece. Every occasion."},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"color","id":"body_text_color","label":"Body text","default":"#444444"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#555555"},{"type":"color","id":"border_color","label":"Borders","default":"#E7E7E7"},{"type":"color","id":"placeholder_color","label":"Placeholder","default":"#F5F5F5"}],"presets":[{"name":"Occasion cards"}]}
{% endschema %}