{% doc %}
  @prompt
    I want a block for my footer menu in multiple columns with the apprpriate hyperlinks for the each menu item, It's one menu that is organized into seperate columns. It should be just the one footer menu split into multiple columns (Selectable number of columns), I want them alignment option
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-menu-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-footer-menu-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    width: 100%;
  }

  .ai-footer-menu-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-footer-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    transition: color 0.2s ease;
  }

  .ai-footer-menu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-footer-menu-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-footer-menu-column-{{ ai_gen_id }} {
      text-align: {{ block.settings.text_alignment_mobile }};
    }
  }
{% endstyle %}

<footer-menu-{{ ai_gen_id }} class="ai-footer-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.menu != blank %}
    {% assign menu = block.settings.menu %}
    {% assign total_items = menu.links.size %}
    {% assign items_per_column = total_items | divided_by: block.settings.columns_desktop | ceil %}
    
    <div class="ai-footer-menu-container-{{ ai_gen_id }}">
      {% for i in (1..block.settings.columns_desktop) %}
        {% assign start_index = forloop.index0 | times: items_per_column %}
        {% assign end_index = start_index | plus: items_per_column | minus: 1 %}
        
        <div class="ai-footer-menu-column-{{ ai_gen_id }}">
          {% for link in menu.links limit: items_per_column offset: start_index %}
            <a href="{{ link.url }}" class="ai-footer-menu-link-{{ ai_gen_id }}">
              {{ link.title }}
            </a>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-footer-menu-container-{{ ai_gen_id }}">
      {% for i in (1..block.settings.columns_desktop) %}
        <div class="ai-footer-menu-column-{{ ai_gen_id }}">
          <a href="#" class="ai-footer-menu-link-{{ ai_gen_id }}">Menu item {{ forloop.index }}</a>
          <a href="#" class="ai-footer-menu-link-{{ ai_gen_id }}">Menu item {{ forloop.index | plus: block.settings.columns_desktop }}</a>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</footer-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('footer-menu-{{ ai_gen_id }}', FooterMenu{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Footer menu columns",
  "settings": [
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment on desktop",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text alignment on mobile",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Footer menu columns"
    }
  ],
  "tag": null
}
{% endschema %}
