{%- doc -%}
  Selected variant title (e.g. the finish "Gilded Bronze") shown under the product title.
  Updates when the shopper changes options. Hidden for products with only the default variant.

  @example
  {% content_for 'block', type: 'variant-title', id: 'variant-title' %}
{%- enddoc -%}

<script
  src="{{ 'variant-title.js' | asset_url }}"
  type="module"
></script>

{% render 'text-block-styles' %}

{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant
  assign variant_title = selected_variant.title

  # Show the finish (Color option) on its own when the product has one, e.g. "Gilded Bronze"
  # rather than "Gilded Bronze / 7"; otherwise the full variant title.
  assign color_option_index = ''
  for title_option in product_resource.options_with_values
    assign title_option_key = title_option.name | downcase | strip
    if title_option_key == 'color' or title_option_key == 'colour' or title_option_key == 'finish' or title_option_key == 'metal'
      assign color_option_index = forloop.index0
      assign variant_title = title_option.selected_value | default: selected_variant.options[forloop.index0]
      break
    endif
  endfor

  if product_resource.has_only_default_variant
    assign variant_title = blank
  endif
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

<variant-title-component
  class="text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style"
  data-product-id="{{ product_resource.id }}"
  {% if color_option_index != '' %}
    data-option-index="{{ color_option_index }}"
  {% endif %}
  style="
    {% if variant_title == blank %}
      display: none;
    {% else %}
      display: block;
    {% endif %}
    {% render 'typography-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --width: {{ block_settings.width }};
  "
  {{ block.shopify_attributes }}
>
  <span ref="title">{{ variant_title | escape }}</span>
</variant-title-component>

