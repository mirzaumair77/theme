{%- doc -%}
  Style owner for `product-item-v2`. Rendered by the card and, ahead of hydration, by the
  related-products section so the CSS is present before recommendations arrive.

  @example
  {% render 'product-item-v2-styles' %}
{%- enddoc -%}

{% render 'swatch-styles' %}

{% stylesheet %}
  .product-item-v2 {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: #121212;
    text-decoration: none;
  }

  .product-item-v2:focus-visible {
    outline: 1px solid #121212;
    outline-offset: 2px;
  }

  .product-item-v2__media {
    position: relative;
    aspect-ratio: 4 / 4.5;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .product-item-v2__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-item-v2__image--placeholder {
    fill: rgb(18 18 18 / 0.12);
  }

  .product-item-v2__image--hover {
    opacity: 0;
  }

  .product-item-v2__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 4px;
  }

  .product-item-v2__title,
  .product-item-v2__finish,
  .product-item-v2__price {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 400;
    color: #2A2A2A;
    overflow-wrap: anywhere;
  }

  .product-item-v2__title {
    font-size: 11px;
    line-height: 1.3;
  }

  .product-item-v2__finish {
    padding-block: 2px;
    display: flex;
    align-items: center;
    /* A double space (about 5px at 10px text) clear of the swatch's 2px outer ring */
    gap: 7px;
    font-size: 10px;
    line-height: 1.4;
  }

  .product-item-v2__swatch {
    display: inline-flex;
    flex-shrink: 0;

    .swatch {
      --variant-picker-swatch-width: 13.4px;
      --variant-picker-swatch-height: 13.4px;
      --variant-picker-swatch-radius: 50%;

      width: 13.4px;
      height: 13.4px;
      min-width: 13.4px;
      border-radius: 50%;
      outline: 1px solid #212121;
      outline-offset: 1px;
    }
  }

  .product-item-v2__price {
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.3;
  }

  .product-item-v2__compare-price {
    margin-inline-end: 6px;
    color: #888888;
  }

  @media (hover: hover) {
    .product-item-v2:hover .product-item-v2__image--hover {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-item-v2__image--hover {
      transition: opacity 0.5s ease;
    }
  }
{% endstylesheet %}
