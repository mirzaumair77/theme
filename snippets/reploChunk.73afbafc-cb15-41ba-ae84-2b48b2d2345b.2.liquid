  function getSelectedMetal() {
    const metalGroup = document.querySelector('[data-jbj-option-group="metal"]');
    if (!metalGroup) {
      console.warn("JBJ: metal group not found");
      return null;
    }

    const metalOptions = Array.from(metalGroup.querySelectorAll('[role="option"]'));
    const selectedMetal = metalGroup.querySelector('[role="option"][aria-selected="true"]');

    if (!selectedMetal) {
      console.warn("JBJ: selected metal not found");
      return null;
    }

    const selectedIndex = metalOptions.indexOf(selectedMetal);
    const metal = metalOrder[selectedIndex];

    console.log("JBJ selected metal index:", selectedIndex);
    console.log("JBJ selected metal:", metal);

    return metal || null;
  }

  function updateMetalAvailability() {
    const design = getSelectedDesign();
    const metalGroup = document.querySelector('[data-jbj-option-group="metal"]');

    if (!design || !metalGroup) return;

    const metalOptions = Array.from(metalGroup.querySelectorAll('[role="option"]'));

    metalOptions.forEach(function (option, index) {
      const metal = metalOrder[index];
      const key = design + "-" + metal;
      const exists = Boolean(jbjVariantMap[key]);

      if (!exists) {
        option.classList.add("jbj-option-unavailable");
        option.setAttribute("aria-disabled", "true");
      } else {
        option.classList.remove("jbj-option-unavailable");
        option.removeAttribute("aria-disabled");
      }
    });
  }

  async function addOriginalVariantToCart(variantId, button) {
    const originalHTML = button.innerHTML;

    button.style.pointerEvents = "none";
    button.innerHTML = "Adding...";

    try {
      const response = await fetch("/cart/add.js", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1
        })
      });

      if (!response.ok) {
        throw new Error("Add to cart failed");
      }

      window.location.href = "/cart";
    } catch (error) {
      console.error("JBJ add to cart error:", error);
      alert("Something went wrong. Please try again.");

      button.style.pointerEvents = "";
      button.innerHTML = originalHTML;
    }
  }

  document.addEventListener("click", function (event) {
    const optionGroupClicked = event.target.closest('[data-jbj-option-group="design"], [data-jbj-option-group="metal"]');

    if (optionGroupClicked) {
      setTimeout(updateMetalAvailability, 100);
    }

    const addToCartButton = event.target.closest('[data-jbj-add-to-cart="true"]');

    if (!addToCartButton) return;

    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();

    const selectedDesign = getSelectedDesign();
    const selectedMetal = getSelectedMetal();

    if (!selectedDesign || !selectedMetal) {
      alert("Please select a design and metal before adding to cart.");
      return;
    }

    const selectedKey = selectedDesign + "-" + selectedMetal;
    const originalVariantId = jbjVariantMap[selectedKey];

    console.log("JBJ selected key:", selectedKey);
    console.log("JBJ original variant ID:", originalVariantId);

    if (!originalVariantId) {
      alert("This design + metal combination is currently unavailable.");
      return;
    }

    addOriginalVariantToCart(originalVariantId, addToCartButton);
  }, true);

  window.addEventListener("load", function () {
    setTimeout(updateMetalAvailability, 500);
  });
})();
</script></div></div></div></div><style>@import url(https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@100;200;300;400;500;600;700;800;900;950&family=Alice:wght@100;200;300;400;500;600;700;800;900;950&family=Lato:wght@100;200;300;400;500;600;700;800;900;950&family=Poppins:wght@100;200;300;400;500;600;700;800;900;950&family=Lora:wght@100;200;300;400;500;600;700;800;900;950&display=swap)</style></div>
