{%- doc -%}
  Renders the search field at the top of the header drawer.

  Below 750px it is a live predictive search: typing replaces the drawer menu with
  results from the `predictive-search` section, and clearing the field brings the
  menu back (see the `:has()` rules in header-drawer.liquid). From 750px the same
  field is a button that closes the drawer and opens the shared search modal.

  @param {string} id_suffix - Unique suffix for generated IDs, such as the menu block ID.

  @example
  {% render 'header-drawer-search', id_suffix: block.id %}
{%- enddoc -%}

{%- liquid
  assign input_id = 'HeaderDrawerSearch-' | append: id_suffix
  assign results_id = 'HeaderDrawerSearchResults-' | append: id_suffix
  assign placeholder = 'content.drawer_search_placeholder' | t

  # The icon draws its ring through an SVG mask; give each inline copy its own mask ID
  # so the hidden copy (trigger on mobile, field on desktop) can't blank the visible one
  assign search_icon = 'icon-search-field.svg' | inline_asset_content
  assign trigger_mask_id = 'HeaderDrawerSearchIconTrigger-' | append: id_suffix
  assign field_mask_id = 'HeaderDrawerSearchIconField-' | append: id_suffix
-%}

{% render 'predictive-search-styles' %}

<script
  src="{{ 'predictive-search.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="menu-drawer__search">
  <button
    type="button"
    class="menu-drawer__search-trigger"
    aria-haspopup="dialog"
    on:click="header-drawer/openSearchModal"
  >
    <span class="menu-drawer__search-placeholder">{{ placeholder }}</span>
    <span
      class="svg-wrapper menu-drawer__search-icon"
      aria-hidden="true"
    >
      {{- search_icon | replace: 'stroke0_906_9115', trigger_mask_id -}}
    </span>
  </button>

  <predictive-search-component
    class="menu-drawer__predictive-search"
    data-section-id="predictive-search"
    style="--product-corner-radius: {{ settings.product_corner_radius | default: 8 | append: 'px' }}; --card-corner-radius: {{ settings.card_corner_radius | default: 8 | append: 'px' }};{% if settings.card_title_case == 'uppercase' %} --title-case: uppercase;{% endif %}"
  >
    <form
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="predictive-search-form menu-drawer__search-form"
      ref="form"
    >
      <div class="menu-drawer__search-field">
        <label
          for="{{ input_id }}"
          class="visually-hidden"
        >
          {{- 'content.search_input_label' | t -}}
        </label>
        <input
          id="{{ input_id }}"
          class="menu-drawer__search-input"
          type="search"
          name="q"
          role="combobox"
          aria-expanded="false"
          aria-controls="{{ results_id }}"
          aria-autocomplete="list"
          autocomplete="off"
          placeholder="{{ placeholder }}"
          ref="searchInput"
          on:input="/search"
          on:keydown="/onSearchKeyDown"
        >
        <input
          name="options[prefix]"
          type="hidden"
          value="last"
        >
        <button
          type="button"
          class="button-unstyled menu-drawer__search-reset"
          ref="resetButton"
          hidden
          on:click="/resetSearch"
        >
          {{ 'actions.clear' | t }}
        </button>
        {%- comment -%} Decorative; as a label, a tap on the icon focuses the field {%- endcomment -%}
        <label
          for="{{ input_id }}"
          class="svg-wrapper menu-drawer__search-icon"
          aria-hidden="true"
        >
          {{- search_icon | replace: 'stroke0_906_9115', field_mask_id -}}
        </label>
      </div>

      <div
        id="{{ results_id }}"
        class="menu-drawer__search-results"
        ref="predictiveSearchResults"
      ></div>

      <div class="menu-drawer__search-footer">
        <button
          type="submit"
          class="button menu-drawer__search-view-all"
        >
          {{ 'content.search_results_view_all' | t }}
        </button>
      </div>
    </form>
  </predictive-search-component>
</div>

{% stylesheet %}
  .menu-drawer__search {
    --menu-drawer-search-background: var(
      --menu-drawer-accent-background,
      rgb(var(--color-foreground-rgb) / var(--opacity-5))
    );

    padding-inline: var(--drawer-padding);
    padding-block: 16px;
  }

  .menu-drawer__search-trigger,
  .menu-drawer__search-field {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    width: 100%;
    min-height: 40px;
    padding-inline: 20px;
    border: 0;
    border-radius: 999px;
    background-color: var(--menu-drawer-search-background);
    color: var(--color-foreground);
  }

  .menu-drawer__search-trigger {
    justify-content: space-between;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .menu-drawer__search-placeholder {
    min-width: 0;
    overflow: hidden;
    color: #86827a;
    font-size: var(--font-size--sm, 0.875rem);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .menu-drawer__search-field:focus-within,
  .menu-drawer__search-trigger:focus-visible {
    outline: var(--focus-outline-width) solid currentColor;
    outline-offset: var(--focus-outline-offset);
  }

  .menu-drawer__search-input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0;
    border: 0;
    background-color: transparent !important;
    color: var(--color-foreground);
    font-size: 12px;
    line-height: 18px;
    font-weight: 400;
    outline: none;
    box-shadow: none;

    &::placeholder {
      color: #86827a;
    }

    &::-webkit-search-cancel-button {
      display: none;
    }
  }

  .menu-drawer__search-reset {
    display: none;
    flex-shrink: 0;
    font-size: var(--font-size--xs, 0.75rem);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-muted-text));
    text-decoration: underline;
    cursor: pointer;
  }

  /* Trailing 17px icon, centered on the field; the input flexes so text stops before it */
  .menu-drawer .menu-drawer__search-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    cursor: text;

    svg {
      width: 17px;
      height: 17px;
    }
  }

  .menu-drawer__search-trigger .menu-drawer__search-icon {
    cursor: pointer;
  }

  /* Shares predictive-search-component with the modal; undo its modal layout here */
  .menu-drawer__predictive-search {
    display: block;
    z-index: auto;
    background-color: transparent;
  }

  .menu-drawer__search-form {
    position: static;
  }

  .menu-drawer__search-results {
    padding-block-start: var(--padding-md);
  }

  .menu-drawer__search-results .predictive-search-results__products {
    padding-inline: 0;
  }

  .menu-drawer__search-results .predictive-search-dropdown {
    position: static;
  }

  .menu-drawer__search-footer {
    display: none;
    padding-block: var(--padding-md);
  }

  .menu-drawer__search-view-all {
    width: 100%;
  }

  /* Results and the view-all action exist only while a query is active
     (predictive search shows the reset button for a query, hides it when cleared) */
  .menu-drawer__search:has(.menu-drawer__search-reset[hidden]) .menu-drawer__search-results {
    display: none;
  }

  .menu-drawer__search:has(.menu-drawer__search-reset:not([hidden])):has([data-search-results]):not(
      :has(.predictive-search-results__no-results)
    )
    .menu-drawer__search-footer {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .menu-drawer__search-trigger {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .menu-drawer__predictive-search {
      display: none;
    }
  }
{% endstylesheet %}
