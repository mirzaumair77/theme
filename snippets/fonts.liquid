{%- unless settings.type_body_font.system? -%}
  {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}
{%- unless settings.type_subheading_font.system? -%}
  {{ settings.type_subheading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}
{%- unless settings.type_heading_font.system? -%}
  {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}
{%- unless settings.type_accent_font.system? -%}
  {{ settings.type_accent_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}

{%- style -%}
@font-face {
  font-family: 'Roboto';
  src: url('{{ "font-roboto.woff2" | asset_url }}') format('woff2'),
       url('{{ "font-roboto.woff" | asset_url }}') format('woff');
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Inter';
  src: url('{{ "inter.woff2" | asset_url }}') format('woff2'),
       url('{{ "inter.woff" | asset_url }}') format('woff');
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Inter';
  src: url('{{ "inter-italic.woff2" | asset_url }}') format('woff2'),
       url('{{ "inter-italic.woff" | asset_url }}') format('woff');
  font-weight: 100 900;
  font-style: italic;
  font-display: swap;
}

:root {
  --font-roboto: 'Roboto', sans-serif;
  --font-inter: 'Inter', sans-serif;
}

