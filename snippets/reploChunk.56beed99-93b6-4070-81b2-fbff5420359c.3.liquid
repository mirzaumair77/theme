8-40dc-968e-d2cacf89cbd3" class="r-1c4cqfz"><div data-rid="9151306e-a4d6-47e3-a96e-d275a30a9483" class="r-zz1keu"><div data-rid="af480d54-1ea5-46a6-84d4-5066ea91efa0" class="r-jh3fjb"></div><div data-rid="9f4aacb0-20ae-4c76-9956-b9eda6365a17" class="r-vvxyns"><div data-rid="50e8a3c9-1ad1-4271-95fc-d1ab06138064" class="r-xon4a3 alchemy-rte"><span style="width:100%">01 — Carved</span></div></div><div data-rid="9b56b3c8-9901-4650-978b-6a4602bc1710" class="r-105m3x8"><div data-rid="c04e39b4-adfc-418f-b4dc-e74eec9572c9" class="r-incs76 alchemy-rte"><span style="width:100%"><p>An original sculptural design begins in wax, where the detail and personality are shaped by hand.</p></span></div></div></div><div data-rid="5f105401-49ad-4f3c-b22d-14cf5023f767" class="r-1mxexfj"><div data-rid="eb0656fa-9e51-4c82-973a-0f20fa58b726" class="r-osn21i"></div><div data-rid="6adbc7f4-ae58-4810-93f5-a1a3bef5b36e" class="r-15sg605"><div data-rid="a829dfcf-fef1-4e72-98d9-b445190233e4" class="r-co41y8 alchemy-rte"><span style="width:100%">02 — Molded</span></div></div><div data-rid="0ccfd06b-930b-443a-9a02-0ba9142f1591" class="r-11muuzf"><div data-rid="c2b41b5a-5aab-476a-994d-e8ed0190835b" class="r-ol8c5o alchemy-rte"><span style="width:100%"><p>A mold preserves the original form so each metal piece keeps the dimensional detail.</p></span></div></div></div><div data-rid="0f17b9c5-9d41-482e-b5f0-3c7fc073f8a0" class="r-qtmvi5"><div data-rid="f311518a-a70a-4243-bc88-88123f42a9f7" class="r-4fcshz"></div><div data-rid="ae4f0d28-f82e-4d91-ae6a-bec94f53bffc" class="r-1u4mhjn"><div data-rid="7e86a0e4-db7c-472e-91f3-022ceff5b76d" class="r-1hyfnz3 alchemy-rte"><span style="width:100%">03 — Cast</span></div></div><div data-rid="0edf9e46-c4a8-44bf-9156-b839c4fa1d9d" class="r-v4jkju"><div data-rid="bb7a0c83-9707-49d4-b868-97603dc6ec71" class="r-bsehb6 alchemy-rte"><span style="width:100%"><p>Using lost-wax casting, the wax is replaced with molten metal: sterling silver, bronze, or white bronze.</p></span