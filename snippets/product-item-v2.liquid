{%- doc -%}
  Renders the related-products card: portrait image (with a hover image when the product
  has one), title, the selected finish as a swatch with its name, and price. Renders a
  placeholder card when no product is passed. Styles live in `product-item-v2-styles`.

  @param {product} [product] - The product to show. Omit for a placeholder card.
  @param {string} [image_sizes] - The sizes attribute for the product images.
  @param {string} [loading] - Loading strategy for the main image: 'eager' or 'lazy'. Defaults to 'lazy'.

  @example
  {% render 'product-item-v2', product: product, image_sizes: '(min-width: 769px) 25vw, 85vw', loading: 'lazy' %}
{%- enddoc -%}

{%- liquid
  assign loading = loading | default: 'lazy'

  # Checked by id: the onboarding slider passes whitespace strings, which are not blank.

  if product.id != blank
    assign variant = product.selected_or_first_available_variant
    assign first_image = variant.featured_media | default: product.featured_media
    assign second_image = product.media | where: 'media_type', 'image' | reject: 'id', first_image.id | first
    assign image_alt = first_image.alt | default: product.title | escape

    # The finish shown under the title is the variant's Color option value.
    assign color_value = nil
    for option in product.options_with_values
      assign option_key = option.name | downcase | strip
      if option_key == 'color' or option_key == 'colour'
        for value in option.values
          if value.name == variant.options[forloop.parentloop.index0]
            assign color_value = value
            break
          endif
        endfor
        break
      endif
    endfor
  endif
-%}

{% render 'product-item-v2-styles' %}

{%- if product.id != blank -%}
  <a
    class="product-item-v2"
    href="{{ product.url }}"
  >
    <div class="product-item-v2__media">
      {%- if first_image != blank -%}
        {{
          first_image
          | image_url: width: 1200
          | image_tag:
            widths: '300, 450, 600, 750, 900, 1200',
            sizes: image_sizes,
            loading: loading,
            alt: image_alt,
            class: 'product-item-v2__image'
        }}
        {%- if second_image != blank -%}
          {{
            second_image
            | image_url: width: 1200
            | image_tag:
              widths: '300, 450, 600, 750, 900, 1200',
              sizes: image_sizes,
              loading: 'lazy',
              alt: '',
              class: 'product-item-v2__image product-item-v2__image--hover'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-item-v2__image product-item-v2__image--placeholder' }}
      {%- endif -%}
    </div>

    <div class="product-item-v2__info">
      <h3 class="product-item-v2__title">{{ product.title | escape }}</h3>

      {%- if color_value != blank -%}
        <p class="product-item-v2__finish">
          {%- if color_value.swatch.color or color_value.swatch.image -%}
            <span
              class="product-item-v2__swatch"
              aria-hidden="true"
            >
              {%- render 'swatch', swatch: color_value.swatch, mode: 'unscaled' -%}
            </span>
          {%- endif -%}
          <span class="product-item-v2__finish-name">{{ color_value.name | escape }}</span>
        </p>
      {%- endif -%}

      <p class="product-item-v2__price">
        {%- if variant.compare_at_price > variant.price -%}
          <s class="product-item-v2__compare-price">{{ variant.compare_at_price | money_without_trailing_zeros }}</s>
        {%- endif -%}
        {{- variant.price | money_without_trailing_zeros -}}
      </p>
    </div>
  </a>
{%- else -%}
  <div class="product-item-v2 product-item-v2--placeholder">
    <div class="product-item-v2__media">
      {{ 'product-1' | placeholder_svg_tag: 'product-item-v2__image product-item-v2__image--placeholder' }}
    </div>
    <div class="product-item-v2__info">
      <h3 class="product-item-v2__title">{{ 'placeholders.product_title' | t }}</h3>
      <p class="product-item-v2__price">{{ 9900 | money_without_trailing_zeros }}</p>
    </div>
  </div>
{%- endif -%}
